---
// DimensionOverlay — an SVG layer of dimension lines + leader callouts over a
// specimen photo. Reuses the hero's `.dim` pattern (arrowhead marker, draw/pop
// animation classes) so the authored motion is consistent. Values are pulled
// from the item's specs by matching `specKey` — one source of truth.
import type { Callout, SpecEntry } from "../data/catalog.ts";

interface Props {
  callouts: Callout[];
  specs: SpecEntry[];
}
const { callouts, specs } = Astro.props;

const valueFor = (key: string) => specs.find((s) => s.k === key)?.v ?? "";
---

<svg class="dim" viewBox="0 0 400 400" preserveAspectRatio="none" aria-hidden="true">
  <defs>
    <marker id="dim-arrow" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto">
      <path d="M0,0 L6,3 L0,6 Z" fill="#1b3a6b" />
    </marker>
  </defs>
  {
    callouts.map((c, i) => {
      const v = valueFor(c.specKey);
      const cls = i % 2 === 0 ? "draw" : "draw-2";
      if (c.type === "dimension" && c.x2 != null && c.y2 != null) {
        return (
          <g>
            <line
              class={cls}
              x1={c.x}
              y1={c.y}
              x2={c.x2}
              y2={c.y2}
              marker-start="url(#dim-arrow)"
              marker-end="url(#dim-arrow)"
            />
            <text class="pop" x={(c.x + c.x2) / 2} y={c.y - 8} text-anchor="middle">
              {v}
            </text>
          </g>
        );
      }
      // leader: a bent polyline from the anchor to the label endpoint
      const lx = c.lx ?? c.x + 80;
      const ly = c.ly ?? c.y + 40;
      const midX = c.x + (lx - c.x) * 0.5;
      return (
        <g>
          <polyline class={`callout ${cls}`} points={`${c.x},${c.y} ${midX},${c.y} ${lx},${ly}`} fill="none" />
          <circle cx={c.x} cy={c.y} r="2.5" fill="#c8430f" />
          <text class="pop" x={lx} y={ly - 4} text-anchor={lx > c.x ? "start" : "end"} fill="#c8430f">
            {v}
          </text>
        </g>
      );
    })
  }
</svg>
