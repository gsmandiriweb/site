---
import Logo from "./Logo.astro";
import { u } from "../utils/url.ts";
const path = Astro.url.pathname;
const isActive = (href: string) =>
  !href.includes("#") &&
  (href === u("/") ? path === u("/") : path.startsWith(href));
---
<header class="site-header">
  <div class="wrap site-header__bar">
    <a class="brand" href={u("/")} aria-label="Beranda Bangun Sarana Makmur">
      <span class="brand__mark"><Logo /></span>
      <span class="brand__text">
        <span class="brand__mark-t">Bangun Sarana Makmur</span>
        <span class="brand__sub">MATERIAL / DISTRIBUSI · SURABAYA</span>
      </span>
    </a>
    <nav class="nav" aria-label="Navigasi utama">
      <div class="nav__links">
        <a href={u("/")} aria-current={isActive(u("/")) ? "page" : undefined}>Beranda</a>
        <a href={u("/kategori")} aria-current={isActive(u("/kategori")) ? "page" : undefined}>Produk</a>
        <a href={u("/blog")} aria-current={isActive(u("/blog")) ? "page" : undefined}>Catatan</a>
        <a href={u("/#kontak")}>Kontak</a>
      </div>
      <a class="btn btn--primary nav__cta" href={u("/penawaran")}>Minta Penawaran</a>
      <button
        class="nav__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Buka menu"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </nav>
  </div>
  <div class="nav__mobile" id="mobile-menu" hidden>
    <a href={u("/")} aria-current={isActive(u("/")) ? "page" : undefined}>Beranda</a>
    <a href={u("/kategori")} aria-current={isActive(u("/kategori")) ? "page" : undefined}>Produk</a>
    <a href={u("/blog")} aria-current={isActive(u("/blog")) ? "page" : undefined}>Catatan</a>
    <a href={u("/#kontak")}>Kontak</a>
    <a class="btn btn--primary" href={u("/penawaran")}>Minta Penawaran</a>
  </div>
</header>

<script>
  const btn = document.querySelector(".nav__toggle");
  const menu = document.getElementById("mobile-menu");
  btn?.addEventListener("click", () => {
    const open = menu?.hasAttribute("hidden") ?? false;
    if (!menu) return;
    if (open) {
      menu.removeAttribute("hidden");
      btn.setAttribute("aria-expanded", "true");
      btn.setAttribute("aria-label", "Tutup menu");
    } else {
      menu.setAttribute("hidden", "");
      btn.setAttribute("aria-expanded", "false");
      btn.setAttribute("aria-label", "Buka menu");
    }
  });
  menu?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => {
      menu.setAttribute("hidden", "");
      btn?.setAttribute("aria-expanded", "false");
      btn?.setAttribute("aria-label", "Buka menu");
    })
  );
</script>
