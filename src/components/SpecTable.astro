---
// SpecTable — a mono two-column spec sheet, rendered as a drafting-sheet
// title block. Reusable across any ShowcaseItem. Keys are canonical
// (Dimensi · Diameter Kawat · Mesh · Finishing · Asal); entries are omitted
// by the author when they don't apply, so this renders exactly what's given.
import type { SpecEntry } from "../data/catalog.ts";

interface Props {
  specs: SpecEntry[];
  id?: string;
}
const { specs, id } = Astro.props;
---

<dl class="spectable" id={id}>
  {
    specs.map((s) => (
      <div class="spectable__row">
        <dt class="spectable__k label">{s.k}</dt>
        <dd class="spectable__v">{s.v}</dd>
      </div>
    ))
  }
</dl>

<style>
  .spectable {
    margin: 0;
    border: 1px solid var(--steel);
    border-radius: var(--r-md);
    background: var(--paper);
    overflow: hidden;
  }
  .spectable__row {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: 0.5rem;
    align-items: baseline;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--steel);
  }
  .spectable__row:last-child {
    border-bottom: none;
  }
  .spectable__k {
    margin: 0;
    color: var(--ink-muted);
  }
  .spectable__v {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.02em;
    color: var(--ink);
    font-weight: 500;
  }
</style>
