---
import type { HTMLAttributes } from "astro/types";
import type { VariantProps } from "tailwind-variants";
import { input } from "./variants";

type Props = Omit<HTMLAttributes<"input">, "size"> & VariantProps<typeof input>;
const { size, class: className, ...rest } = Astro.props;
---
<input class={input({ size, class: `bsm-starwind-field ${className ?? ""}` })} {...rest} data-slot="input" />
