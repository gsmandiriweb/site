---
import type { HTMLAttributes } from "astro/types";
import type { VariantProps } from "tailwind-variants";
import { textarea } from "./variants";

type Props = Omit<HTMLAttributes<"textarea">, "size"> & VariantProps<typeof textarea>;
const { size, class: className, ...rest } = Astro.props;
---
<textarea class={textarea({ size, class: `bsm-starwind-field ${className ?? ""}` })} {...rest} data-slot="textarea"></textarea>
