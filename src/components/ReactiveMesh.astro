---
// ReactiveMesh — compatibility wrapper for the production Steel Yard atmosphere.
// The old Blueprint mesh shader is intentionally gone from production surfaces.
// This component keeps its existing name for the BRC detail route while using
// the quieter warehouse-light atmosphere and preserving the static fallback.
---

<div class="reactive-mesh" data-reactive-mesh aria-hidden="true"></div>

<style>
  .reactive-mesh {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .reactive-mesh canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  // Lazy-load after first paint so the shader never blocks LCP.
  const container = document.querySelector<HTMLElement>("[data-reactive-mesh]");
  if (container) {
    const start = async () => {
      try {
        const { initSteelYardAtmosphere } = await import("../scripts/steelYardAtmosphere.ts");
        initSteelYardAtmosphere(container);
      } catch {
        // CSS remains the complete visual fallback when the enhancement fails.
      }
    };
    const ric = (window as any).requestIdleCallback;
    if (typeof ric === "function") {
      ric(start, { timeout: 1500 });
    } else {
      window.addEventListener("load", start, { once: true });
    }
  }
</script>
