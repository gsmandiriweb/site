---
// Astro 7 middleware.
// Intercepts unauthenticated requests to /keystatic and redirects
// to the admin login page so the PAT cookie can be set.
import { defineMiddleware } from "astro:middleware";

export const onRequest = defineMiddleware(async (context, next) => {
  const url = new URL(context.request.url);

  // Only intercept /keystatic paths (the admin UI).
  if (url.pathname.startsWith("/keystatic")) {
    // Check for the Keystatic auth cookie.
    const cookieHeader = context.request.headers.get("cookie") ?? "";
    const hasToken = cookieHeader
      .split(";")
      .map((c) => c.trim())
      .some((c) => c.startsWith("keystatic-gh-access-token="));

    if (!hasToken) {
      const loginUrl = new URL("/admin/login", context.url);
      return context.redirect(loginUrl.toString());
    }
  }

  return next();
});
---
