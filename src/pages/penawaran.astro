---
// /penawaran — the quote configurator (ADR-0003).
// Collects buyer intent and composes a pre-filled WhatsApp RFQ. It COMPUTES
// NOTHING: no price, tonnage, stock, or lead time. When the selected product
// has a Showcase, its known specs are auto-injected into the message as
// context (honest — drawn from the same data as the spec table, never typed).
//
// Fields (Q5a): Category, Product (dependent), Quantity + unit, Project
// location, Buyer role, Notes. Name is optional; WhatsApp carries identity.
// No structured Dimensions/Finishing fields — product-specific, would force
// empty fields; the buyer adds anything else in Notes.
import Base from "../layouts/Base.astro";
import { WA_NUMBER } from "../utils/url.ts";
import { categories, configuratorLines } from "../data/catalog.ts";
import Input from "../components/starwind/Input.astro";
import NativeSelect from "../components/starwind/NativeSelect.astro";
import Textarea from "../components/starwind/Textarea.astro";

// Ship the category->lines map to the client as JSON (no runtime fetching).
const linesJson = JSON.stringify(configuratorLines);

const roles = [
  "Kontraktor",
  "Procurement / Pengadaan",
  "Arsitek / Konsultan",
  "Tukang / Aplikator",
  "Pribadi / Renovasi",
];
const units = ["lembar", "batang", "m²", "m", "unit", "set"];
const categoriesJson = JSON.stringify(categories.map(({ slug, name }) => ({ slug, name })));
---

<Base
  title="Minta Penawaran — Bangun Sarana Makmur"
  description="Susun permintaan penawaran material bangunan: pilih kategori, produk, jumlah, dan lokasi proyek. Pesan WhatsApp siap kirim ke tim sales BSM untuk harga pabrik dan pengiriman."
>
  <!-- ===================== HERO ===================== -->
  <section class="hero wrap" aria-labelledby="penawaran-title">
    <div class="hero__copy" style="max-width:none">
      <div class="eyebrow-row">
        <span class="tick" aria-hidden="true"></span>
        <span class="label label--ink">Permintaan Penawaran · RFQ</span>
      </div>
      <h1 class="display" id="penawaran-title">Susun<br />penawaran Anda.</h1>
      <p class="lede">
        Isi rincian kebutuhan material di bawah. Kami kirimkan harga pabrik, ketersediaan stok,
        dan estimasi pengiriman ke proyek Anda — biasanya dalam jam kerja yang sama.
      </p>
    </div>
  </section>

  <!-- ===================== CONFIGURATOR ===================== -->
  <section class="section wrap" style="padding-top:clamp(3.5rem, 8vw, 6rem)" aria-labelledby="config-title">
    <div class="section-head">
      <span class="label">Formulir Penawaran</span>
      <h2 class="headline" id="config-title">Rincian kebutuhan material</h2>
    </div>

    <form class="rfq" id="rfq-form" data-lines={linesJson} data-categories={categoriesJson} data-wa={WA_NUMBER} novalidate>
      <fieldset class="rfq__intent" aria-labelledby="rfq-intent-title">
        <legend class="label" id="rfq-intent-title">Konteks kebutuhan <span class="rfq__optional">· opsional</span></legend>
        <div class="rfq__intent-options">
          <label class="rfq__intent-option">
            <input type="radio" name="intent" value="project" />
            <span>Untuk proyek / pengadaan</span>
          </label>
          <label class="rfq__intent-option">
            <input type="radio" name="intent" value="home" />
            <span>Untuk rumah / renovasi</span>
          </label>
        </div>
        <p class="rfq__intent-note" id="rfq-intent-note">Pilihan ini hanya membantu tim memahami kebutuhan Anda; alurnya tetap sama.</p>
      </fieldset>

      <div class="rfq__items" id="rfq-items" aria-live="polite"></div>
      <template id="rfq-item-template">
        <article class="rfq__item">
          <div class="rfq__item-head">
            <span class="rfq__item-title">Material 1</span>
            <button class="rfq__remove-item" type="button">Hapus</button>
          </div>
          <div class="rfq__item-grid">
            <div class="rfq__field">
              <label class="label" for="rfq-category-template">Kategori material</label>
              <NativeSelect id="rfq-category-template" data-role="category" name="items[0][category]" required size="md">
                <option value="">— Pilih kategori —</option>
                {categories.map((c) => (
                  <option value={c.slug}>{c.name}</option>
                ))}
              </NativeSelect>
            </div>
            <div class="rfq__field">
              <label class="label" for="rfq-product-template">Produk / lini</label>
              <NativeSelect id="rfq-product-template" data-role="product" name="items[0][product]" required disabled size="md">
                <option value="">— Pilih kategori dulu —</option>
              </NativeSelect>
            </div>
            <div class="rfq__field">
              <label class="label" for="rfq-qty-template">Jumlah</label>
              <Input id="rfq-qty-template" data-role="quantity" name="items[0][qty]" type="number" min="1" step="1" inputmode="numeric" placeholder="mis. 100" required size="md" />
            </div>
            <div class="rfq__field">
              <label class="label" for="rfq-unit-template">Satuan</label>
              <NativeSelect id="rfq-unit-template" data-role="unit" name="items[0][unit]" aria-label="Satuan" size="md">
                {units.map((u2) => (
                  <option value={u2}>{u2}</option>
                ))}
              </NativeSelect>
            </div>
            <span class="rfq__item-hint" data-role="hint" aria-live="polite"></span>
          </div>
        </article>
      </template>
      <button class="rfq__add-item" id="rfq-add-item" type="button">+ Tambah material lain</button>

      <div class="rfq__meta-grid">
        {/* Project location */}
        <div class="rfq__field">
          <label class="label" for="rfq-location">Lokasi proyek / kota</label>
          <Input id="rfq-location" name="location" type="text" placeholder="mis. Surabaya, Jakarta, Balikpapan…" required size="md" />
        </div>

        {/* Buyer role */}
        <div class="rfq__field">
          <label class="label" for="rfq-role">Profesi Anda</label>
          <NativeSelect id="rfq-role" name="role" size="md">
            <option value="">— Pilih jika berlaku —</option>
            {roles.map((r) => (
              <option value={r}>{r}</option>
            ))}
          </NativeSelect>
        </div>

        {/* Notes */}
        <div class="rfq__field rfq__field--full">
          <label class="label" for="rfq-notes">Catatan tambahan</label>
          <Textarea id="rfq-notes" name="notes" rows="3" placeholder="Dimensi khusus, finishing, jadwal proyek, pertanyaan lain…" size="md" />
        </div>
      </div>

      {/* Live preview of the composed message */}
      <div class="rfq__preview" aria-live="polite">
        <span class="label">Pratinjau pesan WhatsApp</span>
        <pre class="rfq__message" id="rfq-message"></pre>
      </div>

      <div class="rfq__actions">
        <button type="submit" class="btn btn--primary rfq__submit" id="rfq-submit" aria-describedby="rfq-status">
          Buka WhatsApp dengan permintaan ini
        </button>
        <button type="button" class="rfq__clear" id="rfq-clear">Bersihkan formulir</button>
      </div>
      <p class="rfq__status" id="rfq-status" role="status" aria-live="polite" hidden></p>
    </form>
  </section>
</Base>

<style>
  .rfq {
    border: 1px solid var(--steel);
    border-radius: var(--r-lg);
    background: var(--paper);
    padding: clamp(1.2rem, 3vw, 2rem);
  }
  .rfq__intent {
    margin: 0 0 1.6rem;
    padding: 0 0 1.35rem;
    border: 0;
    border-bottom: 1px solid var(--steel);
  }
  .rfq__optional { color: var(--ink-muted); font-family: var(--font-body); letter-spacing: 0; text-transform: none; }
  .rfq__intent-options { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-top: 0.65rem; }
  .rfq__intent-option { display: inline-flex; align-items: center; gap: 0.55rem; padding: 0.65rem 0.8rem; border: 1px solid var(--steel); border-radius: var(--r-md); cursor: pointer; color: var(--ink); transition: border-color 0.18s var(--ease), background 0.18s var(--ease); }
  .rfq__intent-option:has(input:checked) { border-color: var(--blueprint); background: rgba(201, 180, 138, 0.12); }
  .rfq__intent-option input { width: auto; accent-color: var(--blueprint); }
  .rfq__intent-option span { font-size: 0.92rem; }
  .rfq__intent-note { margin-top: 0.55rem; color: var(--ink-muted); font-size: 0.82rem; line-height: 1.5; }
  .rfq__items { display: grid; gap: 1rem; }
  .rfq__item { padding: 1rem; border: 1px solid var(--steel); border-radius: var(--r-md); background: var(--paper-deep); }
  .rfq__item-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 0.8rem; }
  .rfq__item-title { color: var(--ink); font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .rfq__remove-item { border: 0; background: transparent; color: var(--ink-muted); cursor: pointer; font: inherit; font-size: 0.78rem; }
  .rfq__remove-item:hover { color: #c84b40; }
  .rfq__item-grid, .rfq__meta-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.2rem 1.5rem; }
  .rfq__item-grid { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1.3fr) minmax(7rem, 0.7fr) minmax(7rem, 0.75fr); align-items: end; }
  .rfq__item-hint { grid-column: 1 / -1; }
  .rfq__add-item { margin-top: 1rem; border: 1px dashed var(--blueprint); border-radius: var(--r-md); padding: 0.7rem 1rem; background: transparent; color: var(--blueprint); cursor: pointer; font: inherit; }
  .rfq__add-item:hover { background: rgba(201, 180, 138, 0.1); }
  .rfq__meta-grid { margin-top: 1.6rem; }
  .rfq__field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .rfq__field--full {
    grid-column: 1 / -1;
  }
  .rfq__field .label {
    color: var(--ink-muted);
  }

  .rfq__item-hint { font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.06em; color: var(--blueprint); }
  .rfq__item-hint:empty { display: none; }

  /* Preview */
  .rfq__preview {
    margin-top: 1.6rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--steel);
  }
  .rfq__preview .label {
    color: var(--ink-muted);
    display: block;
    margin-bottom: 0.6rem;
  }
  .rfq__message {
    margin: 0;
    padding: 1rem 1.2rem;
    background: var(--paper-deep);
    border: 1px solid var(--steel);
    border-radius: var(--r-md);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--ink);
    white-space: pre-wrap;
    word-break: break-word;
    min-height: 4rem;
  }
  .rfq__message:empty::before {
    content: "Lengkapi formulir — pratinjau pesan akan muncul di sini.";
    color: var(--ink-muted);
    font-style: italic;
  }

  /* Actions */
  .rfq__actions {
    margin-top: 1.6rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }
  .rfq__submit:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .rfq__clear {
    border: 1px solid var(--steel);
    border-radius: var(--r-md);
    padding: 0.75rem 1rem;
    background: transparent;
    color: var(--ink-muted);
    cursor: pointer;
    font: inherit;
    transition: border-color 0.18s var(--ease), color 0.18s var(--ease), background 0.18s var(--ease);
  }
  .rfq__clear:hover,
  .rfq__clear:focus-visible {
    border-color: var(--ink);
    color: var(--ink);
    background: var(--paper-deep);
  }
  .rfq__status {
    margin: 1rem 0 0;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--steel);
    border-radius: var(--r-md);
    color: var(--ink-muted);
    font-size: 0.88rem;
  }
  .rfq__status[data-tone="error"] {
    border-color: #ef6a61;
    color: #ffb8b1;
  }
  .rfq__status[data-tone="success"] {
    border-color: var(--blueprint);
    color: var(--yard-light);
  }
  .rfq__status a {
    color: var(--blueprint);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  @media (max-width: 980px) {
    .rfq__item-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 640px) {
    .rfq__item-grid, .rfq__meta-grid { grid-template-columns: 1fr; }
    }
</style>

<script>
  const form = document.getElementById("rfq-form") as HTMLFormElement | null;
  if (form) {
    const lines: Record<string, { name: string; specContext?: string }[]> = JSON.parse(form.dataset.lines || "{}");
    const categoryOptions: { slug: string; name: string }[] = JSON.parse(form.dataset.categories || "[]");
    const waNumber = form.dataset.wa || "6281249343303";
    const itemsEl = document.getElementById("rfq-items") as HTMLDivElement;
    const addItemEl = document.getElementById("rfq-add-item") as HTMLButtonElement;
    const clearEl = document.getElementById("rfq-clear") as HTMLButtonElement;
    const locationEl = document.getElementById("rfq-location") as HTMLInputElement;
    const roleEl = document.getElementById("rfq-role") as HTMLSelectElement;
    const notesEl = document.getElementById("rfq-notes") as HTMLTextAreaElement;
    const intentEls = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="intent"]'));
    const intentNoteEl = document.getElementById("rfq-intent-note");
    const messageEl = document.getElementById("rfq-message");
    const submitEl = document.getElementById("rfq-submit") as HTMLButtonElement;
    const statusEl = document.getElementById("rfq-status");
    let isSubmitting = false;
    const defaultMessage = "Halo BSM, saya ingin meminta penawaran material. Mohon bantu info produk yang sesuai, harga pabrik, ketersediaan stok, dan pengiriman. Terima kasih.";
    let itemCount = 0;

    const categoryName = (slug: string) => categoryOptions.find((category) => category.slug === slug)?.name ?? slug;
    const itemTemplate = document.getElementById("rfq-item-template") as HTMLTemplateElement;

    function createItem() {
      itemCount += 1;
      const item = document.importNode(itemTemplate.content, true).firstElementChild as HTMLElement;
      item.dataset.item = String(itemCount);
      itemsEl.appendChild(item);
      bindItem(item);
      return item;
    }

    function bindItem(item: HTMLElement) {
      const number = Number(item.dataset.item || "1");
      const category = item.querySelector<HTMLSelectElement>('[data-role="category"]')!;
      const product = item.querySelector<HTMLSelectElement>('[data-role="product"]')!;
      const quantity = item.querySelector<HTMLInputElement>('[data-role="quantity"]')!;
      const unit = item.querySelector<HTMLSelectElement>('[data-role="unit"]')!;
      const hint = item.querySelector<HTMLElement>('[data-role="hint"]')!;
      const remove = item.querySelector<HTMLButtonElement>(".rfq__remove-item")!;
      const updateHint = () => {
        const specContext = lines[category.value]?.find((option) => option.name === product.value)?.specContext;
        hint.textContent = specContext ? `Spesifikasi terlampir: ${specContext}` : "";
      };
      category.id = `rfq-category-${number}`;
      product.id = `rfq-product-${number}`;
      quantity.id = `rfq-qty-${number}`;
      unit.id = `rfq-unit-${number}`;
      category.name = `items[${number}][category]`;
      product.name = `items[${number}][product]`;
      quantity.name = `items[${number}][qty]`;
      unit.name = `items[${number}][unit]`;
      item.querySelector<HTMLLabelElement>(`label[for="rfq-category-template"]`)!.htmlFor = category.id;
      item.querySelector<HTMLLabelElement>(`label[for="rfq-product-template"]`)!.htmlFor = product.id;
      item.querySelector<HTMLLabelElement>(`label[for="rfq-qty-template"]`)!.htmlFor = quantity.id;
      item.querySelector<HTMLLabelElement>(`label[for="rfq-unit-template"]`)!.htmlFor = unit.id;
      remove.addEventListener("click", () => {
        if (itemsEl.children.length === 1) return;
        item.remove();
        renumberItems();
        update();
      });
      category.addEventListener("change", () => {
        const options = lines[category.value] ?? [];
        product.innerHTML = `<option value="">${options.length ? "— Pilih produk —" : "— Tidak ada lini —"}</option>`;
        options.forEach((option) => product.add(new Option(option.name, option.name)));
        product.disabled = options.length === 0;
        updateHint();
        clearStatus();
        update();
      });
      product.addEventListener("change", () => { updateHint(); clearStatus(); update(); });
      [quantity, unit].forEach((element) => {
        element.addEventListener("input", () => { clearStatus(); update(); });
        element.addEventListener("change", () => { clearStatus(); update(); });
      });
    }

    function renumberItems() {
      Array.from(itemsEl.children).forEach((element, index) => {
        const item = element as HTMLElement;
        const itemNumber = index + 1;
        item.dataset.item = String(itemNumber);
        item.querySelector<HTMLElement>(".rfq__item-title")!.textContent = `Material ${itemNumber}`;
        item.dataset.item = String(itemNumber);
        const category = item.querySelector<HTMLSelectElement>('[data-role="category"]');
        const product = item.querySelector<HTMLSelectElement>('[data-role="product"]');
        const quantity = item.querySelector<HTMLInputElement>('[data-role="quantity"]');
        const unit = item.querySelector<HTMLSelectElement>('[data-role="unit"]');
        if (category) { category.name = `items[${itemNumber}][category]`; category.id = `rfq-category-${itemNumber}`; }
        if (product) { product.name = `items[${itemNumber}][product]`; product.id = `rfq-product-${itemNumber}`; }
        if (quantity) { quantity.name = `items[${itemNumber}][qty]`; quantity.id = `rfq-qty-${itemNumber}`; }
        if (unit) { unit.name = `items[${itemNumber}][unit]`; unit.id = `rfq-unit-${itemNumber}`; }
        const labels = item.querySelectorAll<HTMLLabelElement>("label");
        if (labels[0] && category) labels[0].htmlFor = category.id;
        if (labels[1] && product) labels[1].htmlFor = product.id;
        if (labels[2] && quantity) labels[2].htmlFor = quantity.id;
        if (labels[3] && unit) labels[3].htmlFor = unit.id;
        const remove = item.querySelector<HTMLButtonElement>(".rfq__remove-item");
        if (remove) remove.disabled = itemsEl.children.length === 1;
      });
    }

    addItemEl.addEventListener("click", () => { createItem(); renumberItems(); update(); });

    clearEl.addEventListener("click", () => {
      itemsEl.replaceChildren();
      itemCount = 0;
      isSubmitting = false;
      intentEls.forEach((element) => { element.checked = false; });
      locationEl.value = "";
      roleEl.value = "";
      notesEl.value = "";
      clearStatus();
      createItem();
      renumberItems();
      update();
      itemsEl.querySelector<HTMLSelectElement>('[data-role="category"]')?.focus();
    });

    createItem();
    renumberItems();

    // Compose the WhatsApp RFQ from the buyer's inputs. Computes nothing —
    // only assembles text. Known specs (from the Showcase) are injected as
    // context when the selected product carries them.
    function selectedIntent(): string {
      return intentEls.find((el) => el.checked)?.value || "";
    }

    function readItems() {
      return Array.from(itemsEl.querySelectorAll<HTMLElement>(".rfq__item")).map((item) => {
        // data-role is the stable contract for a dynamic row; names and IDs are
        // renumbered whenever a material is removed.
        const category = item.querySelector<HTMLSelectElement>('[data-role="category"]')!;
        const product = item.querySelector<HTMLSelectElement>('[data-role="product"]')!;
        const quantity = item.querySelector<HTMLInputElement>('[data-role="quantity"]')!;
        const unit = item.querySelector<HTMLSelectElement>('[data-role="unit"]')!;
        return { item, category: category.value, product: product.value, qty: quantity.value.trim(), unit: unit.value, productOptions: product.options };
      });
    }

    function hasItemInput(item: ReturnType<typeof readItems>[number]): boolean {
      return Boolean(item.category || item.product || item.qty);
    }

    function compose(): string {
      const items = readItems();
      const enteredItems = items.filter(hasItemInput);
      const location = locationEl.value.trim();
      const role = roleEl.value;
      const notes = notesEl.value.trim();
      const intent = selectedIntent();

      // Keep the no-calculator path useful: without a material row, open with
      // the standard inquiry instead of sending a request with no material.
      if (!enteredItems.length) return defaultMessage;

      const lines_: string[] = ["Halo BSM, saya ingin meminta penawaran beberapa material:", ""];
      enteredItems.forEach((entry, index) => {
        const specContext = lines[entry.category]?.find((option) => option.name === entry.product)?.specContext;
        const category = entry.category ? categoryName(entry.category) : "Kategori belum dipilih";
        const product = entry.product || "Produk belum dipilih";
        lines_.push(`${index + 1}. ${category} — ${product}`);
        lines_.push(`   Jumlah: ${entry.qty ? `${entry.qty} ${entry.unit}` : "belum diisi"}`);
        if (specContext) lines_.push(`   Spesifikasi: ${specContext}`);
      });
      if (intent) lines_.push(`• Konteks: ${intent === "project" ? "Untuk proyek / pengadaan" : "Untuk rumah / renovasi"}`);
      if (location) lines_.push(`• Lokasi proyek: ${location}`);
      if (role) lines_.push(`• Profesi: ${role}`);
      if (notes) {
        lines_.push("");
        lines_.push(`Catatan: ${notes}`);
      }
      lines_.push("");
      lines_.push("Mohon info harga pabrik, ketersediaan stok, dan pengiriman. Terima kasih.");
      return lines_.join("\n");
    }

    function validationMessage(): string {
      const items = readItems();
      const enteredItems = items.filter(hasItemInput);
      // Empty rows are ignored so adding a future material does not invalidate
      // the material rows the buyer has already completed.
      for (const item of enteredItems) {
        if (!item.category) return "Pilih kategori untuk setiap material.";
        if (!item.product || !Array.from(item.productOptions).some((option) => option.value === item.product)) return "Pilih produk untuk setiap material.";
        const quantity = Number.parseFloat(item.qty);
        if (!Number.isFinite(quantity) || quantity < 1 || !Number.isInteger(quantity)) return "Masukkan jumlah minimal 1 dalam angka bulat untuk setiap material.";
      }
      if (enteredItems.length && !locationEl.value.trim()) return "Masukkan lokasi proyek atau kota pengiriman.";
      return "";
    }

    function clearStatus() {
      if (!statusEl) return;
      statusEl.hidden = true;
      statusEl.textContent = "";
      statusEl.removeAttribute("data-tone");
    }

    function showStatus(message: string, tone: "error" | "success" | "info", fallbackUrl?: string) {
      if (!statusEl) return;
      statusEl.replaceChildren(document.createTextNode(message));
      if (fallbackUrl) {
        statusEl.append(" ");
        const fallback = document.createElement("a");
        fallback.href = fallbackUrl;
        fallback.target = "_blank";
        fallback.rel = "noopener noreferrer";
        fallback.textContent = "Buka WhatsApp secara manual";
        statusEl.appendChild(fallback);
      }
      statusEl.dataset.tone = tone;
      statusEl.hidden = false;
    }

    function update() {
      const msg = compose();
      if (messageEl) messageEl.textContent = msg;
      // WhatsApp is always available. Complete details produce the tailored
      // RFQ; otherwise compose() supplies a standard inquiry message.
      submitEl.disabled = isSubmitting;

      const intent = selectedIntent();
      if (intentNoteEl) intentNoteEl.textContent = intent ? `Konteks dipilih: ${intent === "project" ? "untuk proyek / pengadaan" : "untuk rumah / renovasi"}.` : "Pilihan ini hanya membantu tim memahami kebutuhan Anda; alurnya tetap sama.";
    }

    [locationEl, roleEl, notesEl, ...intentEls].forEach((el) =>
      el.addEventListener("input", () => {
        clearStatus();
        update();
      }),
    );

    const query = new URLSearchParams(window.location.search);
    const intentFromUrlEl = intentEls.find((el) => el.value === query.get("intent"));
    if (intentFromUrlEl) intentFromUrlEl.checked = true;

    const categoryFromUrl = query.get("category");
    if (categoryFromUrl && categoryOptions.some((option) => option.slug === categoryFromUrl)) {
      const firstCategory = itemsEl.querySelector<HTMLSelectElement>('[data-role="category"]');
      firstCategory!.value = categoryFromUrl;
      firstCategory!.dispatchEvent(new Event("change"));
      const productFromUrl = query.get("product");
      const firstProduct = itemsEl.querySelector<HTMLSelectElement>('[data-role="product"]');
      if (productFromUrl && firstProduct && Array.from(firstProduct.options).some((option) => option.value === productFromUrl)) {
        firstProduct.value = productFromUrl;
        firstProduct.dispatchEvent(new Event("change"));
      }
    }
    const notesFromUrl = query.get("notes");
    if (notesFromUrl) notesEl.value = notesFromUrl.slice(0, 1200);
    update();

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      if (isSubmitting) return;
      const validationError = validationMessage();
      if (validationError) {
        showStatus(validationError, "error");
        return;
      }
      const msg = compose();
      isSubmitting = true;
      update();
      const url = `https://wa.me/${waNumber}?text=${encodeURIComponent(msg)}`;
      const popup = window.open(url, "_blank", "noopener,noreferrer");
      if (!popup) {
        isSubmitting = false;
        showStatus("WhatsApp tidak dapat dibuka otomatis karena diblokir browser.", "error", url);
        update();
        return;
      }
      showStatus("Rincian siap. WhatsApp dibuka di tab baru untuk Anda tinjau dan kirim.", "success");
      window.setTimeout(() => {
        isSubmitting = false;
        update();
      }, 1200);
    });

    update();
  }
</script>
