---
import Base from "../../layouts/Base.astro";
import CategoryIcon from "../../components/CategoryIcon.astro";
import { Image } from "astro:assets";
import { imageAsset } from "../../utils/images.ts";
import { quoteLink, u } from "../../utils/url.ts";
import { categories, brcProducts, getCategory } from "../../data/catalog.ts";

export function getStaticPaths() {
  return categories.map((c) => ({ params: { slug: c.slug }, props: { category: c } }));
}

const { category } = Astro.props;
const quote = quoteLink({ category: category.slug });
const isBrc = category.slug === "pagar";
---
<Base title={`${category.name} — Bangun Sarana Makmur`}>
  <section class="hero wrap" aria-labelledby="c-title">
    <div class="cat-hero">
      <div class="hero__copy" style="max-width:none">
        <div class="eyebrow-row">
          <span class="tick" aria-hidden="true"></span>
          <span class="label label--ink">{category.count} lini produk</span>
        </div>
        <h1 class="display" id="c-title" style="font-size:clamp(2rem,5vw,3.4rem)">{category.name}</h1>
        <p class="lede">{category.blurb}</p>
        <div class="hero__actions">
          <a class="btn btn--primary" href={quote}>Susun Permintaan Penawaran</a>
          <a class="btn btn--ghost" href={u("/kategori")}>Semua Kategori</a>
        </div>
      </div>
      <figure class="specimen" aria-label={category.name}>
        <Image src={imageAsset(category.image)} alt={category.name} width={700} format="webp" loading="eager" fetchpriority="high" decoding="async" />
        <figcaption class="specimen__titleblock">
          <b>{category.name.toUpperCase()}</b><br />ORIGIN SBY
        </figcaption>
      </figure>
    </div>
  </section>

  {
    isBrc && (
      <section class="section section--deep wrap" aria-labelledby="brc-t">
        <div class="section-head">
          <span class="label">Produk Unggulan · BRC</span>
          <h2 class="headline" id="brc-t">Pagar BRC: diproduksi, dilas, siap kirim</h2>
        </div>
        <div class="prod-row">
          {brcProducts.map((p) => (
            <a
              class="prod"
              href={quoteLink({ category: category.slug, product: p.name === "Pagar BRC Panel" ? "Pagar BRC" : p.name, notes: `Konteks produk: ${p.name}. Spesifikasi yang ditampilkan: ${p.spec}` })}
              aria-label={`Susun permintaan penawaran untuk ${p.name}`}>
              <span class="specimen"><Image src={imageAsset(p.image)} alt={p.name} width={400} format="webp" loading="lazy" decoding="async" />
                <span class="specimen__titleblock"><b>{p.name.toUpperCase()}</b><br />GALVANIS</span>
              </span>
              <span class="prod__name">{p.name}</span>
              <span class="prod__spec">{p.spec}</span>
            </a>
          ))}
        </div>
        <p style="margin-top:2rem">
          <a class="btn btn--ghost" href={u("/pagar-brc")}>Lihat detail &amp; spesifikasi BRC →</a>
        </p>
      </section>
    )
  }

  <section class="section wrap" aria-labelledby="lines-t">
    <div class="section-head">
      <span class="label">Daftar Produk</span>
      <h2 class="headline" id="lines-t">Lini produk {category.name}</h2>
    </div>

    <div class="bom-filter">
      <label class="label" for="bom-search">Cari lini produk</label>
      <input
        id="bom-search"
        class="bom-search"
        type="search"
        placeholder="mis. bondek, acp, kawat…"
        autocomplete="off"
        aria-describedby="bom-count"
      />
      <span class="bom-count" id="bom-count" aria-live="polite"></span>
    </div>

    <div class="bom" id="bom-list">
      {
        category.lines.map((line, i) => (
          <div class="bom__row" data-line={line.toLowerCase()}>
            <span class="tick" aria-hidden="true"></span>
            <span>{line}</span>
            <span class="n">{String(i + 1).padStart(2, "0")}</span>
          </div>
        ))
      }
    </div>
    <p class="bom-empty" id="bom-empty" hidden>
      Tidak ada lini yang cocok.<button type="button" class="bom-reset" id="bom-reset">Reset</button>
    </p>
    <p style="margin-top:2rem">
      <a class="btn btn--primary" href={quote}>Susun permintaan penawaran {category.name} →</a>
    </p>
  </section>
</Base>

<script>
  const input = document.getElementById("bom-search") as HTMLInputElement | null;
  const list = document.getElementById("bom-list");
  const count = document.getElementById("bom-count");
  const empty = document.getElementById("bom-empty");
  const reset = document.getElementById("bom-reset");

  if (input && list) {
    const rows = Array.from(list.querySelectorAll<HTMLElement>(".bom__row"));
    // Strip accents so "atap" matches "Atap", "kawat" matches "Kawat".
    const norm = (s: string) => s.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");

    const update = () => {
      const q = norm(input.value.trim());
      let shown = 0;
      rows.forEach((row) => {
        const hay = norm(row.dataset.line || row.textContent || "");
        const match = !q || hay.includes(q);
        row.style.display = match ? "" : "none";
        if (match) shown++;
      });
      if (count) count.textContent = `${shown} dari ${rows.length} lini`;
      if (empty) empty.hidden = shown > 0;
    };

    input.addEventListener("input", update);
    reset?.addEventListener("click", () => {
      input.value = "";
      update();
      input.focus();
    });
    update();
  }
</script>
