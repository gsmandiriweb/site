---
import { readAdminSession } from "../../utils/admin-session.ts";

// The login page is a runtime surface: owners who already hold a valid
// session bounce straight into the dashboard instead of seeing the form.
export const prerender = false;

const safeNext = "/admin";

if (await readAdminSession(Astro.request)) {
  return Astro.redirect("/admin");
}
---
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />    <meta name="robots" content="noindex, nofollow" />
    <script is:inline>
      (function () {
        try {
          var stored = window.localStorage.getItem("bsm-theme");
          var theme = stored === "light" || stored === "dark"
            ? stored
            : "light";
          document.documentElement.dataset.theme = theme;
        } catch {
          document.documentElement.dataset.theme = "light";
        }
      })();
    </script>
  <title>BSM Admin · Masuk</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62.5..125,400..800&family=Hanken+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
    rel="stylesheet"
  />
  <style>

    :root { color-scheme: dark; font-family: "Hanken Grotesk", system-ui, sans-serif; background: #0b0d0f; color: #f4f1e9; }
    html[data-theme="light"] { color-scheme: light; }
    * { box-sizing: border-box; }
    body { min-height: 100vh; margin: 0; display: grid; place-items: center; padding: 24px; background: radial-gradient(circle at 50% 0%, rgba(201,180,138,.13), transparent 42%), #0b0d0f; }
    main { width: min(100%, 420px); }
    .mark { display: grid; place-items: center; width: 42px; height: 42px; margin-bottom: 28px; border: 1px solid rgba(201,180,138,.5); color: #c9b48a; font: 800 14px/1 "JetBrains Mono", ui-monospace, monospace; letter-spacing: .08em; }
    .eyebrow { color: #c9b48a; font: 500 10px/1 "JetBrains Mono", ui-monospace, monospace; letter-spacing: .16em; text-transform: uppercase; }
    h1 { font-family: "Archivo", "Arial Narrow", sans-serif; font-weight: 800; font-stretch: 110%; margin: 12px 0 10px; font-size: clamp(2.3rem, 8vw, 3.5rem); line-height: .95; letter-spacing: -.02em; }
    .intro { max-width: 34rem; margin: 0 0 26px; color: #aeb4ba; font-size: 14px; line-height: 1.6; }
    .card { padding: 22px; border: 1px solid rgba(130,138,147,.3); background: rgba(20,22,26,.88); box-shadow: 0 24px 70px rgba(0,0,0,.3); }
    label { display: grid; gap: 8px; color: #aeb4ba; font: 600 10px/1 "JetBrains Mono", ui-monospace, monospace; letter-spacing: .12em; text-transform: uppercase; }
    label + label { margin-top: 16px; }
    input { width: 100%; min-height: 46px; padding: 0 12px; border: 1px solid rgba(130,138,147,.42); border-radius: 3px; outline: 0; background: #101216; color: #f4f1e9; font: 400 15px/1.4 "JetBrains Mono", ui-monospace, monospace; }
    input:focus { border-color: #c9b48a; box-shadow: 0 0 0 3px rgba(201,180,138,.12); }
    button { width: 100%; min-height: 46px; margin-top: 18px; border: 0; border-radius: 3px; background: #e8551e; color: #fff; cursor: pointer; font: 700 10px "JetBrains Mono", ui-monospace, monospace; letter-spacing: .1em; text-transform: uppercase; }
    button:hover { background: #c8430f; }
    .note { margin: 18px 0 0; color: #7f878f; font-size: 11px; line-height: 1.55; }
    .back { display: inline-block; margin-top: 22px; color: #c9b48a; font: 600 10px "JetBrains Mono", ui-monospace, monospace; letter-spacing: .1em; text-decoration: none; text-transform: uppercase; }
    .back:hover { color: #f4f1e9; }
    .theme-toggle { position: fixed; top: 20px; right: 20px; display: inline-flex; align-items: center; gap: 7px; min-height: 36px; padding: 0 11px; border: 1px solid rgba(130,138,147,.42); border-radius: 999px; background: rgba(20,22,26,.72); color: #aeb4ba; cursor: pointer; font: 600 10px "JetBrains Mono", ui-monospace, monospace; letter-spacing: .08em; text-transform: uppercase; }
    .theme-toggle:hover, .theme-toggle:focus-visible { border-color: #c9b48a; color: #f4f1e9; }
    html[data-theme="light"] :root { color-scheme: light; }
    html[data-theme="light"] body { background: radial-gradient(circle at 50% 0%, rgba(105,75,31,.12), transparent 42%), #f3efe5; color: #17212b; }
    html[data-theme="light"] .mark { border-color: rgba(105,75,31,.5); color: #694b1f; }
    html[data-theme="light"] .eyebrow, html[data-theme="light"] .back { color: #694b1f; }
    html[data-theme="light"] .intro, html[data-theme="light"] label { color: #46545f; }
    html[data-theme="light"] .card { border-color: rgba(23,33,43,.22); background: rgba(255,250,242,.82); box-shadow: 0 24px 70px rgba(23,33,43,.14); }
    html[data-theme="light"] input { border-color: rgba(23,33,43,.3); background: #fffaf2; color: #17212b; }
    html[data-theme="light"] input:focus { border-color: #694b1f; box-shadow: 0 0 0 3px rgba(105,75,31,.12); }
    html[data-theme="light"] .note { color: #667784; }
    html[data-theme="light"] .theme-toggle { border-color: rgba(23,33,43,.28); background: rgba(255,250,242,.76); color: #46545f; }
    html[data-theme="light"] .theme-toggle:hover, html[data-theme="light"] .theme-toggle:focus-visible { border-color: #694b1f; color: #17212b; }
    @media (prefers-reduced-motion: reduce) { .theme-toggle { transition: none; } }
  </style>
</head>
<body>
  <button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label="Aktifkan mode terang" title="Aktifkan mode terang"><span aria-hidden="true">☼</span><span data-theme-label>Terang</span></button>
  <main>
    <div class="mark" aria-hidden="true">BSM</div>
    <div class="eyebrow">Ruang kerja privat</div>
    <h1>Masuk ke dasbor editorial.</h1>
    <p class="intro">Gunakan username dan password owner untuk membuka dasbor editorial. Akses GitHub tetap di server dan tidak pernah disimpan di browser.</p>
    <form class="card" method="post" action={`/api/auth/pat-login?next=${encodeURIComponent(safeNext)}`}>
      <label for="username">Username owner</label>
      <input id="username" name="username" type="text" autocomplete="username" autocapitalize="none" spellcheck="false" required autofocus />
      <label for="password">Password</label>
      <input id="password" name="password" type="password" autocomplete="current-password" required />
      <button type="submit">Lanjut ke dasbor <span aria-hidden="true">→</span></button>
      <p class="note">Halaman ini khusus untuk owner situs. Jika Anda tidak memiliki kredensialnya, minta akses kepada owner.</p>
    </form>
    <a class="back" href="/">← Kembali ke BSM</a>
  </main>
</body>
  <script is:inline>
    (function () {
      var buttons = Array.from(document.querySelectorAll("[data-theme-toggle]"));
      var root = document.documentElement;
      function applyTheme(theme) {
        root.dataset.theme = theme;
        var light = theme === "light";
        buttons.forEach(function (button) {
          button.setAttribute("aria-pressed", String(light));
          button.setAttribute("aria-label", light ? "Aktifkan mode gelap" : "Aktifkan mode terang");
          button.setAttribute("title", light ? "Aktifkan mode gelap" : "Aktifkan mode terang");
          var label = button.querySelector("[data-theme-label]");
          if (label) label.textContent = light ? "Gelap" : "Terang";
        });
      }
      buttons.forEach(function (button) {
        button.addEventListener("click", function () {
          var next = root.dataset.theme === "light" ? "dark" : "light";
          applyTheme(next);
          try { window.localStorage.setItem("bsm-theme", next); } catch (_) {}
        });
      });
      applyTheme(root.dataset.theme === "dark" ? "dark" : "light");
    })();
  </script>
</html>
