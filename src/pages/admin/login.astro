---
import { readAdminSession } from "../../utils/admin-session.ts";

// CMS visual direction: Linear-like operate surfaces. Restrained neutrals +
// one indigo accent, compact workhorse type, visible focus and state styling.
// Applies to the CMS routes only (the public site keeps its own world).
// The login page is a runtime surface: owners who already hold a valid
// session bounce straight into the dashboard instead of seeing the form.
export const prerender = false;

const safeNext = "/admin";

if (await readAdminSession(Astro.request)) {
  return Astro.redirect("/admin");
}
---
<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Masuk · BSM Editorial</title>
  <style>
    :root {
      color-scheme: dark;
      --cms-bg: #08090a;
      --cms-glow: rgba(94, 106, 210, 0.13);
      --cms-text: #f7f8f8;
      --cms-text-2: #a0a8b8;
      --cms-text-3: #6b7484;
      --cms-field-bg: #101318;
      --cms-border: rgba(255, 255, 255, 0.09);
      --cms-border-strong: rgba(255, 255, 255, 0.17);
      --cms-accent: #5e6ad2;
      --cms-accent-hover: #6c78dc;
      --cms-accent-active: #4c58b8;
      --cms-ring: rgba(94, 106, 210, 0.38);
      --cms-danger: #e5484d;
    }
    html[data-theme="light"] {
      color-scheme: light;
      --cms-bg: #f4f5f7;
      --cms-glow: rgba(94, 106, 210, 0.1);
      --cms-text: #08090a;
      --cms-text-2: #525b6b;
      --cms-text-3: #8a93a3;
      --cms-field-bg: #ffffff;
      --cms-border: rgba(8, 9, 10, 0.12);
      --cms-border-strong: rgba(8, 9, 10, 0.22);
      --cms-ring: rgba(94, 106, 210, 0.28);
    }
    * { box-sizing: border-box; }
    html, body { height: 100%; }
    body {
      margin: 0;
      min-height: 100vh;
      display: grid;
      place-items: center;
      padding: 40px 20px;
      font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: var(--cms-bg);
      color: var(--cms-text);
      -webkit-font-smoothing: antialiased;
    }
    body::before {
      content: "";
      position: fixed;
      inset: 0;
      pointer-events: none;
      background: radial-gradient(560px 340px at 50% -60px, var(--cms-glow), transparent 70%);
    }
    ::selection { background: rgba(94, 106, 210, 0.4); }
    main {
      position: relative;
      width: 100%;
      max-width: 340px;
    }
    .brand {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      margin-bottom: 28px;
    }
    .brand__mark {
      display: grid;
      place-items: center;
      width: 30px;
      height: 30px;
      border-radius: 8px;
      background: var(--cms-accent);
      color: #fff;
      font-size: 14px;
      font-weight: 700;
      letter-spacing: 0;
      box-shadow: 0 4px 16px rgba(94, 106, 210, 0.35);
    }
    .brand__name {
      font-size: 14px;
      font-weight: 600;
      letter-spacing: -0.01em;
    }
    .brand__name span { color: var(--cms-text-3); font-weight: 500; }
    h1 {
      margin: 0 0 8px;
      font-size: 22px;
      line-height: 1.25;
      font-weight: 600;
      letter-spacing: -0.015em;
      text-align: center;
      text-wrap: balance;
    }
    .sub {
      margin: 0 0 24px;
      font-size: 14px;
      line-height: 1.55;
      color: var(--cms-text-2);
      text-align: center;
      text-wrap: balance;
    }
    form { display: grid; gap: 14px; }
    .field { display: grid; gap: 6px; }
    label {
      font-size: 13px;
      font-weight: 500;
      color: var(--cms-text-2);
    }
    input {
      width: 100%;
      height: 40px;
      padding: 0 12px;
      border: 1px solid var(--cms-border);
      border-radius: 6px;
      background: var(--cms-field-bg);
      color: var(--cms-text);
      caret-color: var(--cms-accent);
      font: inherit;
      font-size: 14px;
      outline: none;
      transition: border-color 120ms ease, box-shadow 120ms ease, background 120ms ease;
    }
    input::placeholder { color: var(--cms-text-3); }
    input:hover { border-color: var(--cms-border-strong); }
    input:focus { border-color: var(--cms-accent); box-shadow: 0 0 0 3px var(--cms-ring); }
    input:-webkit-autofill {
      -webkit-text-fill-color: var(--cms-text);
      caret-color: var(--cms-text);
      box-shadow: 0 0 0 100px var(--cms-field-bg) inset;
    }
    .submit {
      height: 40px;
      margin-top: 4px;
      border: 0;
      border-radius: 6px;
      background: var(--cms-accent);
      color: #fff;
      font: inherit;
      font-size: 14px;
      font-weight: 500;
      cursor: pointer;
      transition: background 120ms ease, transform 60ms ease;
    }
    .submit:hover { background: var(--cms-accent-hover); }
    .submit:active { background: var(--cms-accent-active); transform: translateY(1px); }
    .submit:focus-visible { outline: 2px solid var(--cms-accent); outline-offset: 2px; }
    .foot {
      margin: 20px 0 0;
      font-size: 13px;
      line-height: 1.6;
      color: var(--cms-text-3);
      text-align: center;
      text-wrap: balance;
    }
    .back {
      display: block;
      margin-top: 20px;
      font-size: 13px;
      font-weight: 500;
      color: var(--cms-text-2);
      text-decoration: none;
      text-align: center;
      text-underline-offset: 3px;
    }
    .back:hover { color: var(--cms-text); text-decoration: underline; }
    .theme-toggle {
      position: fixed;
      top: 16px;
      right: 16px;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-height: 32px;
      padding: 0 12px;
      border: 1px solid var(--cms-border);
      border-radius: 6px;
      background: transparent;
      color: var(--cms-text-2);
      font: inherit;
      font-size: 12px;
      font-weight: 500;
      cursor: pointer;
      transition: border-color 120ms ease, color 120ms ease;
    }
    .theme-toggle:hover { border-color: var(--cms-border-strong); color: var(--cms-text); }
    .theme-toggle:focus-visible { outline: 2px solid var(--cms-accent); outline-offset: 2px; }
    .theme-toggle svg { width: 14px; height: 14px; }
    .theme-toggle .icon-sun { display: none; }
    html[data-theme="light"] .theme-toggle .icon-sun { display: block; }
    html[data-theme="light"] .theme-toggle .icon-moon { display: none; }
    @media (prefers-reduced-motion: reduce) {
      *, *::before { transition: none !important; }
    }
  </style>
</head>
<body>
  <button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label="Aktifkan mode terang" title="Aktifkan mode terang">
    <svg class="icon-moon" aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13.5 9.5A5.5 5.5 0 0 1 6.5 2.5a5.5 5.5 0 1 0 7 7Z"/></svg>
    <svg class="icon-sun" aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="8" cy="8" r="3.2"/><path d="M8 1.5v1.6M8 12.9v1.6M1.5 8h1.6M12.9 8h1.6M3.4 3.4l1.1 1.1M11.5 11.5l1.1 1.1M12.6 3.4l-1.1 1.1M4.5 11.5l-1.1 1.1"/></svg>
    <span data-theme-label>Terang</span>
  </button>
  <main>
    <div class="brand">
      <span class="brand__mark" aria-hidden="true">B</span>
      <span class="brand__name">BSM <span>Editorial</span></span>
    </div>
    <h1>Masuk ke dasbor editorial</h1>
    <p class="sub">Gunakan username dan password owner. Akses GitHub tetap di server dan tidak pernah disimpan di browser.</p>
    <form method="post" action={`/api/auth/pat-login?next=${encodeURIComponent(safeNext)}`}>
      <div class="field">
        <label for="username">Username owner</label>
        <input id="username" name="username" type="text" autocomplete="username" autocapitalize="none" spellcheck="false" required autofocus />
      </div>
      <div class="field">
        <label for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required />
      </div>
      <button class="submit" type="submit">Masuk ke dasbor</button>
    </form>
    <p class="foot">Halaman ini khusus untuk owner situs. Jika Anda tidak memiliki kredensialnya, minta akses kepada owner.</p>
    <a class="back" href="/">← Kembali ke BSM</a>
  </main>
  <script is:inline>
    (function () {
      try {
        var stored = window.localStorage.getItem("bsm-theme");
        var theme = stored === "light" || stored === "dark"
          ? stored
          : "light";
        document.documentElement.dataset.theme = theme;
      } catch {
        document.documentElement.dataset.theme = "light";
      }
    })();
  </script>
  <script is:inline>
    (function () {
      var buttons = Array.from(document.querySelectorAll("[data-theme-toggle]"));
      var root = document.documentElement;
      function applyTheme(theme) {
        root.dataset.theme = theme === "dark" ? "dark" : "light";
        var light = root.dataset.theme === "light";
        buttons.forEach(function (button) {
          button.setAttribute("aria-pressed", String(light));
          button.setAttribute("aria-label", light ? "Aktifkan mode gelap" : "Aktifkan mode terang");
          button.setAttribute("title", light ? "Aktifkan mode gelap" : "Aktifkan mode terang");
          var label = button.querySelector("[data-theme-label]");
          if (label) label.textContent = light ? "Gelap" : "Terang";
        });
        try { window.localStorage.setItem("bsm-theme", root.dataset.theme); } catch (_) {}
      }
      buttons.forEach(function (button) {
        button.addEventListener("click", function () {
          applyTheme(root.dataset.theme === "light" ? "dark" : "light");
        });
      });
      applyTheme(root.dataset.theme === "dark" ? "dark" : "light");
    })();
  </script>
</body>
</html>
