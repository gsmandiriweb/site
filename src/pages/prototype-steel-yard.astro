---
/*
  PROTOTYPE · POV 1 "The Steel Yard" · THROWAWAY
  Wayfinder ticket #11. Not production. Delete or absorb when the prototype
  has answered its question: does a full-bleed yard photo read as "material
  immersion" (you're standing in the yard) rather than "a nice product photo"?

  Self-contained: does NOT import Blueprint Field global.css or Base.astro.
  Run: astro dev -> visit /prototype-steel-yard

  DIRECTION CONTRACT (this prototype only, not a new DESIGN.md)
  THESIS: You're standing in BSM's yard. Full-bleed, ground-level real
    photography surrounds the visitor; the interface recedes behind the
    environment. The page is a place, not a document about stock.
    Refuses the centered hero, the card grid, and the "nice photo" read.
  OWN-WORLD: A LIVING steel yard. An OGL fragment shader renders the yard's
    AIR: drifting volumetric light beams, suspended dust motes, depth — so the
    full-bleed yard photos read as a place you move through, not flat pictures.
    The FOREGROUND belongs to that yard: stock specimens read as material you
    stand among (large, environmental, asymmetric) with cursor-aware warehouse-
    spotlight highlights; ground markers stamped on the concrete; category
    bays as stacked material. A cursor-aware light syncs foreground highlights
    to the shader's beams. Signal-orange reserved for the WhatsApp CTA only.
  STORY: A visitor is dropped into BSM's yard, the air breathes with drifting
    light, stock rises into view as they walk, they feel the scale of a real
    supply operation, and ask for a quote.
  FIRST VIEWPORT: A full-bleed ground-level yard-stock photo fills the screen;
    the atmosphere shader layers drifting light + dust over it; headline
    "Material bangunan. Harga pabrik. Siap kirim." sits over the material with
    a primary WhatsApp CTA. The first viewport is the yard, not a header.
  FORM: Steel Yard (POV 1), one of four locked POVs (ticket #8); a prototype
    variant, not a concept-seed roll. Seed: wayfinder #11.
  FINISH: unreviewed and undocumented is unfinished; this build ends with the
    finish review, the verdict, and DESIGN.md.
*/
import { Image } from "astro:assets";
import { imageAsset } from "../utils/images.ts";
import { categories, brcShowcase } from "../data/catalog.ts";
import { u, waLink } from "../utils/url.ts";

const wa = waLink();
const waBrc = waLink(
  "Halo BSM, saya butuh penawaran lengkap pagar BRC (panel, tiang, pintu, aksesoris). Mohon info harga pabrik, stok, pengiriman. Terima kasih."
);

const heroImg = imageAsset("pagar-brc-tumpukan-stok-gudang-1.jpg");
const yardBreak1 = imageAsset("pagar-brc-tumpukan-stok-gudang-2.jpg");
const yardBreak2 = imageAsset("pagar-brc-terpasang-outdoor-1.jpg");
const yardStock = brcShowcase.items;
const proof = brcShowcase.proof.slice(0, 5);
---
<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>PROTOTYPE · Steel Yard · BSM</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62.5..125,400..800&family=Hanken+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
</head>
<body>
  <!-- The living yard: a fixed full-bleed atmosphere shader behind everything. -->
  <div class="yard-canvas" data-steel-yard aria-hidden="true"></div>
  <div class="yard-fallback" aria-hidden="true"></div>
  <!-- Cursor-light bridge: CSS vars (--mx, --my, --ml) driven by JS so the
       foreground shares the shader's light source. -->
  <div class="cursor-light" aria-hidden="true"></div>

  <!-- NAV · recedes behind the environment -->
  <nav class="nav" aria-label="Navigasi utama">
    <a class="nav__brand" href={u("/")}>BSM</a>
    <div class="nav__links">
      <a href={u("/")}>Beranda</a>
      <a href={u("/katalog")}>Katalog</a>
      <a href={u("/pagar-brc")}>Pagar BRC</a>
    </div>
    <a class="nav__wa" href={wa} target="_blank" rel="noopener">WhatsApp</a>
  </nav>

  <!-- ===================== HERO · you're standing in the yard ===================== -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__photo" data-parallax-layer="-0.12">
      <Image src={heroImg} alt="Tumpukan pagar BRC di gudang BSM Surabaya" width={1600} height={2000} loading="eager" fetchpriority="high" class="hero__img" />
    </div>
    <div class="hero__scrim"></div>
    <div class="hero__content" data-reveal>
      <span class="hero__eyebrow">DISTRIBUTOR MATERIAL · GUDANG SURABAYA</span>
      <h1 class="hero__title" id="hero-title">Material bangunan.<br />Harga pabrik.<br />Siap kirim.</h1>
      <p class="hero__lede">Anda berdiri di gudang CV Bangun Sarana Makmur. Pagar BRC, atap, bondek, dan seluruh kebutuhan proyek konstruksi tertumpuk di sekitar Anda. Langsung dari sini, kirim ke 34 provinsi.</p>
      <div class="hero__actions">
        <a class="cta cta--primary" href={wa} target="_blank" rel="noopener">Minta Penawaran</a>
        <a class="cta cta--ghost" href="#stok">Lihat Stok BRC</a>
      </div>
    </div>
    <div class="hero__scroll" data-reveal><span>gulir · masuk lebih dalam</span> ↓</div>
  </section>

  <!-- ===================== YARD MARKERS · stamped on the ground ===================== -->
  <section class="markers" aria-label="Penanda gudang" data-reveal>
    <div class="markers__cell"><b>34</b><span>Provinsi terjangkau</span></div>
    <div class="markers__cell"><b>6</b><span>Kelompok material</span></div>
    <div class="markers__cell"><b>READY</b><span>Stok gudang</span></div>
    <div class="markers__cell"><b>FREE</b><span>Kirim Surabaya</span></div>
  </section>

  <!-- ===================== WALK THE YARD · full-bleed break 1 ===================== -->
  <section class="yard-break" aria-label="Tumpukan stok di gudang">
    <div class="yard-break__photo" data-parallax-layer="-0.08">
      <Image src={yardBreak1} alt="Tumpukan pagar BRC disiapkan di gudang BSM" width={1600} height={2000} loading="lazy" class="yard-break__img" />
    </div>
    <div class="yard-break__scrim"></div>
    <div class="yard-break__cap" data-reveal>
      <span class="yard-break__no">01 / 03</span>
      <p>Setiap panel dilas titik dan digalvanis sebelum tumpukan ini terbentuk. Stok yang Anda lihat bukan ilustrasi — ini foto gudang hari ini.</p>
    </div>
  </section>

  <!-- ===================== THE STOCK · BRC specimens you stand among ===================== -->
  <section class="stock" id="stok" aria-labelledby="stock-title">
    <header class="stock__head" data-reveal>
      <span class="rail">STOK GUDANG · PAGAR BRC</span>
      <h2 id="stock-title">Apa yang ada di sekitar Anda</h2>
      <p class="stock__sub">Enam unit BRC, masing-masing foto nyata dari gudang. Bukan kartu produk di grid rapi — ini material yang tertumpuk di lantai ini. Arahkan kursor untuk menyorot sebuah unit, lalu minta penawaran per unit.</p>
    </header>

    <div class="stock__yard">
      {yardStock.map((s, i) => (
        <article class={`stock-item stock-item--${i + 1}`} data-mount tabindex="0">
          <div class="stock-item__photo">
            <Image src={imageAsset(s.angles[0])} alt={s.name} width={720} height={720} loading="lazy" class="stock-item__img" />
            <div class="stock-item__spot" aria-hidden="true"></div>
          </div>
          <div class="stock-item__meta">
            <span class="stock-item__no">UNIT {String(i + 1).padStart(2, "0")} · BRC</span>
            <h3 class="stock-item__name">{s.name}</h3>
            <dl class="stock-item__specs">
              {s.specs.map((sp) => (
                <div class="stock-item__spec"><dt>{sp.k}</dt><dd>{sp.v}</dd></div>
              ))}
            </dl>
            <a class="stock-item__wa" href={waLink(s.waContext)} target="_blank" rel="noopener">Minta penawaran unit ini →</a>
          </div>
        </article>
      ))}
    </div>

    <div class="stock__order" data-reveal>
      <a class="cta cta--primary cta--lg" href={waBrc} target="_blank" rel="noopener">Minta penawaran BRC lengkap →</a>
    </div>
  </section>

  <!-- ===================== WALK THE YARD · full-bleed break 2 ===================== -->
  <section class="yard-break" aria-label="Pagar BRC terpasang di proyek">
    <div class="yard-break__photo" data-parallax-layer="-0.08">
      <Image src={yardBreak2} alt="Pagar BRC terpasang di proyek" width={1600} height={2000} loading="lazy" class="yard-break__img" />
    </div>
    <div class="yard-break__scrim"></div>
    <div class="yard-break__cap" data-reveal>
      <span class="yard-break__no">02 / 03</span>
      <p>Dari tumpukan di gudang, material bergerak ke proyek. Foto ini bukan stok — ini pagar BRC yang sudah tiba dan terpasang. Jejak pengiriman nyata.</p>
    </div>
  </section>

  <!-- ===================== THE CATALOG · six families in the yard ===================== -->
  <section class="catalog" id="katalog" aria-labelledby="cat-title">
    <header class="catalog__head" data-reveal>
      <span class="rail">KATALOG · 6 KELOMPOK MATERIAL</span>
      <h2 id="cat-title">Satu gudang, enam kelompok, satu pengiriman</h2>
      <p class="catalog__sub">Bukan spesialis satu lini. BRC adalah pintu masuk; di belakangnya ada atap, dinding, pintu, struktur, dan utilitas. Pesan dari beberapa kelompok sekaligus, kirim dalam satu muatan.</p>
    </header>
    <div class="catalog__grid">
      {categories.map((c, i) => (
        <a class={`cat-tile cat-tile--${i + 1}`} data-mount href={u(`/kategori/${c.slug}`)}>
          <Image src={imageAsset(c.image)} alt={c.name} width={600} height={450} loading="lazy" class="cat-tile__img" />
          <div class="cat-tile__overlay"></div>
          <div class="cat-tile__body">
            <span class="cat-tile__no">RAK {String(i + 1).padStart(2, "0")}</span>
            <b>{c.name}</b>
            <span class="cat-tile__count">{c.count} lini · {c.lines[0]} →</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ===================== WALK THE YARD · full-bleed break 3 (reach proof) ===================== -->
  <section class="yard-break yard-break--proof" aria-label="Bukti jangkauan">
    <div class="reach-strip" data-reveal>
      {proof.map((p, i) => (
        <figure class={`reach-tile reach-tile--${i + 1}`} data-mount>
          <Image src={imageAsset(p.image)} alt={p.caption} width={640} height={480} loading="lazy" class="reach-tile__img" />
          <figcaption class="reach-tile__cap">{p.caption}</figcaption>
        </figure>
      ))}
    </div>
    <div class="yard-break__cap yard-break__cap--reach" data-reveal>
      <span class="yard-break__no">03 / 03</span>
      <p>34 provinsi, dibuktikan dengan foto, bukan peta titik. Setiap bingkai di bawah adalah pagar BRC yang tiba dan terpasang di proyek nyata.</p>
    </div>
  </section>

  <!-- ===================== THE CLOSE · stamped on steel ===================== -->
  <section class="close" id="kontak" aria-labelledby="close-title">
    <div class="close__inner" data-reveal>
      <span class="rail">MEJA PESAN · WHOLESALE</span>
      <h2 id="close-title">Siap bangun? Minta penawaran dari gudang ini.</h2>
      <p class="close__sub">Hubungi tim sales BSM via WhatsApp. Harga pabrik, stok gudang, dan pengiriman ke 34 provinsi dalam satu obrolan. Konsultasi gratis, kirim Surabaya gratis.</p>
      <a class="cta cta--primary cta--lg" href={wa} target="_blank" rel="noopener">WhatsApp: 0812 4934 3303</a>
      <p class="close__addr">Jl. Prapen Indah Gg. 6 Blok C–22, Surabaya · 031 – 99853472 · bsmbangun@yahoo.co.id</p>
    </div>
  </section>

  <footer class="proto-footer">
    <span>PROTOTYPE POV 1 · The Steel Yard · THROWAWAY · wayfinder #11</span>
  </footer>

<script>
  // ---- The living yard: lazy-init the OGL atmosphere shader after first paint. ----
  const yardContainer = document.querySelector<HTMLElement>("[data-steel-yard]");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  let disposeYard: (() => void) | null | undefined = undefined;
  async function maybeStartYard() {
    if (disposeYard !== undefined) return;
    if (!yardContainer || reduceMotion) { disposeYard = null; return; }
    try {
      const { initSteelYardAtmosphere } = await import("../scripts/steelYardAtmosphere.ts");
      disposeYard = initSteelYardAtmosphere(yardContainer);
      if (disposeYard) document.body.classList.add("shader-live");
    } catch { disposeYard = null; }
  }
  window.addEventListener("load", maybeStartYard, { once: true });
  if (document.readyState === "complete") maybeStartYard();

  // ---- Cursor-light bridge: foreground shares the shader's light. ----
  const root = document.documentElement;
  // Seed defaults so cursor-aware shadows render before the first pointermove.
  root.style.setProperty("--mx", "0.5");
  root.style.setProperty("--my", "0.5");
  root.style.setProperty("--ml", "0.5");
  let rafLight = 0, tx = 0.5, ty = 0.5, cx = 0.5, cy = 0.5;
  function onPointer(e: PointerEvent) {
    tx = e.clientX / window.innerWidth;
    ty = 1 - e.clientY / window.innerHeight;
    if (!rafLight) rafLight = requestAnimationFrame(tick);
  }
  function tick() {
    cx += (tx - cx) * 0.1; cy += (ty - cy) * 0.1;
    root.style.setProperty("--mx", cx.toFixed(3));
    root.style.setProperty("--my", cy.toFixed(3));
    root.style.setProperty("--ml", (cx * 0.6 + 0.2).toFixed(3));
    if (Math.abs(tx - cx) > 0.001 || Math.abs(ty - cy) > 0.001) rafLight = requestAnimationFrame(tick);
    else rafLight = 0;
  }
  if (!reduceMotion) window.addEventListener("pointermove", onPointer, { passive: true });

  // ---- GSAP motion orchestration ----
  (async () => {
    if (reduceMotion) return;
    const gsap = (await import("gsap")).default;
    const { ScrollTrigger } = await import("gsap/ScrollTrigger");
    gsap.registerPlugin(ScrollTrigger);
    if (document.fonts?.ready) await document.fonts.ready;

    // Hero entrance.
    const heroReveals = gsap.utils.toArray<HTMLElement>(".hero [data-reveal]");
    gsap.set(heroReveals, { autoAlpha: 0, y: 30 });
    gsap.to(heroReveals, { autoAlpha: 1, y: 0, duration: 1.0, ease: "power3.out", stagger: 0.12, delay: 0.2 });

    // Stock rises into view as you walk past (material you stand among).
    const mounts = gsap.utils.toArray<HTMLElement>("[data-mount]");
    mounts.forEach((el) => {
      gsap.set(el, { autoAlpha: 0, y: 60, scale: 0.95 });
      ScrollTrigger.create({
        trigger: el, start: "top 90%", once: true,
        onEnter: () => gsap.to(el, { autoAlpha: 1, y: 0, scale: 1, duration: 0.9, ease: "power2.out" }),
      });
    });

    // Section heads + reveals.
    const heads = gsap.utils.toArray<HTMLElement>("[data-reveal]:not(.hero [data-reveal]):not([data-mount])");
    heads.forEach((el) => {
      gsap.set(el, { autoAlpha: 0, y: 26 });
      ScrollTrigger.create({ trigger: el, start: "top 86%", once: true, onEnter: () => gsap.to(el, { autoAlpha: 1, y: 0, duration: 0.9, ease: "power2.out" }) });
    });

    // Parallax: full-bleed photos + layers drift at different rates (depth).
    gsap.utils.toArray<HTMLElement>("[data-parallax-layer]").forEach((el) => {
      const amt = parseFloat(el.dataset.parallaxLayer || "0") * 100;
      gsap.to(el, { y: () => amt, ease: "none", scrollTrigger: { trigger: el, start: "top bottom", end: "bottom top", scrub: true } });
    });

    ScrollTrigger.refresh();
  })();
</script>

<style>
  :root {
    --yard-dark: #14161a; --yard-darker: #0c0d10; --yard-mid: #1d2025;
    --yard-steel: #828a93; --yard-light: #f5f5f4;
    --yard-accent: #e8551e; --yard-accent-deep: #c8430f; --yard-accent-darker: #a8360b;
    --beam: #c9b48a;
    --fd: "Archivo","Arial Narrow",sans-serif; --fb: "Hanken Grotesk",system-ui,sans-serif;
    --fm: "JetBrains Mono",ui-monospace,monospace;
    --mx: 0.5; --my: 0.5; --ml: 0.5;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body {
    background: var(--yard-darker); color: var(--yard-light);
    font-family: var(--fb); font-size: 1.0625rem; line-height: 1.6;
    -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility;
    overflow-x: hidden;
  }
  img { display: block; max-width: 100%; } a { color: inherit; text-decoration: none; }
  :focus-visible { outline: 2px solid var(--beam); outline-offset: 3px; }
  .rail { font-family: var(--fm); font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--yard-accent); }

  /* ---- The living yard: fixed full-bleed atmosphere shader ---- */
  .yard-canvas { position: fixed; inset: 0; z-index: 0; pointer-events: none; }
  .yard-canvas canvas { display: block; width: 100%; height: 100%; }
  .yard-fallback { position: fixed; inset: 0; z-index: 0; pointer-events: none; background: radial-gradient(ellipse at 50% 30%, var(--yard-dark), var(--yard-darker) 70%); transition: opacity 0.6s; }
  body.shader-live .yard-fallback { opacity: 0; }
  .cursor-light { position: fixed; inset: 0; z-index: 0; pointer-events: none; background: radial-gradient(700px circle at calc(var(--mx) * 100vw) calc((1 - var(--my)) * 100vh), rgba(201,180,138,0.08), transparent 60%); }

  /* Sections sit above the fixed yard. */
  .hero, .markers, .yard-break, .stock, .catalog, .close { position: relative; z-index: 1; }

  /* ---- NAV ---- */
  .nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    display: flex; align-items: center; justify-content: space-between;
    padding: 0.85rem clamp(1rem, 4vw, 3rem);
    background: rgba(12, 13, 16, 0.7); backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(130, 138, 147, 0.18);
  }
  .nav__brand { font-family: var(--fd); font-weight: 800; font-stretch: 125%; font-size: 1.4rem; letter-spacing: -0.02em; }
  .nav__links { display: flex; gap: 1.6rem; }
  .nav__links a { font-family: var(--fm); font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--yard-steel); position: relative; transition: color 0.2s; }
  .nav__links a::after { content: ""; position: absolute; left: 0; bottom: -4px; width: 100%; height: 1px; background: var(--beam); transform: scaleX(0); transform-origin: left; transition: transform 0.25s ease; }
  .nav__links a:hover { color: var(--yard-light); }
  .nav__links a:hover::after { transform: scaleX(1); }
  .nav__wa { font-family: var(--fm); font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; background: var(--yard-accent-deep); color: #fff; padding: 0.55rem 1.1rem; border-radius: 3px; font-weight: 600; transition: background 0.2s, transform 0.2s; }
  .nav__wa:hover { background: var(--yard-accent-darker); transform: translateY(-1px); }
  @media (max-width: 640px) { .nav__links { display: none; } }

  /* ---- CTAs ---- */
  .cta { display: inline-flex; align-items: center; font-family: var(--fm); font-size: 0.8rem; letter-spacing: 0.12em; text-transform: uppercase; font-weight: 600; padding: 14px 30px; border-radius: 3px; transition: background 0.2s, border-color 0.2s, transform 0.2s, box-shadow 0.2s; }
  .cta--primary { background: var(--yard-accent-deep); color: #fff; box-shadow: 0 6px 16px -8px rgba(0,0,0,0.6); }
  .cta--primary:hover { background: var(--yard-accent-darker); transform: translateY(-2px); box-shadow: 0 10px 22px -8px rgba(0,0,0,0.65); }
  .cta--ghost { background: transparent; color: var(--yard-light); border: 1px solid var(--yard-steel); }
  .cta--ghost:hover { border-color: var(--yard-light); background: rgba(255,255,255,0.04); }
  .cta--lg { font-size: 0.9rem; padding: 18px 38px; }

  /* ===================== HERO ===================== */
  .hero { position: relative; min-height: 100vh; display: flex; align-items: flex-end; overflow: hidden; }
  .hero__photo { position: absolute; inset: -8% 0; will-change: transform; }
  .hero__img { width: 100%; height: 100%; object-fit: cover; }
  .hero__scrim { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(12,13,16,0.5) 0%, rgba(12,13,16,0.15) 35%, rgba(12,13,16,0.92) 100%), linear-gradient(90deg, rgba(12,13,16,0.5) 0%, transparent 60%); }
  .hero__content { position: relative; z-index: 2; padding: 0 clamp(1rem, 5vw, 4rem) clamp(4rem, 8vh, 6rem); max-width: 40rem; }
  .hero__eyebrow { font-family: var(--fm); font-size: 0.72rem; letter-spacing: 0.16em; color: var(--yard-accent); display: block; margin-bottom: 1.1rem; }
  .hero__title { font-family: var(--fd); font-weight: 800; font-stretch: 125%; font-size: clamp(2.6rem, 7vw, 5.2rem); line-height: 0.94; letter-spacing: -0.02em; margin-bottom: 1.5rem; text-wrap: balance; }
  .hero__lede { font-size: 1.12rem; color: rgba(245,245,244,0.88); max-width: 48ch; margin-bottom: 2rem; }
  .hero__actions { display: flex; gap: 1rem; flex-wrap: wrap; }
  .hero__scroll { position: absolute; bottom: 1.5rem; right: clamp(1rem, 5vw, 4rem); z-index: 2; font-family: var(--fm); font-size: 0.68rem; letter-spacing: 0.1em; color: var(--yard-steel); display: flex; flex-direction: column; align-items: flex-end; gap: 0.3rem; }

  /* ===================== YARD MARKERS · stamped on the ground ===================== */
  .markers { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: rgba(130,138,147,0.16); }
  .markers__cell { background: rgba(20, 22, 26, 0.86); backdrop-filter: blur(4px); padding: clamp(1.6rem, 4vw, 2.4rem) 1.5rem; }
  .markers__cell b { display: block; font-family: var(--fd); font-weight: 800; font-stretch: 125%; font-size: clamp(1.8rem, 4vw, 2.6rem); line-height: 1; margin-bottom: 0.4rem; color: var(--yard-light); }
  .markers__cell span { font-family: var(--fm); font-size: 0.66rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--yard-steel); }
  @media (max-width: 640px) { .markers { grid-template-columns: repeat(2, 1fr); } }

  /* ===================== WALK THE YARD · full-bleed breaks ===================== */
  .yard-break { position: relative; height: 75vh; min-height: 480px; overflow: hidden; display: flex; align-items: flex-end; }
  .yard-break__photo { position: absolute; inset: -8% 0; will-change: transform; }
  .yard-break__img { width: 100%; height: 100%; object-fit: cover; }
  .yard-break__scrim { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(12,13,16,0.2) 0%, transparent 40%, rgba(12,13,16,0.9) 100%); }
