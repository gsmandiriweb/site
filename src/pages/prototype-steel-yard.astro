---
/*
  PROTOTYPE · POV 1 "The Steel Yard" · THROWAWAY
  Wayfinder ticket #14. Not production. Delete or absorb when the prototype
  has answered its question: can a focused product rail make real BRC stock
  feel orderly, inspectable, and more polished than a dense product grid?

  Self-contained: does NOT import Blueprint Field global.css or Base.astro.
  Run: astro dev -> visit /prototype-steel-yard

  DIRECTION CONTRACT (this prototype only, not a new DESIGN.md)
  THESIS: A real BRC panel is the first thing the visitor can inspect. The
    product plate carries material truth; controlled dark yard atmosphere gives
    it weight without competing with it. Refuses the generic full-bleed stock
    photo, decorative hero machinery, and the "nice photo" read.
  OWN-WORLD: A quiet, high-contrast steel yard: deep charcoal ground, warm
    galvanized edge light, one authored product plate, direct specs, and a
    single orange WhatsApp action. Motion is a restrained enhancement, never
    the proof and never a prerequisite for understanding.
  STORY: A buyer immediately sees what BSM supplies, understands the exact BRC
    panel being shown, can verify its known specs, and can request a quote or
    continue into the full catalog without hunting.
  FIRST VIEWPORT: The left column carries the headline, useful context, and
    two clear actions. The right column carries a sharply framed real BRC panel
    with product name and confirmed specs. The mobile layout preserves that
    order and remains complete without WebGL or hover.
  FORM: Steel Yard (POV 1), one of four locked POVs (ticket #8); a prototype
    variant, not a concept-seed roll.  Seed: wayfinder #14.

  FINISH: unreviewed and undocumented is unfinished; this build ends with the
    finish review, the verdict, and DESIGN.md.
*/
import { Image } from "astro:assets";
import { imageAsset } from "../utils/images.ts";
import { categories, brcShowcase } from "../data/catalog.ts";
import { quoteLink, u } from "../utils/url.ts";

const quote = quoteLink();
const quoteBrc = quoteLink({ category: "pagar", product: "Pagar BRC" });

const heroProduct = brcShowcase.items[0];
const heroSecondary = brcShowcase.items[1];
const yardBreak1 = imageAsset("pagar-brc-tumpukan-stok-gudang-2.jpg");
const yardBreak2 = imageAsset("pagar-brc-terpasang-outdoor-1.jpg");
const yardStock = brcShowcase.items;
const proof = brcShowcase.proof.slice(0, 5);
---
<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>PROTOTYPE · Steel Yard · BSM</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62.5..125,400..800&family=Hanken+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
  <script is:inline>
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      document.documentElement.classList.add("hero-motion-ready");
      window.setTimeout(() => document.documentElement.classList.remove("hero-motion-ready"), 2800);
    }
  </script>
</head>
<body>
  <!-- NAV · quiet enough to let the product lead -->
  <nav class="nav" aria-label="Navigasi utama">
    <a class="nav__brand" href={u("/")}>BSM</a>
    <div class="nav__links">
      <a href={u("/")}>Beranda</a>
      <a href={u("/katalog")}>Katalog</a>
      <a href={u("/pagar-brc")}>Pagar BRC</a>
    </div>
    <a class="nav__wa" href={quote}>Minta Penawaran</a>
  </nav>

  <!-- ===================== HERO · one product, one action ===================== -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__ambient" data-hero-shader aria-hidden="true"></div>
    <div class="hero__grid">
      <div class="hero__content" data-reveal>
        <span class="hero__eyebrow">PAGAR BRC &amp; MATERIAL KONSTRUKSI</span>
        <h1 class="hero__title" id="hero-title">
          <span class="hero__title-mask"><span class="hero__title-line" data-line>Mulai dari spesifikasi.</span></span>
          <span class="hero__title-mask"><span class="hero__title-line hero__title-line--accent" data-line>Berangkat ke proyek.</span></span>
        </h1>
        <p class="hero__lede">BSM memasok pagar BRC, atap, bondek, dan material konstruksi dari Surabaya. Periksa spesifikasi produk, lalu sampaikan kebutuhan, volume, dan lokasi proyek untuk mendapatkan penawaran harga pabrik dengan pengiriman ke seluruh Indonesia.</p>
        <div class="hero__actions">
          <a class="cta cta--primary" href={quote}>Minta Penawaran</a>
          <a class="cta cta--ghost" href={u("/katalog")}>Telusuri Katalog</a>
        </div>
        <div class="hero__proof" aria-label="Informasi pengadaan BSM">
          <div><b>34</b><span>provinsi pengiriman</span></div>
          <div><b>6</b><span>kelompok material</span></div>
          <div><b>SBY</b><span>basis distribusi</span></div>
        </div>
      </div>

      <div class="hero__plate-stack">
        <figure class="hero__plate-rear" aria-hidden="true">
          <div class="hero__plate-rear-image">
            <Image src={imageAsset(heroSecondary.angles[0])} alt="" width={900} height={1600} loading="lazy" decoding="async" class="hero__plate-rear-img" />
            <span class="hero__plate-mark">BRC / 02</span>
          </div>
        </figure>
        <a class="hero__plate-link" href={u("/pagar-brc")} aria-label="Lihat detail Pagar BRC Panel">
          <figure class="hero__plate" data-reveal>
            <div class="hero__plate-image">
              <Image src={imageAsset(heroProduct.angles[0])} alt="Pagar BRC Panel, tampak perspektif" width={900} height={1600} loading="eager" fetchpriority="high" decoding="async" class="hero__plate-img" />
              <span class="hero__plate-mark">BRC / 01</span>
            </div>
            <figcaption class="hero__plate-caption">
              <span class="hero__plate-label">PAGAR BRC PANEL · PRODUK UNGGULAN</span>
              <b>{heroProduct.name}</b>
              <span>Foto produk nyata · didistribusikan dari Surabaya</span>
            </figcaption>
            <dl class="hero__plate-specs">
              {heroProduct.specs.slice(0, 4).map((spec) => (
                <div><dt>{spec.k}</dt><dd>{spec.v}</dd></div>
              ))}
            </dl>
          </figure>
        </a>
      </div>
    </div>
    <div class="hero__scroll" data-reveal><span>gulir · lihat material lain</span> ↓</div>
  </section>

  <!-- ===================== WALK THE YARD · full-bleed break 1 ===================== -->
  <section class="yard-break" aria-label="Tumpukan stok di gudang">
    <div class="yard-break__photo" data-parallax-layer="-0.08">
      <Image src={yardBreak1} alt="Tumpukan pagar BRC disiapkan di gudang BSM" width={1600} height={2000} loading="lazy" class="yard-break__img" />
    </div>
    <div class="yard-break__scrim"></div>
    <div class="yard-break__cap" data-reveal>
      <span class="yard-break__no">01 / 03</span>
      <p>Periksa melalui foto dan spesifikasi: pagar BRC dengan dimensi, diameter kawat, mesh, finishing, dan asal yang tercatat. Bukti produk, bukan ilustrasi katalog.</p>
    </div>
  </section>

  <!-- ===================== THE STOCK · BRC specimens you stand among ===================== -->
  <section class="stock" id="stok" aria-labelledby="stock-title">
    <header class="stock__head" data-reveal>
      <span class="rail">SPESIFIKASI PRODUK · PAGAR BRC</span>
      <h2 id="stock-title">Pilih produk BRC sesuai kebutuhan proyek</h2>
      <p class="stock__sub">Enam lini BRC dengan foto produk dan spesifikasi yang tersedia. Bandingkan dimensi, diameter kawat, mesh, dan finishing; lalu minta penawaran per unit.</p>
      <div class="rail-controls" aria-label="Navigasi stok BRC">
        <button class="rail-control" type="button" data-carousel-dir="prev" data-carousel-target="stock" aria-label="Produk BRC sebelumnya">←</button>
        <span class="rail-progress label" data-carousel-progress="stock" aria-live="polite">01 / 06</span>
        <button class="rail-control" type="button" data-carousel-dir="next" data-carousel-target="stock" aria-label="Produk BRC berikutnya">→</button>
      </div>
    </header>

    <div class="stock__yard" data-carousel-track="stock" role="region" aria-roledescription="carousel" aria-label="Produk BRC dari stok gudang" tabindex="0">
      {yardStock.map((s, i) => (
        <article class={`stock-item carousel__slide`} role="group" aria-label={`Produk ${i + 1} dari ${yardStock.length}`} data-mount>
          <div class="stock-item__photo">
            <Image src={imageAsset(s.angles[0])} alt={s.name} width={720} height={720} loading="lazy" class="stock-item__img" />
            <div class="stock-item__spot" aria-hidden="true"></div>
          </div>
          <div class="stock-item__meta">
            <span class="stock-item__no">UNIT {String(i + 1).padStart(2, "0")} · BRC</span>
            <h3 class="stock-item__name">{s.name}</h3>
            <dl class="stock-item__specs">
              {s.specs.map((sp) => (
                <div class="stock-item__spec"><dt>{sp.k}</dt><dd>{sp.v}</dd></div>
              ))}
            </dl>
            <a class="stock-item__wa" href={quoteLink({ category: "pagar", product: s.name === "Pagar BRC Panel" ? "Pagar BRC" : s.name, notes: `Konteks produk: ${s.name}` })}>Susun permintaan unit ini →</a>
          </div>
        </article>
      ))}
    </div>

    <div class="stock__order" data-reveal>
      <a class="cta cta--primary cta--lg" href={quoteBrc}>Susun permintaan BRC lengkap →</a>
    </div>
  </section>

  <!-- ===================== WALK THE YARD · full-bleed break 2 ===================== -->
  <section class="yard-break" aria-label="Pagar BRC terpasang di proyek">
    <div class="yard-break__photo" data-parallax-layer="-0.08">
      <Image src={yardBreak2} alt="Pagar BRC terpasang di proyek" width={1600} height={2000} loading="lazy" class="yard-break__img" />
    </div>
    <div class="yard-break__scrim"></div>
    <div class="yard-break__cap" data-reveal>
      <span class="yard-break__no">02 / 03</span>
      <p>Dari basis distribusi di Surabaya ke lapangan: dokumentasi pagar BRC yang telah digunakan dan terpasang di proyek.</p>
    </div>
  </section>

  <!-- ===================== THE CATALOG · six families in the yard ===================== -->
  <section class="catalog" id="katalog" aria-labelledby="cat-title">
    <header class="catalog__head" data-reveal>
      <span class="rail">KATALOG · 6 KELOMPOK MATERIAL</span>
      <h2 id="cat-title">Satu sumber untuk material proyek</h2>
      <p class="catalog__sub">BSM menyediakan enam kelompok material konstruksi dari basis Surabaya. Mulai dari pagar BRC, lalu telusuri atap, dinding, pintu, struktur, dan utilitas untuk kebutuhan pengadaan Anda.</p>
      <div class="rail-controls" aria-label="Navigasi kelompok material">
        <button class="rail-control" type="button" data-carousel-dir="prev" data-carousel-target="categories" aria-label="Kelompok material sebelumnya">←</button>
        <span class="rail-progress label" data-carousel-progress="categories" aria-live="polite">01 / 06</span>
        <button class="rail-control" type="button" data-carousel-dir="next" data-carousel-target="categories" aria-label="Kelompok material berikutnya">→</button>
      </div>
    </header>
    <div class="catalog__grid" data-carousel-track="categories" role="region" aria-roledescription="carousel" aria-label="Enam kelompok material BSM" tabindex="0">
      {categories.map((c, i) => (
        <a class="cat-tile carousel__slide" aria-label={`${c.name} · kelompok ${i + 1} dari ${categories.length}`} data-mount href={u(`/kategori/${c.slug}`)}>
          <Image src={imageAsset(c.image)} alt={c.name} width={600} height={450} loading="lazy" class="cat-tile__img" />
          <div class="cat-tile__overlay"></div>
          <div class="cat-tile__body">
            <span class="cat-tile__no">RAK {String(i + 1).padStart(2, "0")}</span>
            <b>{c.name}</b>
            <span class="cat-tile__count">{c.count} lini · {c.lines[0]} →</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ===================== WALK THE YARD · full-bleed break 3 (reach proof) ===================== -->
  <section class="yard-break yard-break--proof" aria-label="Bukti jangkauan">
    <div class="reach-strip" data-reveal>
      {proof.map((p, i) => (
        <figure class={`reach-tile reach-tile--${i + 1}`} data-mount>
          <Image src={imageAsset(p.image)} alt={p.caption} width={640} height={480} loading="lazy" class="reach-tile__img" />
          <figcaption class="reach-tile__cap">{p.caption}</figcaption>
        </figure>
      ))}
    </div>
    <div class="yard-break__cap yard-break__cap--reach" data-reveal>
      <span class="yard-break__no">03 / 03</span>
      <p>Pengiriman dari Surabaya ke 34 provinsi, dengan dokumentasi lapangan sebagai bukti penggunaan pagar BRC di proyek nyata.</p>
    </div>
  </section>

  <!-- ===================== THE CLOSE · stamped on steel ===================== -->
  <section class="close" id="kontak" aria-labelledby="close-title">
    <div class="close__inner" data-reveal>
      <span class="rail">MEJA PESAN · WHOLESALE</span>
      <h2 id="close-title">Sampaikan kebutuhan proyek Anda.</h2>
      <p class="close__sub">Kirim kategori material, spesifikasi, jumlah, dan lokasi proyek melalui WhatsApp. Tim BSM akan menyiapkan informasi harga pabrik, ketersediaan, dan pengiriman. Konsultasi gratis; pengiriman Surabaya gratis.</p>
      <a class="cta cta--primary cta--lg" href={quote}>Susun permintaan penawaran →</a>
      <p class="close__addr">Jl. Prapen Indah Gg. 6 Blok C–22, Surabaya · 031 – 99853472 · bsmbangun@yahoo.co.id</p>
    </div>
  </section>

  <footer class="proto-footer">
    <span>PROTOTYPE POV 1 · The Steel Yard · THROWAWAY · wayfinder #14</span>
  </footer>

<script>
  // Motion is enhancement only: the hero remains fully visible without JS.
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // The hero shader is atmosphere only. CSS remains the visual floor if WebGL
  // is unavailable, reduced motion is enabled, or the lazy enhancement fails.
  const heroShaderContainer = document.querySelector<HTMLElement>("[data-hero-shader]");
  let disposeHeroShader: (() => void) | null = null;
  let cancelHeroShaderStart = () => {};
  if (heroShaderContainer && !reduceMotion) {
    let leavingPage = false;
    const startHeroShader = async () => {
      if (leavingPage) return;
      try {
        const { initSteelYardHeroShader } = await import("../scripts/steelYardHeroShader.ts");
        if (!leavingPage) disposeHeroShader = initSteelYardHeroShader(heroShaderContainer);
      } catch {
        // The CSS gradient is intentionally a complete fallback.
      }
    };
    const ric = (window as any).requestIdleCallback as
      | ((callback: () => void, options?: { timeout: number }) => number)
      | undefined;
    const cancelRic = (window as any).cancelIdleCallback as ((id: number) => void) | undefined;
    if (typeof ric === "function") {
      const idleId = ric(startHeroShader, { timeout: 1600 });
      cancelHeroShaderStart = () => cancelRic?.(idleId);
    } else {
      window.addEventListener("load", startHeroShader, { once: true });
      cancelHeroShaderStart = () => {
        leavingPage = true;
        window.removeEventListener("load", startHeroShader);
      };
    }
    const markLeaving = () => { leavingPage = true; };
    window.addEventListener("pagehide", markLeaving, { once: true });
  }

  // The lower stock/catalog surfaces use a restrained shared spotlight. Keep
  // that interaction lightweight; the hero itself does not depend on it.
  const root = document.documentElement;
  root.style.setProperty("--mx", "0.5");
  root.style.setProperty("--my", "0.5");
  root.style.setProperty("--ml", "0.5");
  let pointerRaf = 0;
  let targetX = 0.5;
  let targetY = 0.5;
  let currentX = 0.5;
  let currentY = 0.5;
  function updatePointer(e: PointerEvent) {
    targetX = e.clientX / window.innerWidth;
    targetY = 1 - e.clientY / window.innerHeight;
    if (!pointerRaf) pointerRaf = requestAnimationFrame(tickPointer);
  }
  function tickPointer() {
    currentX += (targetX - currentX) * 0.12;
    currentY += (targetY - currentY) * 0.12;
    root.style.setProperty("--mx", currentX.toFixed(3));
    root.style.setProperty("--my", currentY.toFixed(3));
    root.style.setProperty("--ml", (currentX * 0.6 + 0.2).toFixed(3));
    if (Math.abs(targetX - currentX) > 0.001 || Math.abs(targetY - currentY) > 0.001) {
      pointerRaf = requestAnimationFrame(tickPointer);
    } else {
      pointerRaf = 0;
    }
  }
  if (!reduceMotion) window.addEventListener("pointermove", updatePointer, { passive: true });
  window.addEventListener("pagehide", () => {
    if (pointerRaf) cancelAnimationFrame(pointerRaf);
    cancelHeroShaderStart();
    disposeHeroShader?.();
  }, { once: true });

  // ---- Native carousel enhancement ----
  // CSS Scroll Snap is the floor: touch, trackpad, keyboard focus, and a plain
  // horizontal list all work without JavaScript. This small layer only adds
  // explicit previous/next controls and progress feedback.
  const carouselTracks = Array.from(document.querySelectorAll<HTMLElement>("[data-carousel-track]"));
  let initializedCarousels = 0;
  carouselTracks.forEach((track) => {
    const name = track.dataset.carouselTrack;
    if (!name) return;
    const slides = Array.from(track.querySelectorAll<HTMLElement>(".carousel__slide"));
    const prev = document.querySelector<HTMLButtonElement>(`[data-carousel-dir="prev"][data-carousel-target="${name}"]`);
    const next = document.querySelector<HTMLButtonElement>(`[data-carousel-dir="next"][data-carousel-target="${name}"]`);
    const progress = document.querySelector<HTMLElement>(`[data-carousel-progress="${name}"]`);
    if (!slides.length) return;

    let active = 0;
    const reduceCarouselMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const setActive = (index: number) => {
      active = Math.max(0, Math.min(index, slides.length - 1));
      slides.forEach((slide, i) => slide.setAttribute("aria-current", i === active ? "true" : "false"));
      if (progress) progress.textContent = `${String(active + 1).padStart(2, "0")} / ${String(slides.length).padStart(2, "0")}`;
      if (prev) prev.disabled = active === 0;
      if (next) next.disabled = active === slides.length - 1;
    };
    const goTo = (index: number) => {
      const target = Math.max(0, Math.min(index, slides.length - 1));
      track.scrollTo({ left: slides[target].offsetLeft, behavior: reduceCarouselMotion ? "auto" : "smooth" });
      setActive(target);
    };
    const syncActive = () => {
      const nearest = slides.reduce((best, slide, i) => {
        const distance = Math.abs(slide.offsetLeft - track.scrollLeft);
        return distance < best.distance ? { index: i, distance } : best;
      }, { index: 0, distance: Number.POSITIVE_INFINITY });
      setActive(nearest.index);
    };

    prev?.addEventListener("click", () => goTo(active - 1));
    next?.addEventListener("click", () => goTo(active + 1));
    track.addEventListener("scroll", syncActive, { passive: true });
    track.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") { event.preventDefault(); goTo(active - 1); }
      if (event.key === "ArrowRight") { event.preventDefault(); goTo(active + 1); }
    });
    setActive(0);
    initializedCarousels += 1;
    if (initializedCarousels === carouselTracks.length) {
      document.documentElement.classList.add("carousel-enhanced");
    }
  });

  // ---- GSAP motion orchestration ----
  (async () => {
    if (reduceMotion) return;
    const gsap = (await import("gsap")).default;
    const { ScrollTrigger } = await import("gsap/ScrollTrigger");
    gsap.registerPlugin(ScrollTrigger);
    if (document.fonts?.ready) await document.fonts.ready;

    // Hero entrance: the product plate and headline assemble in with a
    // restrained rise. The head-level class is the only initial hide, so a
    // successful animation cannot flash content invisible after first paint;
    // its timeout restores the CSS floor if this enhancement fails. If the
    // fallback already took over while imports were loading, leave the content
    // visible instead of re-hiding it here.
    if (document.documentElement.classList.contains("hero-motion-ready")) {
      const heroReveals = gsap.utils.toArray<HTMLElement>(".hero [data-reveal]");
      gsap.set(heroReveals, { autoAlpha: 0, y: 30 });
      document.documentElement.classList.remove("hero-motion-ready");
      gsap.to(heroReveals, { autoAlpha: 1, y: 0, duration: 1.0, ease: "power3.out", stagger: 0.12, delay: 0.2 });
    }

    // Stock rises into view as you walk past (material you stand among).
    const mounts = gsap.utils.toArray<HTMLElement>("[data-mount]");
    mounts.forEach((el) => {
      gsap.set(el, { autoAlpha: 0, y: 60, scale: 0.95 });
      ScrollTrigger.create({
        trigger: el, start: "top 90%", once: true,
        onEnter: () => gsap.to(el, { autoAlpha: 1, y: 0, scale: 1, duration: 0.9, ease: "power2.out" }),
      });
    });

    // Section heads + reveals.
    const heads = gsap.utils.toArray<HTMLElement>("[data-reveal]:not(.hero [data-reveal]):not([data-mount])");
    heads.forEach((el) => {
      gsap.set(el, { autoAlpha: 0, y: 26 });
      ScrollTrigger.create({ trigger: el, start: "top 86%", once: true, onEnter: () => gsap.to(el, { autoAlpha: 1, y: 0, duration: 0.9, ease: "power2.out" }) });
    });

    // Parallax: full-bleed photos + layers drift at different rates (depth).
    gsap.utils.toArray<HTMLElement>("[data-parallax-layer]").forEach((el) => {
      const amt = parseFloat(el.dataset.parallaxLayer || "0") * 100;
      gsap.to(el, { y: () => amt, ease: "none", scrollTrigger: { trigger: el, start: "top bottom", end: "bottom top", scrub: true } });
    });

    ScrollTrigger.refresh();
  })();
</script>

<style>
  :root {
    --yard-dark: #14161a; --yard-darker: #0c0d10; --yard-mid: #1d2025;
    --yard-steel: #828a93; --yard-light: #f5f5f4;
    --yard-accent: #e8551e; --yard-accent-deep: #c8430f; --yard-accent-darker: #a8360b;
    --beam: #c9b48a;
    --fd: "Archivo","Arial Narrow",sans-serif; --fb: "Hanken Grotesk",system-ui,sans-serif;
    --fm: "JetBrains Mono",ui-monospace,monospace;
    --mx: 0.5; --my: 0.5; --ml: 0.5;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body {
    background: var(--yard-darker); color: var(--yard-light);
    font-family: var(--fb); font-size: 1.0625rem; line-height: 1.6;
    -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility;
    overflow-x: hidden;
  }
  img { display: block; max-width: 100%; } a { color: inherit; text-decoration: none; }
  :focus-visible { outline: 2px solid var(--beam); outline-offset: 3px; }
  .rail { font-family: var(--fm); font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--yard-accent); }

  /* ---- NAV ---- */
  .nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    display: flex; align-items: center; justify-content: space-between;
    padding: 0.85rem clamp(1rem, 4vw, 3rem);
    background: rgba(12, 13, 16, 0.84); backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(130, 138, 147, 0.18);
  }
  .nav__brand { font-family: var(--fd); font-weight: 800; font-stretch: 125%; font-size: 1.4rem; letter-spacing: -0.02em; }
  .nav__links { display: flex; gap: 1.6rem; }
  .nav__links a { font-family: var(--fm); font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--yard-steel); position: relative; transition: color 0.2s; }
  .nav__links a::after { content: ""; position: absolute; left: 0; bottom: -4px; width: 100%; height: 1px; background: var(--beam); transform: scaleX(0); transform-origin: left; transition: transform 0.25s ease; }
  .nav__links a:hover { color: var(--yard-light); }
  .nav__links a:hover::after { transform: scaleX(1); }
  .nav__wa { font-family: var(--fm); font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; background: var(--yard-accent-deep); color: #fff; padding: 0.55rem 1.1rem; border-radius: 3px; font-weight: 600; transition: background 0.2s, transform 0.2s; }
  .nav__wa:hover { background: var(--yard-accent-darker); transform: translateY(-1px); }
  @media (max-width: 640px) { .nav__links { display: none; } }

  /* ---- CTAs ---- */
  .cta { display: inline-flex; align-items: center; font-family: var(--fm); font-size: 0.8rem; letter-spacing: 0.12em; text-transform: uppercase; font-weight: 600; padding: 14px 30px; border-radius: 3px; transition: background 0.2s, border-color 0.2s, transform 0.2s, box-shadow 0.2s; }
  .cta--primary { background: var(--yard-accent-deep); color: #fff; box-shadow: 0 6px 16px -8px rgba(0,0,0,0.6); }
  .cta--primary:hover { background: var(--yard-accent-darker); transform: translateY(-2px); box-shadow: 0 10px 22px -8px rgba(0,0,0,0.65); }
  .cta--ghost { background: transparent; color: var(--yard-light); border: 1px solid var(--yard-steel); }
  .cta--ghost:hover { border-color: var(--yard-light); background: rgba(255,255,255,0.04); }
  .cta--lg { font-size: 0.9rem; padding: 18px 38px; }

  /* ===================== HERO · one product, one action ===================== */
  .hero { position: relative; min-height: min(900px, 100svh); display: flex; align-items: center; overflow: hidden; padding: 7rem clamp(1rem, 5vw, 4rem) 4rem; background: var(--yard-darker); }
  .hero__ambient { position: absolute; inset: 0; pointer-events: none; overflow: hidden; background: radial-gradient(70% 90% at 78% 50%, rgba(201,180,138,0.14), transparent 52%), linear-gradient(112deg, #0c0d10 0%, #111419 48%, #1a1c20 100%); }
  /* Static pattern layer: diagonal machined hatching gives the dark field a
     steel-sheet texture without introducing another moving focal point. */
  .hero__ambient::before { content: ""; position: absolute; inset: -20%; z-index: 1; opacity: 0.34; background: repeating-linear-gradient(135deg, rgba(201,180,138,0.08) 0 1px, transparent 1px 13px); mask-image: linear-gradient(115deg, black 0 22%, transparent 54%); transform: rotate(-3deg); }
  /* Existing drafting grid, now paired with sparse registration dots on the
     open side of the hero. The mask keeps both patterns away from the copy. */
  .hero__ambient::after { content: ""; position: absolute; inset: 0; z-index: 1; opacity: 0.14; background-image: radial-gradient(circle at 1px 1px, rgba(201,180,138,0.5) 0 1px, transparent 1.5px), linear-gradient(90deg, rgba(130,138,147,0.24) 1px, transparent 1px), linear-gradient(rgba(130,138,147,0.18) 1px, transparent 1px); background-size: clamp(72px, 9vw, 120px) clamp(72px, 9vw, 120px); mask-image: linear-gradient(90deg, transparent 18%, black 52%, black 78%, transparent 100%); }
  .hero__ambient canvas { position: relative; z-index: 0; opacity: 0.54; mix-blend-mode: screen; }
  @media (max-width: 860px) { .hero__ambient::before { opacity: 0.2; } .hero__ambient::after { opacity: 0.1; } }
  @media (prefers-reduced-motion: reduce) { .hero__ambient canvas { display: none; } }
  .hero__grid { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 0.92fr) minmax(360px, 1.08fr); align-items: center; gap: clamp(2.5rem, 7vw, 8rem); width: min(1180px, 100%); margin: 0 auto; }
  .hero__content { max-width: 35rem; }
  .hero__eyebrow { display: block; margin-bottom: 1rem; font-family: var(--fm); font-size: 0.68rem; letter-spacing: 0.16em; line-height: 1.3; color: var(--beam); }
  .hero__title { font-family: var(--fd); font-weight: 800; font-stretch: 118%; font-size: clamp(2.35rem, 4.9vw, 4.45rem); line-height: 0.94; letter-spacing: -0.03em; margin-bottom: 1.2rem; text-wrap: balance; }
  .hero__title-mask { display: block; overflow: hidden; }
  .hero__title-line { display: block; }
  .hero__title-line--accent { color: var(--yard-accent); }
  .hero__lede { font-size: clamp(1rem, 1.35vw, 1.1rem); line-height: 1.62; color: rgba(245,245,244,0.88); max-width: 43ch; margin-bottom: 2.15rem; }
  .hero__actions { display: flex; gap: 1.25rem; flex-wrap: wrap; }
  .hero__actions .cta { display: inline-flex; align-items: center; justify-content: center; min-height: 3.15rem; font-size: 0.76rem; letter-spacing: 0.11em; }
  .hero__actions .cta--primary { min-width: 12.5rem; box-shadow: 0 8px 20px -10px rgba(0,0,0,0.82), inset 0 1px 0 rgba(255,255,255,0.12); }
  .hero__actions .cta--primary:hover { box-shadow: 0 12px 26px -10px rgba(0,0,0,0.9), inset 0 1px 0 rgba(255,255,255,0.14); }
  .hero__actions .cta--ghost { min-width: 10.5rem; background: rgba(130,138,147,0.09); border-color: rgba(130,138,147,0.48); }
  .hero__actions .cta--ghost:hover { background: rgba(130,138,147,0.17); transform: translateY(-1px); }
  .hero__proof { display: flex; gap: clamp(1rem, 3vw, 2.2rem); margin-top: 2.5rem; padding-top: 1rem; border-top: 1px solid rgba(130,138,147,0.28); }
  .hero__proof div { display: grid; gap: 0.2rem; }
  .hero__proof b { font-family: var(--fd); font-size: 1.45rem; line-height: 1; color: var(--beam); }
  .hero__proof span { font-family: var(--fm); font-size: 0.62rem; line-height: 1.35; letter-spacing: 0.06em; text-transform: uppercase; color: var(--yard-steel); max-width: 9rem; }
  .hero__plate-link { display: block; min-width: 0; }
  .hero__plate-stack { position: relative; width: min(100%, 600px); margin-left: auto; isolation: isolate; }
  .hero__plate-rear { position: absolute; z-index: -1; top: 1.15rem; right: -1.35rem; width: 78%; margin: 0; padding: 0.65rem; background: linear-gradient(145deg, rgba(37,40,44,0.82), rgba(20,22,26,0.86)); border: 1px solid rgba(201,180,138,0.22); border-radius: 5px; transform: rotate(-3.2deg); opacity: 0.72; box-shadow: 0 22px 48px -30px rgba(0,0,0,0.9); pointer-events: none; }
  .hero__plate-rear-image { position: relative; width: 100%; height: clamp(220px, 31svh, 315px); overflow: hidden; border-radius: 2px; background: #25282c; }
  .hero__plate-rear-img { width: 100%; height: 100%; object-fit: cover; object-position: center; filter: saturate(0.62) contrast(0.94) brightness(0.72); }
  .hero__plate-rear .hero__plate-mark { top: 0.7rem; right: 0.7rem; opacity: 0.8; }
  .hero__plate { position: relative; margin: 0; width: 100%; margin-left: auto; padding: clamp(0.7rem, 1.5vw, 1.05rem); background: linear-gradient(145deg, rgba(37,40,44,0.98), rgba(20,22,26,0.98)); border: 1px solid rgba(255,255,255,0.08); border-top-color: rgba(201,180,138,0.52); border-radius: 5px; box-shadow: inset 0 1px 1px rgba(255,255,255,0.055), 0 26px 64px -28px rgba(0,0,0,0.92); transform: rotate(1.2deg); transition: transform 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease; }
  .hero__plate::before { content: ""; position: absolute; top: 0.35rem; left: 12%; right: 12%; height: 1px; background: linear-gradient(90deg, transparent, rgba(201,180,138,0.34), transparent); pointer-events: none; }
  .hero__plate-link:hover .hero__plate, .hero__plate-link:focus-visible .hero__plate { transform: rotate(1.8deg) translateY(-4px) !important; border-top-color: var(--beam); box-shadow: inset 0 1px 1px rgba(255,255,255,0.07), 0 32px 76px -30px rgba(0,0,0,0.96); }
  .hero__plate-image { position: relative; overflow: hidden; background: #25282c; width: 100%; height: clamp(280px, 38svh, 390px); border-radius: 2px; box-shadow: inset 0 0 0 1px rgba(255,255,255,0.06), inset 0 -28px 36px -34px rgba(0,0,0,0.9); }
  .hero__plate-img { width: 100%; height: 100%; object-fit: cover; object-position: center center; filter: saturate(0.82) contrast(1.06); }
  .hero__plate-mark { position: absolute; top: 1rem; right: 1rem; padding: 0.35rem 0.55rem; background: rgba(12,13,16,0.78); color: var(--beam); font-family: var(--fm); font-size: 0.62rem; letter-spacing: 0.12em; }
  .hero__plate-caption { display: grid; gap: 0.28rem; padding: 0.75rem 0.35rem 0.55rem; }
  .hero__plate-label { font-family: var(--fm); font-size: 0.66rem; letter-spacing: 0.11em; color: var(--yard-accent); }
  .hero__plate-caption b { font-family: var(--fd); font-size: clamp(1.3rem, 2.4vw, 1.9rem); line-height: 1; }
  .hero__plate-caption > span:last-child { color: var(--yard-steel); font-size: 0.85rem; }
  .hero__plate-specs { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid rgba(130,138,147,0.28); }
  .hero__plate-specs div { min-width: 0; padding: 0.6rem 0.35rem 0.15rem; border-right: 1px solid rgba(130,138,147,0.18); }
  .hero__plate-specs div:last-child { border-right: 0; }
  .hero__plate-specs dt { font-family: var(--fm); font-size: 0.62rem; line-height: 1.25; letter-spacing: 0.06em; text-transform: uppercase; color: var(--yard-steel); }
  .hero__plate-specs dd { margin-top: 0.2rem; font-size: clamp(0.76rem, 1vw, 0.86rem); color: var(--yard-light); overflow-wrap: anywhere; }
  .hero__scroll { position: absolute; bottom: 1.5rem; left: 50%; transform: translateX(-50%); z-index: 2; font-family: var(--fm); font-size: 0.66rem; letter-spacing: 0.12em; color: var(--yard-steel); display: flex; flex-direction: column; align-items: center; gap: 0.3rem; }
  /* Desktop hero is a compact scene, not a full-screen gate. The fixed height
     makes the CTA and the beginning of the warehouse story visible together;
     the portrait plate is sized inside that explicit budget. */
  @media (min-width: 861px) {
    .hero { height: auto; min-height: 0; padding: clamp(4rem, 7svh, 5rem) clamp(1rem, 5vw, 4rem) clamp(1rem, 2svh, 1.5rem); }
    .hero__grid { gap: clamp(1.75rem, 4vw, 4rem); }
    .hero__plate-image { height: clamp(260px, 40svh, 390px); }
    .hero__scroll { display: none; }
  }
  @media (min-width: 1060px) and (max-height: 700px) {
    .hero { min-height: 0; padding-top: 3.75rem; padding-bottom: 0.75rem; }
    .hero__grid { gap: 1.5rem; }
    .hero__title { font-size: clamp(2.25rem, 4.7vw, 3.8rem); margin-bottom: 1.25rem; }
    .hero__lede { margin-bottom: 1.35rem; }
    .hero__proof { margin-top: 1.5rem; }
    .hero__plate-image { height: 260px; }
  }
  /* Tablet-width desktop layouts get the compact treatment without a hard
     height: wrapped copy/buttons can grow naturally instead of being clipped
     by the hero's overflow boundary. */
  @media (min-width: 861px) and (max-width: 1059px) {
    .hero { height: auto; min-height: 0; padding-top: 5rem; padding-bottom: 2rem; }
    .hero__grid { gap: 1.5rem; }
    .hero__title { font-size: clamp(2.35rem, 4.6vw, 3.8rem); margin-bottom: 1.25rem; }
    .hero__lede { margin-bottom: 1.5rem; }
    .hero__proof { margin-top: 1.75rem; }
    .hero__plate-image { height: clamp(260px, calc(100svh - 19rem), 360px); }
  }
  @media (max-width: 860px) {
    .hero { min-height: auto; padding-top: 7rem; padding-bottom: 5rem; }
    .hero__grid { grid-template-columns: 1fr; gap: 3.25rem; }
    .hero__content { max-width: 44rem; }
    .hero__plate-stack { width: min(100%, 680px); margin: 0 auto; }
    .hero__plate-rear { display: none; }
    .hero__plate { margin: 0 auto; transform: rotate(0.6deg); }
    .hero__scroll { display: none; }
  }
  .hero__plate-link:focus-visible { outline: 2px solid var(--beam); outline-offset: 6px; }
  .hero-motion-ready .hero [data-reveal] { visibility: hidden; }
  @media (max-width: 520px) {
    .hero { padding-inline: 1rem; }
    .hero__title { font-size: clamp(2.3rem, 11vw, 3.35rem); line-height: 0.94; margin-bottom: 1rem; }
    .hero__eyebrow { margin-bottom: 0.8rem; font-size: 0.62rem; letter-spacing: 0.12em; }
    .hero__lede { margin-bottom: 1.6rem; }
    .hero__actions { display: grid; grid-template-columns: 1fr; gap: 0.7rem; }
    .hero__actions .cta, .hero__actions .cta--primary, .hero__actions .cta--ghost { justify-content: center; width: 100%; min-width: 0; }
    .hero__proof { gap: 0.8rem; margin-top: 1.65rem; }
    .hero__proof span { font-size: 0.58rem; }
    .hero__plate { padding: 0.55rem; }
    .hero__plate-image { height: min(48vh, 390px); }
    .hero__plate-specs { grid-template-columns: repeat(2, 1fr); }
    .hero__plate-specs div:nth-child(2) { border-right: 0; }
    .hero__plate-specs div:nth-child(-n + 2) { border-bottom: 1px solid rgba(130,138,147,0.18); }
    .hero__scroll { display: none; }
  }

  /* ===================== WALK THE YARD · full-bleed breaks ===================== */
  .yard-break { position: relative; height: 75vh; min-height: 480px; overflow: hidden; display: flex; align-items: flex-end; }
  .yard-break__photo { position: absolute; inset: -8% 0; will-change: transform; }
  .yard-break__img { width: 100%; height: 100%; object-fit: cover; }
  .yard-break__scrim { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(12,13,16,0.2) 0%, transparent 40%, rgba(12,13,16,0.9) 100%); }
  .yard-break__cap { position: relative; z-index: 2; padding: 0 clamp(1rem, 5vw, 4rem) clamp(2rem, 5vh, 3rem); max-width: 44rem; }
  .yard-break__no { font-family: var(--fm); font-size: 0.68rem; letter-spacing: 0.16em; color: var(--yard-accent); display: block; margin-bottom: 0.7rem; }
  .yard-break__cap p { font-size: 1.08rem; color: rgba(245,245,244,0.92); max-width: 42ch; }
  .yard-break__cap--reach { max-width: 50rem; }
  .yard-break--proof { height: auto; min-height: 0; display: block; padding: clamp(3rem, 7vw, 5rem) 0; background: rgba(12, 13, 16, 0.82); backdrop-filter: blur(3px); }
  .yard-break--proof .yard-break__scrim { display: none; }
  .reach-strip { display: grid; grid-template-columns: repeat(5, 1fr); gap: 2px; }
  @media (max-width: 900px) { .reach-strip { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 560px) { .reach-strip { grid-template-columns: repeat(2, 1fr); } }
  .reach-tile { position: relative; aspect-ratio: 4/3; overflow: hidden; }
  .reach-tile__img { width: 100%; height: 100%; object-fit: cover; }
  .reach-tile__cap { position: absolute; bottom: 0; left: 0; right: 0; padding: 0.5rem 0.7rem; background: linear-gradient(180deg, transparent, rgba(12,13,16,0.85)); font-family: var(--fm); font-size: 0.56rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--yard-steel); }
  .yard-break--proof .yard-break__cap { padding: clamp(2rem, 5vw, 3rem) clamp(1rem, 5vw, 4rem) 0; }

  /* ===================== THE STOCK · specimens you stand among ===================== */
  .stock { padding: clamp(3.5rem, 8vw, 6rem) clamp(1rem, 5vw, 4rem) clamp(2rem, 5vw, 3rem); background: rgba(12, 13, 16, 0.78); backdrop-filter: blur(3px); }
  .stock__head { max-width: 60ch; margin-bottom: clamp(2.5rem, 5vw, 3.5rem); }
  .stock__head .rail { display: block; margin-bottom: 0.7rem; }
  .stock__head h2 { font-family: var(--fd); font-weight: 700; font-stretch: 112%; font-size: clamp(1.7rem, 4vw, 2.8rem); line-height: 1.04; letter-spacing: -0.01em; margin-bottom: 1rem; text-wrap: balance; }
  .stock__sub { color: var(--yard-steel); max-width: 56ch; }
  .rail-controls { display: none; align-items: center; gap: 0.65rem; margin-top: 1.5rem; }
  .carousel-enhanced .rail-controls { display: flex; }
  .rail-control { display: inline-grid; place-items: center; width: 2.5rem; height: 2.5rem; border: 1px solid var(--yard-steel); border-radius: 3px; background: transparent; color: var(--yard-light); font: 600 1rem/1 var(--fm); cursor: pointer; transition: border-color 0.2s, background 0.2s, opacity 0.2s; }
  .rail-control:hover:not(:disabled), .rail-control:focus-visible:not(:disabled) { border-color: var(--beam); background: rgba(201,180,138,0.12); }
  .rail-control:disabled { opacity: 0.3; cursor: not-allowed; }
  .rail-progress { color: var(--beam); min-width: 4.5rem; text-align: center; }
  .stock__yard, .catalog__grid { display: flex; gap: clamp(1rem, 2vw, 1.5rem); overflow-x: auto; padding: 0.5rem 0.25rem 1.5rem; scroll-snap-type: x mandatory; scroll-padding-inline: 0.25rem; overscroll-behavior-x: contain; scrollbar-width: thin; scrollbar-color: var(--yard-steel) transparent; }
  .stock__yard::-webkit-scrollbar, .catalog__grid::-webkit-scrollbar { height: 0.35rem; }
  .stock__yard::-webkit-scrollbar-thumb, .catalog__grid::-webkit-scrollbar-thumb { background: var(--yard-steel); border-radius: 1rem; }
  .carousel__slide { scroll-snap-align: start; }
  .stock-item { flex: 0 0 min(34rem, 78vw); display: flex; flex-direction: column; }
  .stock-item__photo { position: relative; overflow: hidden; background: var(--yard-mid); border-radius: 4px; aspect-ratio: 1/1; box-shadow: calc((0.5 - var(--mx)) * 16px) calc((0.5 - var(--my)) * 12px) 30px -8px rgba(0,0,0,0.7); transition: box-shadow 0.4s, transform 0.4s; }
  .stock-item__img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease; }
  /* Cursor-aware warehouse spotlight: a warm pool that follows the cursor over
     the specimen, so the stock reads as lit by the same light as the air. */
  .stock-item__spot { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(220px circle at calc(var(--mx) * 100%) calc(var(--my) * 100%), rgba(201,180,138,0.22), transparent 55%); opacity: 0; transition: opacity 0.3s; mix-blend-mode: screen; }
  .stock-item:hover .stock-item__spot, .stock-item:focus-within .stock-item__spot { opacity: 1; }
  .stock-item:hover .stock-item__img { transform: scale(1.04); }
  .stock-item:hover .stock-item__photo, .stock-item:focus-within .stock-item__photo { box-shadow: calc((0.5 - var(--mx)) * 24px) calc((0.5 - var(--my)) * 18px) 44px -10px rgba(0,0,0,0.78); }
  .stock-item:focus-visible { outline: 2px solid var(--beam); outline-offset: 4px; }
  .stock-item__meta { padding: 1rem 0.2rem 0; }
  .stock-item__no { font-family: var(--fm); font-size: 0.62rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--yard-steel); }
  .stock-item__name { font-family: var(--fd); font-weight: 700; font-stretch: 108%; font-size: 1.2rem; letter-spacing: -0.01em; margin: 0.3rem 0 0.7rem; }
  .stock-item__specs { display: flex; flex-direction: column; }
  .stock-item__spec { display: flex; gap: 0.6rem; border-top: 1px solid rgba(130,138,147,0.22); padding: 0.3rem 0; font-size: 0.78rem; }
  .stock-item__spec dt { flex: 0 0 7.5rem; font-family: var(--fm); font-size: 0.6rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--yard-steel); padding-top: 0.1rem; }
  .stock-item__spec dd { color: var(--yard-light); }
  .stock-item__wa { display: inline-block; margin-top: 0.8rem; font-family: var(--fm); font-size: 0.64rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--yard-accent); font-weight: 600; border-bottom: 1px solid rgba(232,85,30,0.4); padding-bottom: 1px; }
  .stock-item__wa:hover { color: var(--yard-accent-darker); border-bottom-color: var(--yard-accent-darker); }
  .stock__order { margin-top: clamp(2.5rem, 5vw, 3.5rem); text-align: center; }

  /* ===================== THE CATALOG ===================== */
  .catalog { padding: clamp(3.5rem, 8vw, 6rem) clamp(1rem, 5vw, 4rem); background: rgba(12, 13, 16, 0.82); backdrop-filter: blur(3px); }
  .catalog__head { max-width: 60ch; margin-bottom: clamp(2.5rem, 5vw, 3.5rem); }
  .catalog__head .rail { display: block; margin-bottom: 0.7rem; }
  .catalog__head h2 { font-family: var(--fd); font-weight: 700; font-stretch: 112%; font-size: clamp(1.7rem, 4vw, 2.8rem); line-height: 1.04; letter-spacing: -0.01em; margin-bottom: 1rem; text-wrap: balance; }
  .catalog__sub { color: var(--yard-steel); max-width: 56ch; }
  .cat-tile { position: relative; flex: 0 0 min(26rem, 72vw); border-radius: 4px; overflow: hidden; aspect-ratio: 4/3; box-shadow: calc((0.5 - var(--mx)) * 14px) calc((0.5 - var(--my)) * 10px) 26px -10px rgba(0,0,0,0.7); transition: box-shadow 0.4s, transform 0.4s; }
  .cat-tile__img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease; }
  .cat-tile:hover .cat-tile__img { transform: scale(1.05); }
  .cat-tile:hover { box-shadow: calc((0.5 - var(--mx)) * 20px) calc((0.5 - var(--my)) * 14px) 34px -10px rgba(0,0,0,0.78); transform: translateY(-3px); }
  .cat-tile__overlay { position: absolute; inset: 0; background: linear-gradient(180deg, transparent 35%, rgba(12,13,16,0.92) 100%); }
  .cat-tile__body { position: absolute; bottom: 0; left: 0; right: 0; padding: 1.1rem 1.2rem; z-index: 2; }
  .cat-tile__no { font-family: var(--fm); font-size: 0.58rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--yard-accent); display: block; margin-bottom: 0.3rem; }
  .cat-tile__body b { display: block; font-family: var(--fd); font-weight: 600; font-size: 1.1rem; margin-bottom: 0.2rem; }
  .cat-tile__count { font-family: var(--fm); font-size: 0.66rem; letter-spacing: 0.06em; color: var(--yard-steel); }

  /* ===================== THE CLOSE ===================== */
  .close { padding: clamp(4rem, 10vw, 8rem) clamp(1rem, 5vw, 4rem); background: rgba(12, 13, 16, 0.88); backdrop-filter: blur(4px); }
