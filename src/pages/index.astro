---
/*
  MAIN LANDING · "The Steel Yard"
  The Steel Yard experience is now the canonical BSM landing page. Keep this
  route aligned with the approved prototype direction: real BRC stock first,
  direct specifications, and one clear quote path.

  Self-contained: this route owns its Steel Yard surface and does not import
  the legacy landing sections or Base.astro's shared page chrome.

  DIRECTION CONTRACT
  THESIS: A real BRC panel is the first thing the visitor can inspect. The
    product plate carries material truth; controlled dark yard atmosphere gives
    it weight without competing with it. Refuses the generic full-bleed stock
    photo, decorative hero machinery, and the "nice photo" read.
  OWN-WORLD: A quiet, high-contrast steel yard: deep charcoal ground, warm
    galvanized edge light, one authored product plate, direct specs, and a
    single orange WhatsApp action. Motion is a restrained enhancement, never
    the proof and never a prerequisite for understanding.
  STORY: A buyer immediately sees what BSM supplies, understands the exact BRC
    panel being shown, can verify its known specs, and can request a quote or
    continue into the full catalog without hunting.
  FIRST VIEWPORT: The left column carries the headline, useful context, and
    two clear actions. The right column carries a sharply framed real BRC panel
    with product name and confirmed specs. The mobile layout preserves that
    order and remains complete without WebGL or hover.  FORM: Steel Yard — the canonical landing experience for the main route.

*/
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import logoSrc from "../images/logo.png";
import { imageAsset } from "../utils/images.ts";
import { categories, brcShowcase } from "../data/catalog.ts";
import { blogPublishedAt, blogSlug, sortPublishedBlogs } from "../utils/blog.ts";
import { quoteLink, u } from "../utils/url.ts";

const quoteBrc = quoteLink({ category: "pagar", product: "Pagar BRC" });

const heroProduct = brcShowcase.items[0];
const heroSecondary = brcShowcase.items[1];
const yardBreak1 = imageAsset("pagar-brc-tumpukan-stok-gudang-2.jpg");
const yardBreak2 = imageAsset("pagar-brc-terpasang-outdoor-1.jpg");
const yardStock = brcShowcase.items;
const proof = brcShowcase.proof.slice(0, 5);
const featuredPosts = sortPublishedBlogs(await getCollection("blog")).slice(0, 3);
const fmtBlogDate = (date: Date) =>
  new Date(date).toLocaleDateString("id-ID", { day: "2-digit", month: "short", year: "numeric" });
---
<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/png" href={logoSrc.src} />
  <title>Bangun Sarana Makmur — Material Proyek dari Surabaya</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62.5..125,400..800&family=Hanken+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
  <script is:inline>
    (function () {
      try {
        var stored = window.localStorage.getItem("bsm-theme");
        var theme = stored === "light" || stored === "dark"
          ? stored
          : window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
        document.documentElement.dataset.theme = theme;
      } catch {
        document.documentElement.dataset.theme = "dark";
      }
    })();

    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      document.documentElement.classList.add("hero-motion-ready");
      window.setTimeout(() => document.documentElement.classList.remove("hero-motion-ready"), 2800);
    }
  </script>
</head>
<body>
  <SiteHeader />

  <!-- ===================== HERO · one product, one action ===================== -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__ambient" data-hero-shader aria-hidden="true"></div>
    <div class="hero__field-markers" aria-hidden="true">
      <span class="hero__field-marker hero__field-marker--top">FIELD / 01</span>
      <span class="hero__field-marker hero__field-marker--side">INSPECTION BAY <i></i> SBY</span>
      <span class="hero__field-marker hero__field-marker--bottom">BRC SPECIMEN · FIELD 01</span>
    </div>
    <div class="hero__grid">
      <div class="hero__content" data-reveal>
        <span class="hero__eyebrow">PAGAR BRC &amp; MATERIAL KONSTRUKSI</span>
        <h1 class="hero__title" id="hero-title">
          <span class="hero__title-mask"><span class="hero__title-line" data-line>Mulai dari spesifikasi.</span></span>
          <span class="hero__title-mask"><span class="hero__title-line hero__title-line--accent" data-line>Berangkat ke proyek.</span></span>
        </h1>
        <p class="hero__lede">BSM memasok pagar BRC, atap, bondek, dan material konstruksi dari Surabaya. Periksa spesifikasi produk, lalu sampaikan kebutuhan, volume, dan lokasi proyek untuk mendapatkan penawaran harga pabrik dengan pengiriman ke seluruh Indonesia.</p>
        <div class="hero__actions">
          <a class="cta cta--primary" href={quoteLink()}>Minta Penawaran</a>
          <a class="cta cta--ghost" href={u("/katalog")}>Telusuri Katalog</a>
        </div>
        <div class="hero__intent" aria-labelledby="hero-intent-title">
          <span class="hero__intent-label" id="hero-intent-title">Atur konteks kebutuhan <span aria-hidden="true">·</span> opsional</span>
          <div class="hero__intent-links">
            <a href={u("/penawaran?intent=project")}>Untuk proyek / pengadaan <span aria-hidden="true">↗</span></a>
            <a href={u("/penawaran?intent=home")}>Untuk rumah / renovasi <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <div class="hero__proof" aria-label="Informasi pengadaan BSM">
          <div><b>34</b><span>provinsi pengiriman</span></div>
          <div><b>6</b><span>kelompok material</span></div>
          <div><b>SBY</b><span>basis distribusi</span></div>
        </div>
      </div>

      <div class="hero__plate-stack">
        <figure class="hero__plate-rear" aria-hidden="true">
          <div class="hero__plate-rear-image">
            <Image src={imageAsset(heroSecondary.angles[0])} alt="" width={900} height={1600} loading="lazy" decoding="async" class="hero__plate-rear-img" />
            <span class="hero__plate-mark">BRC / 02</span>
          </div>
        </figure>
        <a class="hero__plate-link" href={u("/pagar-brc")} aria-label="Lihat detail Pagar BRC Panel">
          <figure class="hero__plate" data-reveal>
            <div class="hero__plate-image">
              <Image src={imageAsset(heroProduct.angles[0])} alt="Pagar BRC Panel, tampak perspektif" width={900} height={1600} loading="eager" fetchpriority="high" decoding="async" class="hero__plate-img" />
              <div class="hero__plate-scan" aria-hidden="true"><span></span></div>
              <span class="hero__plate-corner hero__plate-corner--tl" aria-hidden="true"></span>
              <span class="hero__plate-corner hero__plate-corner--br" aria-hidden="true"></span>
              <span class="hero__plate-mark">BRC / 01</span>
            </div>
            <figcaption class="hero__plate-caption">
              <span class="hero__plate-label">PAGAR BRC PANEL · PRODUK UNGGULAN</span>
              <b>{heroProduct.name}</b>
              <span>Foto produk nyata · didistribusikan dari Surabaya</span>
            </figcaption>
            <div class="hero__plate-status" aria-hidden="true">
              <span><i></i> VISUAL CHECK</span>
              <span>ORIGIN / SBY</span>
              <span>PLATE / 01—06</span>
            </div>
            <dl class="hero__plate-specs">
              {heroProduct.specs.slice(0, 4).map((spec) => (
                <div><dt>{spec.k}</dt><dd>{spec.v}</dd></div>
              ))}
            </dl>
          </figure>
        </a>
      </div>
    </div>
    <div class="hero__scroll" data-reveal><span>gulir · lihat material lain</span> ↓</div>
  </section>

  <!-- ===================== WALK THE YARD · full-bleed break 1 ===================== -->
  <section class="yard-break" aria-label="Tumpukan stok di gudang">
    <div class="yard-break__photo" data-parallax-layer="-0.08">
      <Image src={yardBreak1} alt="Tumpukan pagar BRC disiapkan di gudang BSM" width={1600} height={2000} loading="lazy" class="yard-break__img" />
    </div>
    <div class="yard-break__scrim"></div>
    <div class="yard-break__cap" data-reveal>
      <span class="yard-break__no">01 / 03</span>
      <p>Periksa melalui foto dan spesifikasi: pagar BRC dengan dimensi, diameter kawat, mesh, finishing, dan asal yang tercatat. Bukti produk, bukan ilustrasi katalog.</p>
    </div>
  </section>

  <!-- ===================== THE STOCK · BRC specimens you stand among ===================== -->
  <section class="stock" id="stok" aria-labelledby="stock-title">
    <header class="stock__head" data-reveal>
      <span class="rail">SPESIFIKASI PRODUK · PAGAR BRC</span>
      <h2 id="stock-title">Pilih produk BRC sesuai kebutuhan proyek</h2>
      <p class="stock__sub">Enam lini BRC dengan foto produk dan spesifikasi yang tersedia. Bandingkan dimensi, diameter kawat, mesh, dan finishing; lalu minta penawaran per unit.</p>
      <div class="rail-controls" aria-label="Navigasi stok BRC">
        <button class="rail-control" type="button" data-carousel-dir="prev" data-carousel-target="stock" aria-label="Produk BRC sebelumnya">←</button>
        <span class="rail-progress label" data-carousel-progress="stock" aria-live="polite">01 / 06</span>
        <button class="rail-control" type="button" data-carousel-dir="next" data-carousel-target="stock" aria-label="Produk BRC berikutnya">→</button>
      </div>
    </header>

    <div class="stock__yard" data-carousel-track="stock" role="region" aria-roledescription="carousel" aria-label="Produk BRC dari stok gudang" tabindex="0">
      {yardStock.map((s, i) => (
        <article class={`stock-item carousel__slide`} role="group" aria-label={`Produk ${i + 1} dari ${yardStock.length}`} data-mount>
          <div class="stock-item__photo">
            <Image src={imageAsset(s.angles[0])} alt={s.name} width={720} height={720} loading="lazy" class="stock-item__img" />
            <div class="stock-item__spot" aria-hidden="true"></div>
          </div>
          <div class="stock-item__meta">
            <span class="stock-item__no">UNIT {String(i + 1).padStart(2, "0")} · BRC</span>
            <h3 class="stock-item__name">{s.name}</h3>
            <dl class="stock-item__specs">
              {s.specs.map((sp) => (
                <div class="stock-item__spec"><dt>{sp.k}</dt><dd>{sp.v}</dd></div>
              ))}
            </dl>
            <a class="stock-item__wa" href={quoteLink({ category: "pagar", product: s.name === "Pagar BRC Panel" ? "Pagar BRC" : s.name, notes: `Konteks produk: ${s.name}` })}>Susun permintaan unit ini →</a>
          </div>
        </article>
      ))}
    </div>

    <div class="stock__order" data-reveal>
      <a class="cta cta--primary cta--lg" href={quoteBrc}>Susun permintaan BRC lengkap →</a>
    </div>
  </section>

  <!-- ===================== WALK THE YARD · full-bleed break 2 ===================== -->
  <section class="yard-break" aria-label="Pagar BRC terpasang di proyek">
    <div class="yard-break__photo" data-parallax-layer="-0.08">
      <Image src={yardBreak2} alt="Pagar BRC terpasang di proyek" width={1600} height={2000} loading="lazy" class="yard-break__img" />
    </div>
    <div class="yard-break__scrim"></div>
    <div class="yard-break__cap" data-reveal>
      <span class="yard-break__no">02 / 03</span>
      <p>Dari basis distribusi di Surabaya ke lapangan: dokumentasi pagar BRC yang telah digunakan dan terpasang di proyek.</p>
    </div>
  </section>

  <!-- ===================== THE CATALOG · six families in the yard ===================== -->
  <section class="catalog" id="katalog" aria-labelledby="cat-title">
    <header class="catalog__head" data-reveal>
      <span class="rail">KATALOG · 6 KELOMPOK MATERIAL</span>
      <h2 id="cat-title">Satu sumber untuk material proyek</h2>
      <p class="catalog__sub">BSM menyediakan enam kelompok material konstruksi dari basis Surabaya. Mulai dari pagar BRC, lalu telusuri atap, dinding, pintu, struktur, dan utilitas untuk kebutuhan pengadaan Anda.</p>
      <div class="rail-controls" aria-label="Navigasi kelompok material">
        <button class="rail-control" type="button" data-carousel-dir="prev" data-carousel-target="categories" aria-label="Kelompok material sebelumnya">←</button>
        <span class="rail-progress label" data-carousel-progress="categories" aria-live="polite">01 / 06</span>
        <button class="rail-control" type="button" data-carousel-dir="next" data-carousel-target="categories" aria-label="Kelompok material berikutnya">→</button>
      </div>
    </header>
    <div class="catalog__grid" data-carousel-track="categories" role="region" aria-roledescription="carousel" aria-label="Enam kelompok material BSM" tabindex="0">
      {categories.map((c, i) => (
        <a class="cat-tile carousel__slide" aria-label={`${c.name} · kelompok ${i + 1} dari ${categories.length}`} data-mount href={u(`/kategori/${c.slug}`)}>
          <Image src={imageAsset(c.image)} alt={c.name} width={600} height={450} loading="lazy" class="cat-tile__img" />
          <div class="cat-tile__overlay"></div>
          <div class="cat-tile__body">
            <span class="cat-tile__no">RAK {String(i + 1).padStart(2, "0")}</span>
            <b>{c.name}</b>
            <span class="cat-tile__count">{c.count} lini · {c.lines[0]} →</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ===================== FIELD NOTES · latest buying guides ===================== -->
  <section class="field-notes" id="blog" aria-labelledby="field-notes-title">
    <div class="field-notes__head" data-reveal>
      <div>
        <span class="rail">BLOG BSM · PANDUAN MATERIAL</span>
        <h2 id="field-notes-title">Baca sebelum memilih material.</h2>
      </div>
      <a class="field-notes__all" href={u("/blog")}>Lihat semua artikel <span aria-hidden="true">↗</span></a>
    </div>
    <div class="field-notes__grid">
      {featuredPosts.map((post, i) => (
        <a class="field-note" href={u(`/blog/${blogSlug(post)}`)} data-mount>
          <div class="field-note__image">
            {post.data.image ? (
              <Image src={imageAsset(post.data.image)} alt={post.data.imageAlt ?? post.data.title} width={720} height={420} loading="lazy" class="field-note__img" />
            ) : (
              <span class="field-note__placeholder" aria-hidden="true">BSM / {String(i + 1).padStart(2, "0")}</span>
            )}
            <span class="field-note__index">BLOG / {String(i + 1).padStart(2, "0")}</span>
          </div>
          <div class="field-note__body">
            <span class="field-note__meta">{post.data.kicker ?? "Panduan Material"} · {fmtBlogDate(blogPublishedAt(post))}</span>
            <h3>{post.data.title}</h3>
            {post.data.excerpt && <p>{post.data.excerpt}</p>}
            <span class="field-note__read">Baca artikel <span aria-hidden="true">→</span></span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ===================== WALK THE YARD · full-bleed break 3 (reach proof) ===================== -->
  <section class="yard-break yard-break--proof" aria-label="Bukti jangkauan">
    <div class="reach-strip" data-reveal>
      {proof.map((p, i) => (
        <figure class={`reach-tile reach-tile--${i + 1}`} data-mount>
          <Image src={imageAsset(p.image)} alt={p.caption} width={640} height={480} loading="lazy" class="reach-tile__img" />
          <figcaption class="reach-tile__cap">{p.caption}</figcaption>
        </figure>
      ))}
    </div>
    <div class="yard-break__cap yard-break__cap--reach" data-reveal>
      <span class="yard-break__no">03 / 03</span>
      <p>Pengiriman dari Surabaya ke 34 provinsi, dengan dokumentasi lapangan sebagai bukti penggunaan pagar BRC di proyek nyata.</p>
    </div>
  </section>

  <!-- ===================== THE CLOSE · stamped on steel ===================== -->
  <section class="close" id="kontak" aria-labelledby="close-title">
    <div class="close__inner" data-reveal>
      <span class="rail">MEJA PESAN · WHOLESALE</span>
      <h2 id="close-title">Sampaikan kebutuhan proyek Anda.</h2>
      <p class="close__sub">Kirim kategori material, spesifikasi, jumlah, dan lokasi proyek melalui WhatsApp. Tim BSM akan menyiapkan informasi harga pabrik, ketersediaan, dan pengiriman. Konsultasi gratis; pengiriman Surabaya gratis.</p>
      <a class="cta cta--primary cta--lg" href={quoteLink()}>Susun permintaan penawaran →</a>
      <p class="close__addr">Jl. Prapen Indah Gg. 6 Blok C–22, Surabaya · 031 – 99853472 · bsmbangun@yahoo.co.id</p>
    </div>
  </section>

  <footer class="proto-footer">
    <span>CV BANGUN SARANA MAKMUR · MATERIAL KONSTRUKSI · SURABAYA</span>
  </footer>

<script>
  // Motion is enhancement only: the hero remains fully visible without JS.
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // The hero shader is atmosphere only. CSS remains the visual floor if WebGL
  // is unavailable, reduced motion is enabled, or the lazy enhancement fails.
  const heroShaderContainer = document.querySelector<HTMLElement>("[data-hero-shader]");
  let disposeHeroShader: (() => void) | null = null;
  let cancelHeroShaderStart = () => {};
  if (heroShaderContainer && !reduceMotion) {
    let leavingPage = false;
    const startHeroShader = async () => {
      if (leavingPage) return;
      try {
        const { initSteelYardHeroShader } = await import("../scripts/steelYardHeroShader.ts");
        if (!leavingPage) disposeHeroShader = initSteelYardHeroShader(heroShaderContainer);
      } catch {
        // The CSS gradient is intentionally a complete fallback.
      }
    };
    const ric = (window as any).requestIdleCallback as
      | ((callback: () => void, options?: { timeout: number }) => number)
      | undefined;
    const cancelRic = (window as any).cancelIdleCallback as ((id: number) => void) | undefined;
    if (typeof ric === "function") {
      const idleId = ric(startHeroShader, { timeout: 1600 });
      cancelHeroShaderStart = () => cancelRic?.(idleId);
    } else {
      window.addEventListener("load", startHeroShader, { once: true });
      cancelHeroShaderStart = () => {
        leavingPage = true;
        window.removeEventListener("load", startHeroShader);
      };
    }
    const markLeaving = () => { leavingPage = true; };
    window.addEventListener("pagehide", markLeaving, { once: true });
  }

  // The lower stock/catalog surfaces use a restrained shared spotlight. Keep
  // that interaction lightweight; the hero itself does not depend on it.
  const root = document.documentElement;

  // On fine pointers, the specimen behaves like a physical inspection plate:
  // a tiny amount of tilt and parallax follows the cursor. Touch, reduced
  // motion, and keyboard users keep the static, fully legible floor.
  const hero = document.querySelector<HTMLElement>(".hero");
  const heroPlateStack = document.querySelector<HTMLElement>(".hero__plate-stack");
  const heroPlateLink = document.querySelector<HTMLElement>(".hero__plate-link");
  const heroPlate = document.querySelector<HTMLElement>(".hero__plate");
  const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
  if (!reduceMotion && finePointer && hero && heroPlateStack && heroPlateLink && heroPlate) {
    let plateRaf = 0;
    let plateX = 0;
    let plateY = 0;
    let targetPlateX = 0;
    let targetPlateY = 0;
    const paintPlate = () => {
      plateRaf = 0;
      plateX += (targetPlateX - plateX) * 0.14;
      plateY += (targetPlateY - plateY) * 0.14;
      const shiftX = (plateX * 7).toFixed(2);
      const shiftY = (plateY * 5).toFixed(2);
      heroPlateLink.style.setProperty("--plate-shift-x", shiftX);
      heroPlateLink.style.setProperty("--plate-shift-y", shiftY);
      heroPlateStack.style.setProperty("--plate-shift-x", shiftX);
      heroPlateStack.style.setProperty("--plate-shift-y", shiftY);
      heroPlate.style.setProperty("--plate-tilt-x", (plateX * 1.8).toFixed(2));
      heroPlate.style.setProperty("--plate-tilt-y", (-plateY * 1.8).toFixed(2));
      if (Math.abs(targetPlateX - plateX) > 0.001 || Math.abs(targetPlateY - plateY) > 0.001) {
        plateRaf = requestAnimationFrame(paintPlate);
      }
    };
    const resetPlate = () => {
      targetPlateX = 0;
      targetPlateY = 0;
      if (!plateRaf) plateRaf = requestAnimationFrame(paintPlate);
    };
    hero.addEventListener("pointermove", (event) => {
      const rect = hero.getBoundingClientRect();
      targetPlateX = Math.max(-1, Math.min(1, (event.clientX - (rect.left + rect.width * 0.72)) / (rect.width * 0.34)));
      targetPlateY = Math.max(-1, Math.min(1, (event.clientY - (rect.top + rect.height * 0.5)) / (rect.height * 0.56)));
      if (!plateRaf) plateRaf = requestAnimationFrame(paintPlate);
    }, { passive: true });
    hero.addEventListener("pointerleave", resetPlate, { passive: true });
  }

  root.style.setProperty("--mx", "0.5");
  root.style.setProperty("--my", "0.5");
  root.style.setProperty("--ml", "0.5");
  let pointerRaf = 0;
  let targetX = 0.5;
  let targetY = 0.5;
  let currentX = 0.5;
  let currentY = 0.5;
  function updatePointer(e: PointerEvent) {
    targetX = e.clientX / window.innerWidth;
    targetY = 1 - e.clientY / window.innerHeight;
    if (!pointerRaf) pointerRaf = requestAnimationFrame(tickPointer);
  }
  function tickPointer() {
    currentX += (targetX - currentX) * 0.12;
    currentY += (targetY - currentY) * 0.12;
    root.style.setProperty("--mx", currentX.toFixed(3));
    root.style.setProperty("--my", currentY.toFixed(3));
    root.style.setProperty("--ml", (currentX * 0.6 + 0.2).toFixed(3));
    if (Math.abs(targetX - currentX) > 0.001 || Math.abs(targetY - currentY) > 0.001) {
      pointerRaf = requestAnimationFrame(tickPointer);
    } else {
      pointerRaf = 0;
    }
  }
  if (!reduceMotion) window.addEventListener("pointermove", updatePointer, { passive: true });
  window.addEventListener("pagehide", () => {
    if (pointerRaf) cancelAnimationFrame(pointerRaf);
    cancelHeroShaderStart();
    disposeHeroShader?.();
  }, { once: true });

  // ---- Native carousel enhancement ----
  // CSS Scroll Snap is the floor: touch, trackpad, keyboard focus, and a plain
  // horizontal list all work without JavaScript. This small layer only adds
  // explicit previous/next controls and progress feedback.
  const carouselTracks = Array.from(document.querySelectorAll<HTMLElement>("[data-carousel-track]"));
  let initializedCarousels = 0;
  carouselTracks.forEach((track) => {
    const name = track.dataset.carouselTrack;
    if (!name) return;
    const slides = Array.from(track.querySelectorAll<HTMLElement>(".carousel__slide"));
    const prev = document.querySelector<HTMLButtonElement>(`[data-carousel-dir="prev"][data-carousel-target="${name}"]`);
    const next = document.querySelector<HTMLButtonElement>(`[data-carousel-dir="next"][data-carousel-target="${name}"]`);
    const progress = document.querySelector<HTMLElement>(`[data-carousel-progress="${name}"]`);
    if (!slides.length) return;

    let active = 0;
    const reduceCarouselMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const setActive = (index: number) => {
      active = Math.max(0, Math.min(index, slides.length - 1));
      slides.forEach((slide, i) => slide.setAttribute("aria-current", i === active ? "true" : "false"));
      if (progress) progress.textContent = `${String(active + 1).padStart(2, "0")} / ${String(slides.length).padStart(2, "0")}`;
      if (prev) prev.disabled = active === 0;
      if (next) next.disabled = active === slides.length - 1;
    };
    const goTo = (index: number) => {
      const target = Math.max(0, Math.min(index, slides.length - 1));
      track.scrollTo({ left: slides[target].offsetLeft, behavior: reduceCarouselMotion ? "auto" : "smooth" });
      setActive(target);
    };
    const syncActive = () => {
      const nearest = slides.reduce((best, slide, i) => {
        const distance = Math.abs(slide.offsetLeft - track.scrollLeft);
        return distance < best.distance ? { index: i, distance } : best;
      }, { index: 0, distance: Number.POSITIVE_INFINITY });
      setActive(nearest.index);
    };

    prev?.addEventListener("click", () => goTo(active - 1));
    next?.addEventListener("click", () => goTo(active + 1));
    track.addEventListener("scroll", syncActive, { passive: true });
    track.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") { event.preventDefault(); goTo(active - 1); }
      if (event.key === "ArrowRight") { event.preventDefault(); goTo(active + 1); }
    });
    setActive(0);
    initializedCarousels += 1;
    if (initializedCarousels === carouselTracks.length) {
      document.documentElement.classList.add("carousel-enhanced");
    }
  });

  // ---- GSAP motion orchestration ----
  (async () => {
    if (reduceMotion) return;
    const gsap = (await import("gsap")).default;
    const { ScrollTrigger } = await import("gsap/ScrollTrigger");
    gsap.registerPlugin(ScrollTrigger);
    if (document.fonts?.ready) await document.fonts.ready;

    // Hero entrance: the product plate and headline assemble in with a
    // restrained rise. The head-level class is the only initial hide, so a
    // successful animation cannot flash content invisible after first paint;
    // its timeout restores the CSS floor if this enhancement fails. If the
    // fallback already took over while imports were loading, leave the content
    // visible instead of re-hiding it here.
    if (document.documentElement.classList.contains("hero-motion-ready")) {
      const heroReveals = gsap.utils.toArray<HTMLElement>(".hero [data-reveal]");
      gsap.set(heroReveals, { autoAlpha: 0, y: 30 });
      document.documentElement.classList.remove("hero-motion-ready");
      gsap.to(heroReveals, { autoAlpha: 1, y: 0, duration: 1.0, ease: "power3.out", stagger: 0.12, delay: 0.2 });
    }

    // Stock rises into view as you walk past (material you stand among).
    const mounts = gsap.utils.toArray<HTMLElement>("[data-mount]");
    mounts.forEach((el) => {
      gsap.set(el, { autoAlpha: 0, y: 60, scale: 0.95 });
      ScrollTrigger.create({
        trigger: el, start: "top 90%", once: true,
        onEnter: () => gsap.to(el, { autoAlpha: 1, y: 0, scale: 1, duration: 0.9, ease: "power2.out" }),
      });
    });

    // Section heads + reveals.
    const heads = gsap.utils.toArray<HTMLElement>("[data-reveal]:not(.hero [data-reveal]):not([data-mount])");
    heads.forEach((el) => {
      gsap.set(el, { autoAlpha: 0, y: 26 });
      ScrollTrigger.create({ trigger: el, start: "top 86%", once: true, onEnter: () => gsap.to(el, { autoAlpha: 1, y: 0, duration: 0.9, ease: "power2.out" }) });
    });

    // Parallax: full-bleed photos + layers drift at different rates (depth).
    gsap.utils.toArray<HTMLElement>("[data-parallax-layer]").forEach((el) => {
      const amt = parseFloat(el.dataset.parallaxLayer || "0") * 100;
      gsap.to(el, { y: () => amt, ease: "none", scrollTrigger: { trigger: el, start: "top bottom", end: "bottom top", scrub: true } });
    });

    ScrollTrigger.refresh();
  })();
</script>

<style>
  :root {
