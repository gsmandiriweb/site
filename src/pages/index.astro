  .hero__plate-stack:hover::before { opacity: 1; }
  .hero__plate-rear { position: absolute; z-index: -1; top: 1.15rem; right: -1.35rem; width: 78%; margin: 0; padding: 0.65rem; background: linear-gradient(145deg, color-mix(in srgb, var(--theme-panel) 90%, transparent), color-mix(in srgb, var(--theme-surface) 92%, transparent)); border: 1px solid rgba(201,180,138,0.22); border-radius: 5px; transform: rotate(-3.2deg); opacity: 0.72; box-shadow: 0 22px 48px -30px rgba(0,0,0,0.9); pointer-events: none; }
