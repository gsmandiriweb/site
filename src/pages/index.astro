---
/*
  PRODUCTION DIRECTION — Steel Yard
  The approved visual world for BSM: real construction material first,
  industrial weight and scale, direct specifications, and one clear quote path.
  BRC is the entry story; the catalog remains the destination.
*/
import Base from "../layouts/Base.astro";
import { categories, brcProducts, brcShowcase } from "../data/catalog.ts";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { imageAsset } from "../utils/images.ts";
import { u, waLink } from "../utils/url.ts";

const wa = waLink();
const waBrc = waLink(
  "Halo BSM, saya butuh penawaran lengkap pagar BRC (panel, tiang BRC, tiang Y, pintu pagar, aksesoris). " +
    "Mohon info harga pabrik, stok, dan pengiriman. Terima kasih."
);
const heroProduct = brcProducts[0];
const heroSecondary = brcProducts[1];
const yardBreak1 = imageAsset("pagar-brc-tumpukan-stok-gudang-2.jpg");
const yardBreak2 = imageAsset("pagar-brc-terpasang-outdoor-1.jpg");
const yardStock = brcShowcase.items;
const proof = brcShowcase.proof.slice(0, 5);

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const fmt = (d: Date) =>
  new Date(d).toLocaleDateString("id-ID", { day: "2-digit", month: "short", year: "numeric" });
---

<Base>
  <!-- ===================== HERO · the material leads ===================== -->
  <section class="hero hero--yard" aria-labelledby="hero-title">
    <div class="hero__atmosphere" data-hero-atmosphere aria-hidden="true"></div>
    <div class="hero__grid wrap">
      <div class="hero__copy">
        <div class="eyebrow-row">
          <span class="tick" aria-hidden="true"></span>
          <span class="label label--ink">Pagar BRC &amp; Material Konstruksi · Surabaya</span>
        </div>
        <h1 class="display" id="hero-title">Material proyek.<br />Harga pabrik.<br /><span class="hero__accent">Kirim ke proyek.</span></h1>
        <p class="lede">
          BSM memasok pagar BRC, atap, bondek, dan material konstruksi dari Surabaya. Periksa
          spesifikasi, sampaikan kebutuhan, volume, dan lokasi proyek — tim kami menyiapkan
          penawaran harga pabrik dengan pengiriman ke seluruh Indonesia.
        </p>
        <div class="hero__actions">
          <a class="btn btn--primary" href={wa} target="_blank" rel="noopener">Minta Penawaran Proyek</a>
          <a class="btn btn--ghost" href={u("/katalog")}>Telusuri Katalog</a>
        </div>
        <div class="hero__proof" aria-label="Informasi pengadaan BSM">
          <div><b>34</b><span>provinsi pengiriman</span></div>
          <div><b>6</b><span>kelompok material</span></div>
          <div><b>SBY</b><span>basis distribusi</span></div>
        </div>
      </div>

      <div class="hero__plate-stack">
        <figure class="hero__plate-rear" aria-hidden="true">
          <div class="hero__plate-rear-image">
            <Image src={imageAsset(heroSecondary.image)} alt="" width={900} height={1200} loading="lazy" decoding="async" />
            <span class="hero__plate-mark">BRC / 02</span>
          </div>
        </figure>
        <a class="hero__sheet-link" href={u("/pagar-brc")} aria-label="Lihat spesifikasi lengkap pagar BRC">
          <figure class="hero__sheet" aria-label={`Spesifikasi ${heroProduct.name}: ${heroProduct.spec}`}>
            <div class="hero__sheet-image">
              <Image src={imageAsset(heroProduct.image)} alt={`Pagar BRC ${heroProduct.name}, tampak perspektif`} width={900} height={1200} loading="eager" fetchpriority="high" decoding="async" />
              <span class="hero__plate-mark">BRC / 01</span>
            </div>
            <figcaption class="hero__sheet-caption">
              <span class="hero__sheet-label">PAGAR BRC PANEL · PRODUK UNGGULAN</span>
              <b>{heroProduct.name}</b>
              <span>Foto produk nyata · didistribusikan dari Surabaya</span>
            </figcaption>
            <dl class="hero__sheet-specs">
              <div><dt>SPESIFIKASI</dt><dd>{heroProduct.spec}</dd></div>
              <div><dt>ASAL</dt><dd>SBY</dd></div>
            </dl>
          </figure>
        </a>
      </div>
    </div>
    <div class="hero__scroll" aria-hidden="true"><span>gulir · lihat material lain</span> ↓</div>
  </section>

  <!-- ===================== TRUST STRIP ===================== -->
  <section class="trust" aria-label="Jangkauan dan layanan BSM">
    <div class="trust__cell"><div class="n">34</div><span class="label">Provinsi pengiriman</span></div>
    <div class="trust__cell"><div class="n">6</div><span class="label">Kelompok material</span></div>
    <div class="trust__cell"><div class="n">READY</div><span class="label">Siap ditanyakan ke sales</span></div>
    <div class="trust__cell"><div class="n">SBY</div><span class="label">Basis distribusi</span></div>
  </section>

  <!-- ===================== WALK THE YARD · warehouse proof ===================== -->
  <section class="yard-break" aria-label="Tumpukan stok di gudang">
    <div class="yard-break__photo" data-parallax-layer="-0.08">
      <Image src={yardBreak1} alt="Tumpukan pagar BRC disiapkan di gudang BSM" width={1600} height={2000} loading="lazy" decoding="async" />
    </div>
    <div class="yard-break__scrim"></div>
    <div class="yard-break__cap" data-reveal>
      <span class="yard-break__no">01 / 03</span>
      <p>Periksa melalui foto dan spesifikasi: pagar BRC dengan dimensi, diameter kawat, mesh, finishing, dan asal yang tercatat. Bukti produk, bukan ilustrasi katalog.</p>
    </div>
  </section>

  <!-- ===================== THE STOCK · full BRC specimen rail ===================== -->
  <section class="stock" id="stok" aria-labelledby="stock-title">
    <header class="stock__head">
      <span class="rail">SPESIFIKASI PRODUK · PAGAR BRC</span>
      <h2 id="stock-title">Pilih produk BRC sesuai kebutuhan proyek</h2>
      <p class="stock__sub">Enam lini BRC dengan foto produk dan spesifikasi yang tersedia. Bandingkan dimensi, diameter kawat, mesh, dan finishing; lalu minta penawaran per unit.</p>
      <div class="rail-controls" aria-label="Navigasi stok BRC">
        <button class="rail-control" type="button" data-carousel-dir="prev" data-carousel-target="stock" aria-controls="track-stock" aria-label="Produk BRC sebelumnya">←</button>
        <span class="rail-progress label" data-carousel-progress="stock" aria-live="polite">01 / 06</span>
        <button class="rail-control" type="button" data-carousel-dir="next" data-carousel-target="stock" aria-controls="track-stock" aria-label="Produk BRC berikutnya">→</button>
      </div>
    </header>
    <div id="track-stock" class="stock__yard" data-carousel-track="stock" role="region" aria-roledescription="carousel" aria-label="Produk BRC dari stok gudang" tabindex="0">
      {yardStock.map((s, i) => (
        <article class="stock-item carousel__slide" data-mount role="group" aria-label={`Produk ${i + 1} dari ${yardStock.length}`}>
          <div class="stock-item__photo">
            <Image src={imageAsset(s.angles[0])} alt={s.name} width={720} height={720} loading="lazy" decoding="async" />
            <div class="stock-item__spot" aria-hidden="true"></div>
          </div>
          <div class="stock-item__meta">
            <span class="stock-item__no">UNIT {String(i + 1).padStart(2, "0")} · BRC</span>
            <h3 class="stock-item__name">{s.name}</h3>
            <dl class="stock-item__specs">
              {s.specs.map((sp) => (
                <div class="stock-item__spec"><dt>{sp.k}</dt><dd>{sp.v}</dd></div>
              ))}
            </dl>
            <a class="stock-item__wa" href={waLink(s.waContext)} target="_blank" rel="noopener">Minta penawaran unit ini →</a>
          </div>
        </article>
      ))}
    </div>
    <div class="stock__order"><a class="btn btn--primary btn--lg" href={waBrc} target="_blank" rel="noopener">Minta penawaran BRC lengkap →</a></div>
  </section>

  <!-- ===================== WALK THE YARD · installed proof ===================== -->
  <section class="yard-break" aria-label="Pagar BRC terpasang di proyek">
    <div class="yard-break__photo" data-parallax-layer="-0.08">
      <Image src={yardBreak2} alt="Pagar BRC terpasang di proyek" width={1600} height={2000} loading="lazy" decoding="async" />
    </div>
    <div class="yard-break__scrim"></div>
    <div class="yard-break__cap" data-reveal>
      <span class="yard-break__no">02 / 03</span>
      <p>Dari basis distribusi di Surabaya ke lapangan: dokumentasi pagar BRC yang telah digunakan dan terpasang di proyek.</p>
    </div>
  </section>

  <!-- ===================== THE CATALOG · six material families ===================== -->
  <section class="catalog" id="katalog" aria-labelledby="cat-title">
    <header class="catalog__head" data-reveal>
      <span class="rail">KATALOG · 6 KELOMPOK MATERIAL</span>
      <h2 id="cat-title">Satu sumber untuk material proyek</h2>
      <p class="catalog__sub">BSM menyediakan enam kelompok material konstruksi dari basis Surabaya. Mulai dari pagar BRC, lalu telusuri atap, dinding, pintu, struktur, dan utilitas untuk kebutuhan pengadaan Anda.</p>
      <div class="rail-controls" aria-label="Navigasi kelompok material">
        <button class="rail-control" type="button" data-carousel-dir="prev" data-carousel-target="categories" aria-controls="track-categories" aria-label="Kelompok material sebelumnya">←</button>
        <span class="rail-progress label" data-carousel-progress="categories" aria-live="polite">01 / 06</span>
        <button class="rail-control" type="button" data-carousel-dir="next" data-carousel-target="categories" aria-controls="track-categories" aria-label="Kelompok material berikutnya">→</button>
      </div>
    </header>
    <div id="track-categories" class="material-rail" data-carousel-track="categories" role="region" aria-roledescription="carousel" aria-label="Enam kelompok material BSM" tabindex="0">
      {categories.map((c, i) => (
        <a class="material-tile carousel__slide" data-mount aria-label={`${c.name} · kelompok ${i + 1} dari ${categories.length}`} href={u(`/kategori/${c.slug}`)}>
          <Image src={imageAsset(c.image)} alt={c.name} width={600} height={450} loading="lazy" decoding="async" />
          <span class="material-tile__overlay"></span>
          <span class="material-tile__body"><span class="material-tile__no">RAK {String(i + 1).padStart(2, "0")}</span><b>{c.name}</b><span>{c.count} lini · {c.lines[0]} →</span></span>
        </a>
      ))}
    </div>
  </section>

  <!-- ===================== WALK THE YARD · reach proof ===================== -->
  <section class="yard-break yard-break--proof" aria-label="Bukti jangkauan">
    <div class="reach-strip">
      {proof.map((p) => (
        <figure class="reach-tile" data-reveal>
          <Image src={imageAsset(p.image)} alt={p.caption} width={640} height={480} loading="lazy" decoding="async" />
          <figcaption>{p.caption}</figcaption>
        </figure>
      ))}
    </div>
    <div class="yard-break__cap yard-break__cap--reach" data-reveal>
      <span class="yard-break__no">03 / 03</span>
      <p>Pengiriman dari Surabaya ke 34 provinsi, dengan dokumentasi lapangan sebagai bukti penggunaan pagar BRC di proyek nyata.</p>
    </div>
  </section>

  <!-- ===================== FIELD NOTES ===================== -->
  <section class="section section--proof" aria-labelledby="proof-title">
    <div class="wrap field-note">
      <span class="label">Cara kerja BSM</span>
      <h2 class="headline" id="proof-title">Dari foto produk ke pengiriman proyek.</h2>
      <div class="field-note__steps">
        <div><span>01</span><b>Periksa</b><p>Mulai dari foto dan spesifikasi yang tersedia.</p></div>
        <div><span>02</span><b>Sampaikan</b><p>Kirim kategori, jumlah, dan lokasi proyek.</p></div>
        <div><span>03</span><b>Berangkat</b><p>Tim sales menyiapkan harga dan pengiriman.</p></div>
      </div>
    </div>
  </section>

  <!-- ===================== BLOG TEASER ===================== -->
  <section class="section" id="blog" aria-labelledby="blog-title">
    <div class="wrap">
      <div class="section-head">
        <span class="label">Blog &amp; Panduan Material</span>
        <h2 class="headline" id="blog-title">Keputusan material dimulai dari informasi yang jelas.</h2>
      </div>
      <div class="post-row">
        {posts.map((post) => (
          <a class="post" href={u(`/blog/${post.id}`)} aria-label={post.data.title}>
            <span class="post__kicker">{post.data.kicker ?? "Artikel"} · {fmt(post.data.date)}</span>
            <span class="post__title">{post.data.title}</span>
            <span class="post__excerpt">{post.data.excerpt}</span>
          </a>
        ))}
      </div>
      <p class="section-action"><a class="btn btn--ghost" href={u("/blog")}>Baca semua panduan →</a></p>
    </div>
  </section>

  <!-- ===================== CTA CLOSE ===================== -->
  <section class="section section--field" id="kontak" aria-labelledby="cta-title">
    <div class="wrap cta-close">
      <span class="label">Meja Pesan · Wholesale</span>
      <h2 class="display" id="cta-title">Sampaikan kebutuhan proyek Anda.</h2>
      <p class="lede">Kirim kategori material, spesifikasi, jumlah, dan lokasi proyek melalui WhatsApp. Konsultasi gratis; pengiriman Surabaya gratis.</p>
      <div class="hero__actions" style="justify-content:center">
        <a class="btn btn--onfield" href={wa} target="_blank" rel="noopener">WhatsApp: 0812 4934 3303</a>
        <a class="btn btn--ghostfield" href={u("/penawaran")}>Susun RFQ lebih lengkap</a>
      </div>
      <p class="muted cta-close__addr">Jl. Prapen Indah Gg. 6 Blok C–22, Surabaya · 031 – 99853472 · bsmbangun@yahoo.co.id</p>
    </div>
  </section>
<script>
  const atmosphere = document.querySelector<HTMLElement>("[data-hero-atmosphere]");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  let cancelEnhancementStart = () => {};
  let disposeAtmosphere: (() => void) | null = null;
  let leavingPage = false;

  if (atmosphere && !reduceMotion) {
    const startAtmosphere = async () => {
      if (leavingPage) return;
      try {
        const { initSteelYardAtmosphere } = await import("../scripts/steelYardAtmosphere.ts");
        if (!leavingPage) disposeAtmosphere = initSteelYardAtmosphere(atmosphere);
      } catch {
        // The CSS gradient remains the complete fallback.
      }
    };
    const ric = (window as any).requestIdleCallback as
      | ((callback: () => void, options?: { timeout: number }) => number)
      | undefined;
    const cancelRic = (window as any).cancelIdleCallback as ((id: number) => void) | undefined;
    if (typeof ric === "function") {
      const idleId = ric(startAtmosphere, { timeout: 1500 });
      cancelEnhancementStart = () => cancelRic?.(idleId);
    } else {
      window.addEventListener("load", startAtmosphere, { once: true });
      cancelEnhancementStart = () => window.removeEventListener("load", startAtmosphere);
    }
  }

  // Native scroll snap is the baseline. These controls add only a small layer
  // of orientation and keyboard-friendly navigation to the two prototype rails.
  const root = document.documentElement;
  root.style.setProperty("--mx", "0.5");
  root.style.setProperty("--my", "0.5");
  let pointerRaf = 0;
  let targetX = 0.5;
  let targetY = 0.5;
  let currentX = 0.5;
  let currentY = 0.5;
  const updatePointer = (event: PointerEvent) => {
    targetX = event.clientX / Math.max(window.innerWidth, 1);
    targetY = 1 - event.clientY / Math.max(window.innerHeight, 1);
    if (!pointerRaf) pointerRaf = requestAnimationFrame(tickPointer);
  };
  const tickPointer = () => {
    currentX += (targetX - currentX) * 0.12;
    currentY += (targetY - currentY) * 0.12;
    root.style.setProperty("--mx", currentX.toFixed(3));
    root.style.setProperty("--my", currentY.toFixed(3));
    if (Math.abs(targetX - currentX) > 0.001 || Math.abs(targetY - currentY) > 0.001) {
      pointerRaf = requestAnimationFrame(tickPointer);
    } else {
      pointerRaf = 0;
    }
  };
  if (!reduceMotion) window.addEventListener("pointermove", updatePointer, { passive: true });

  const tracks = Array.from(document.querySelectorAll<HTMLElement>("[data-carousel-track]"));
  let initializedCarousels = 0;
  tracks.forEach((track) => {
    const name = track.dataset.carouselTrack;
    const slides = Array.from(track.querySelectorAll<HTMLElement>(".carousel__slide"));
    if (!name || !slides.length) return;
    const prev = document.querySelector<HTMLButtonElement>(`[data-carousel-dir="prev"][data-carousel-target="${name}"]`);
    const next = document.querySelector<HTMLButtonElement>(`[data-carousel-dir="next"][data-carousel-target="${name}"]`);
    const progress = document.querySelector<HTMLElement>(`[data-carousel-progress="${name}"]`);
    let active = 0;
    const setActive = (index: number) => {
      active = Math.max(0, Math.min(index, slides.length - 1));
      slides.forEach((slide, i) => slide.setAttribute("aria-current", i === active ? "true" : "false"));
      if (progress) progress.textContent = `${String(active + 1).padStart(2, "0")} / ${String(slides.length).padStart(2, "0")}`;
      if (prev) prev.disabled = active === 0;
      if (next) next.disabled = active === slides.length - 1;
    };
    const goTo = (index: number) => {
      const target = Math.max(0, Math.min(index, slides.length - 1));
      track.scrollTo({ left: slides[target].offsetLeft, behavior: reduceMotion ? "auto" : "smooth" });
      setActive(target);
    };
    const syncActive = () => {
      const nearest = slides.reduce(
        (best, slide, index) => {
          const distance = Math.abs(slide.offsetLeft - track.scrollLeft);
          return distance < best.distance ? { index, distance } : best;
        },
        { index: 0, distance: Number.POSITIVE_INFINITY },
      );
      setActive(nearest.index);
    };
    prev?.addEventListener("click", () => goTo(active - 1));
    next?.addEventListener("click", () => goTo(active + 1));
    track.addEventListener("scroll", syncActive, { passive: true });
    track.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        goTo(active - 1);
      }
      if (event.key === "ArrowRight") {
        event.preventDefault();
        goTo(active + 1);
      }
    });
    setActive(0);
    initializedCarousels += 1;
  });
  if (initializedCarousels === tracks.length && tracks.length > 0) {
    root.classList.add("carousel-enhanced");
  }

  // Full-bleed photographs gain the prototype's restrained depth treatment.
  // It is deliberately optional; the static crop remains complete without it.
  if (!reduceMotion) {
    import("gsap")
      .then(async ({ default: gsap }) => {
        const { ScrollTrigger } = await import("gsap/ScrollTrigger");
        gsap.registerPlugin(ScrollTrigger);
        document.querySelectorAll<HTMLElement>("[data-parallax-layer]").forEach((element) => {
          const amount = parseFloat(element.dataset.parallaxLayer ?? "0") * 100;
          gsap.to(element, {
            y: () => amount,
            ease: "none",
            scrollTrigger: {
              trigger: element,
              start: "top bottom",
              end: "bottom top",
              scrub: true,
            },
          });
        });
        const reveals = Array.from(document.querySelectorAll<HTMLElement>("[data-reveal], [data-mount]"));
        reveals.forEach((element) => {
          gsap.fromTo(element, { autoAlpha: 0, y: 22 }, {
            autoAlpha: 1,
            y: 0,
            duration: 0.8,
            ease: "power2.out",
            scrollTrigger: { trigger: element, start: "top 88%", once: true },
          });
        });
        ScrollTrigger.refresh();
      })
      .catch(() => {
        // CSS remains the complete motion-free fallback.
      });
  }

  window.addEventListener("pagehide", () => {
    leavingPage = true;
    if (pointerRaf) cancelAnimationFrame(pointerRaf);
    cancelEnhancementStart();
    disposeAtmosphere?.();
  }, { once: true });
</script>
</Base>
