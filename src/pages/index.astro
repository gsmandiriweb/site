  .hero__plate::before { content: ""; position: absolute; top: 0.35rem; left: 12%; right: 12%; height: 1px; background: linear-gradient(90deg, transparent, rgba(201,180,138,0.34), transparent); pointer-events: none; }
  .hero__plate-link:hover .hero__plate, .hero__plate-link:focus-visible .hero__plate { --plate-tilt-x: 1.1deg; --plate-tilt-y: -0.8deg; transform: perspective(1200px) rotateX(var(--plate-tilt-y)) rotateY(var(--plate-tilt-x)) rotateZ(1.8deg) translate3d(calc(var(--plate-shift-x) * 1px), calc(var(--plate-shift-y) * 1px - 4px), 0); border-top-color: var(--beam); box-shadow: inset 0 1px 1px rgba(255,255,255,0.07), 0 32px 76px -30px rgba(0,0,0,0.96); }
  .hero__plate-image { position: relative; overflow: hidden; background: var(--theme-panel); width: 100%; height: clamp(280px, 38svh, 390px); border-radius: 2px; box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--theme-text) 8%, transparent), inset 0 -28px 36px -34px rgba(0,0,0,0.42); }
  .hero__plate-image::after { content: ""; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(116deg, transparent 25%, rgba(201,180,138,0.2) 46%, transparent 58%); transform: translateX(-135%); opacity: 0; }
  .hero__plate-link:hover .hero__plate-image::after, .hero__plate-link:focus-visible .hero__plate-image::after { opacity: 1; animation: hero-inspection-sweep 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
  .hero__plate-scan { position: absolute; z-index: 1; inset: 0; pointer-events: none; overflow: hidden; opacity: 0.5; mix-blend-mode: screen; }
  .hero__plate-scan::before { content: ""; position: absolute; left: 0; right: 0; top: 18%; height: 1px; background: linear-gradient(90deg, transparent, var(--beam), transparent); box-shadow: 0 0 18px 1px color-mix(in srgb, var(--beam) 60%, transparent); animation: hero-scan-line 5.5s ease-in-out infinite; }
  .hero__plate-corner { position: absolute; z-index: 2; width: 1.4rem; height: 1.4rem; border-color: var(--beam); opacity: 0.8; }
  .hero__plate-corner--tl { top: 0.8rem; left: 0.8rem; border-top: 1px solid; border-left: 1px solid; }
  .hero__plate-corner--br { right: 0.8rem; bottom: 0.8rem; border-right: 1px solid; border-bottom: 1px solid; }
  .hero__plate-status { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.35rem 0.5rem; padding: 0.55rem 0.35rem 0.1rem; border-top: 1px solid color-mix(in srgb, var(--theme-text) 12%, transparent); color: var(--theme-muted); font: 0.56rem/1.2 var(--fm); letter-spacing: 0.08em; }
  .hero__plate-status span { white-space: nowrap; }
  .hero__plate-status i { display: inline-block; width: 0.38rem; height: 0.38rem; margin-right: 0.25rem; border-radius: 50%; background: var(--yard-accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--yard-accent) 18%, transparent); }
  @keyframes hero-scan-line { 0%, 14% { top: 18%; opacity: 0; } 24% { top: 22%; opacity: 1; } 75% { top: 78%; opacity: 1; } 86%, 100% { top: 82%; opacity: 0; } }
  @keyframes hero-inspection-sweep { from { transform: translateX(-135%); } to { transform: translateX(135%); } }
  .hero__plate-img { width: 100%; height: 100%; object-fit: cover; object-position: center center; filter: saturate(0.82) contrast(1.06); }
  :global(html[data-theme="light"]) .hero__plate-img { filter: saturate(0.74) contrast(1.02) brightness(1.04); }
  :global(html[data-theme="light"]) .hero__plate-mark { background: rgba(23,33,43,0.86); color: #e8d7b2; }
  .hero__plate-mark { position: absolute; top: 1rem; right: 1rem; padding: 0.35rem 0.55rem; background: rgba(12,13,16,0.78); color: var(--beam); font-family: var(--fm); font-size: 0.62rem; letter-spacing: 0.12em; }
  .hero__plate-caption { display: grid; gap: 0.28rem; padding: 0.75rem 0.35rem 0.55rem; }
