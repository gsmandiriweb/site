---
import {
  configuredGitHubPat,
  configuredOwnerSecret,
  createAdminSession,
  secretsMatch,
  sessionCookie,
} from "../../../../utils/admin-session.ts";

export const prerender = false;

const safeNext = "/admin";
const secure = Astro.url.protocol === "https:";
const requestMethod = Astro.request.method;

if (requestMethod !== "POST") {
  return new Response("Method Not Allowed", {
    status: 405,
    headers: { Allow: "POST", "Cache-Control": "no-store" },
  });
}

const ownerSecret = await configuredOwnerSecret();
const pat = await configuredGitHubPat();
if (!ownerSecret || !pat) {
  return new Response("CMS authentication is not configured.", {
    status: 503,
    headers: { "Cache-Control": "no-store", "Content-Type": "text/plain" },
  });
}

const form = await Astro.request.formData().catch(() => null);
const submittedSecret = form?.get("secret");
if (typeof submittedSecret !== "string" || !(await secretsMatch(submittedSecret, ownerSecret))) {
  return new Response("Invalid credentials.", {
    status: 401,
    headers: { "Cache-Control": "no-store", "Content-Type": "text/plain" },
  });
}

const sessionId = await createAdminSession(pat);
if (!sessionId) {
  return new Response("CMS session storage is unavailable.", {
    status: 503,
    headers: { "Cache-Control": "no-store", "Content-Type": "text/plain" },
  });
}

return new Response(null, {
  status: 303,
  headers: {
    Location: safeNext,
    "Cache-Control": "no-store",
    "Set-Cookie": sessionCookie(sessionId, secure),
  },
});
---
