    <div class="hero__scroll" data-reveal><span>gulir · dinding ini hidup</span> ↓</div>
  </section>

  <!-- ===================== LIBRARY INDEX · engraved rack plates ===================== -->
  <section class="wall wall--index" id="katalog" aria-labelledby="index-title">
    <header class="wall__head" data-reveal>
      <span class="rail">RAK INDEKS · 6 KELOMPOK MATERIAL</span>
