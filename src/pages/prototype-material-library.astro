    </header>

    <div class="collection collection--curated" data-parallax-layer="0.03">
      {brcShowcase.items.map((s, i) => (
        <article class={`mount mount--coll mount--coll-${i + 1}`} tabindex="0" data-mount>
          <span class="mount__bracket mount__bracket--tl"></span>
          <span class="mount__bracket mount__bracket--tr"></span>
          <span class="mount__bracket mount__bracket--bl"></span>
          <span class="mount__bracket mount__bracket--br"></span>
          <div class="mount__plate">
            <Image src={imageAsset(s.angles[0])} alt={s.name} width={560} height={560} loading="lazy" class="mount__img" />
          </div>
          <figcaption class="tag">
            <span class="tag__pin"></span>
            <span class="tag__no">BRC · {String(i + 1).padStart(2, "0")}</span>
            <span class="tag__name">{s.name}</span>
            <span class="tag__specs">
              {s.specs.map((sp) => (
