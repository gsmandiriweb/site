      <p class="wall__sub">Setiap spesimen di atas adalah bukti dari gudang dan lapangan nyata. Foto terpasang ini dipasang di dinding sebagai referensi, bukan klaim, tapi jejak.</p>
    </header>
    <div class="proof-wall" data-parallax-layer="0.02">
      {proof.map((p, i) => (
        <figure class={`proof-mount proof-mount--${i + 1}`} data-mount>
          <span class="mount__bracket mount__bracket--tl"></span>
          <span class="mount__bracket mount__bracket--tr"></span>
          <span class="mount__bracket mount__bracket--bl"></span>
          <span class="mount__bracket mount__bracket--br"></span>
          <div class="mount__plate">
            <Image src={imageAsset(p.image)} alt={p.caption} width={720} height={540} loading="lazy" class="mount__img" />
          </div>
          <figcaption class="proof-caption">{p.caption}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- ===================== ORDER COUNTER · the wall's quote desk ===================== -->
  <section class="wall wall--counter" id="kontak" aria-labelledby="counter-title">
    <div class="counter" data-reveal>
      <span class="rail">MEJA PESAN · WHOLESALE</span>
      <h2 id="counter-title">Siap pesan? Bandingkan spesimen, lalu minta harga pabrik.</h2>
      <p class="counter__sub">Hubungi tim sales BSM via WhatsApp. Harga pabrik, stok gudang, dan pengiriman ke 34 provinsi dalam satu obrolan.</p>
      <a class="cta cta--primary cta--lg" href={wa} target="_blank" rel="noopener">WhatsApp: 0812 4934 3303</a>
      <p class="counter__addr">Jl. Prapen Indah Gg. 6 Blok C–22, Surabaya · 031 – 99853472 · bsmbangun@yahoo.co.id</p>
    </div>
  </section>

  <footer class="proto-footer">
    <span>PROTOTYPE POV 4 · The Material Library · THROWAWAY · wayfinder #12</span>
  </footer>

<script>
  // ---- The living wall: lazy-init the OGL shader after first paint. ----
  const wallContainer = document.querySelector<HTMLElement>("[data-material-wall]");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  let disposeWall: (() => void) | null | undefined = undefined;
  async function maybeStartWall() {
    if (disposeWall !== undefined) return;
    if (!wallContainer || reduceMotion) { disposeWall = null; return; }
    try {
      const { initMaterialWall } = await import("../scripts/materialLibraryShader.ts");
      disposeWall = initMaterialWall(wallContainer);
    } catch { disposeWall = null; }
  }
  window.addEventListener("load", maybeStartWall, { once: true });
  if (document.readyState === "complete") maybeStartWall();

  // ---- Cursor-light bridge: drive CSS vars so the foreground shares the
  //      shader's light. Mounted objects highlight on the cursor side and
  //      shadow on the far side, as if lit by the same raking light. ----
  const root = document.documentElement;
  let rafLight = 0, tx = 0.5, ty = 0.5, cx = 0.5, cy = 0.5;
  function onPointer(e: PointerEvent) {
    tx = e.clientX / window.innerWidth;
    ty = 1 - e.clientY / window.innerHeight;
    if (!rafLight) rafLight = requestAnimationFrame(tick);
  }
  function tick() {
    cx += (tx - cx) * 0.1; cy += (ty - cy) * 0.1;
    root.style.setProperty("--mx", cx.toFixed(3));
    root.style.setProperty("--my", cy.toFixed(3));
    root.style.setProperty("--ml", (cx * 0.6 + 0.2).toFixed(3)); // light strength 0..1
    if (Math.abs(tx - cx) > 0.001 || Math.abs(ty - cy) > 0.001) rafLight = requestAnimationFrame(tick);
    else rafLight = 0;
  }
  if (!reduceMotion) window.addEventListener("pointermove", onPointer, { passive: true });

  // ---- GSAP motion orchestration ----
  (async () => {
    if (reduceMotion) return;
    const gsap = (await import("gsap")).default;
    const { ScrollTrigger } = await import("gsap/ScrollTrigger");
    gsap.registerPlugin(ScrollTrigger);
    if (document.fonts?.ready) await document.fonts.ready;

    // Hero entrance.
    const heroReveals = gsap.utils.toArray<HTMLElement>(".hero-wall [data-reveal]");
    gsap.set(heroReveals, { autoAlpha: 0, y: 30 });
    gsap.to(heroReveals, { autoAlpha: 1, y: 0, duration: 1.0, ease: "power3.out", stagger: 0.12, delay: 0.2 });

    // Scroll-driven mounting: specimens mount onto the wall as they enter.
    const mounts = gsap.utils.toArray<HTMLElement>("[data-mount]:not(.hero-wall [data-mount])");
    mounts.forEach((el) => {
      gsap.set(el, { autoAlpha: 0, y: 50, scale: 0.92, rotateX: 8 });
      ScrollTrigger.create({
        trigger: el, start: "top 90%", once: true,
        onEnter: () => {
          gsap.to(el, { autoAlpha: 1, y: 0, scale: 1, rotateX: 0, duration: 0.9, ease: "power2.out" });
          const brackets = el.querySelectorAll<HTMLElement>(".mount__bracket");
          if (brackets.length) gsap.fromTo(brackets, { scale: 0 }, { scale: 1, duration: 0.35, ease: "back.out(2)", stagger: 0.04, delay: 0.35 });
        },
      });
    });

    // Section heads reveal.
    const heads = gsap.utils.toArray<HTMLElement>(".wall__head[data-reveal], .reading-note[data-reveal], .collection__order[data-reveal], .counter[data-reveal]");
    heads.forEach((el) => {
      gsap.set(el, { autoAlpha: 0, y: 26 });
      ScrollTrigger.create({ trigger: el, start: "top 86%", once: true, onEnter: () => gsap.to(el, { autoAlpha: 1, y: 0, duration: 0.9, ease: "power2.out" }) });
    });

    // Parallax: foreground layers drift against the wall on scroll (depth).
    gsap.utils.toArray<HTMLElement>("[data-parallax-layer]").forEach((el) => {
      const amt = parseFloat(el.dataset.parallaxLayer || "0") * 100;
      gsap.to(el, { y: () => amt, ease: "none", scrollTrigger: { trigger: el, start: "top bottom", end: "bottom top", scrub: true } });
    });

    ScrollTrigger.refresh();
  })();
</script>

<style>
  :root {
    --board: #1a1d22;
    --board-deep: #121418;
    --board-hole: #0e1014;
    --board-rail: #2b3036;
    --tag-paper: #f3efe4;
    --tag-paper-deep: #e6e0d1;
    --tag-ink: #1a1d20;
    --tag-ink-soft: #5a5f66;
    --ink: #ece9e2;
    --ink-soft: #9aa0a8;
    --rail-ink: #c9b48a;
    --steel-edge: #d7dde3;
    --steel-dark: #3a3f46;
    --signal: #e8551e;
    --signal-deep: #c8430f;
    --signal-darker: #a8360b;
    --fd: "Archivo", "Arial Narrow", sans-serif;
    --fb: "Hanken Grotesk", system-ui, sans-serif;
    --fm: "JetBrains Mono", ui-monospace, monospace;
    /* Cursor-light bridge (driven by JS) */
    --mx: 0.5; --my: 0.5; --ml: 0.5;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body {
    background: var(--board-deep);
    color: var(--ink);
    font-family: var(--fb);
    font-size: 1.0625rem;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    overflow-x: hidden;
  }
  img { display: block; max-width: 100%; }
  a { color: inherit; text-decoration: none; }
  :focus-visible { outline: 2px solid var(--rail-ink); outline-offset: 3px; }

  /* ---- The living wall: fixed full-bleed shader canvas ---- */
  .wall-canvas { position: fixed; inset: 0; z-index: 0; pointer-events: none; }
  .wall-canvas canvas { display: block; width: 100%; height: 100%; }
  .wall-fallback {
    position: fixed; inset: 0; z-index: 0; pointer-events: none;
    background-color: var(--board);
    background-image: radial-gradient(var(--board-hole) 1.5px, transparent 1.6px);
    background-size: 22px 22px;
    opacity: 0.6;
  }
  .wall-canvas:not(:empty) ~ .wall-fallback { opacity: 0; }
  /* Cursor-light glow on the wall (a soft warm pool that follows the cursor) */
  .cursor-light {
    position: fixed; inset: 0; z-index: 0; pointer-events: none;
    background: radial-gradient(600px circle at calc(var(--mx) * 100vw) calc((1 - var(--my)) * 100vh),
      rgba(201, 180, 138, 0.10), transparent 60%);
    transition: background 0.1s linear;
  }

  .wall { position: relative; z-index: 1; padding: clamp(3.5rem, 8vw, 6rem) clamp(1rem, 5vw, 4rem); }
  .wall--proof, .wall--counter { background: rgba(18, 20, 24, 0.82); backdrop-filter: blur(3px); }

  .rail { font-family: var(--fm); font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--rail-ink); }
  .wall__head { max-width: 60ch; margin-bottom: clamp(2.5rem, 5vw, 3.5rem); }
  .wall__head h2 {
    font-family: var(--fd); font-weight: 700; font-stretch: 112%;
    font-size: clamp(1.7rem, 4vw, 2.8rem); line-height: 1.04; letter-spacing: -0.01em;
    margin: 0.7rem 0 1rem; text-wrap: balance;
  }
  .wall__sub { color: var(--ink-soft); max-width: 56ch; }

  /* ---- NAV · a stenciled rail bolted to the wall ---- */
  .nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    display: flex; align-items: center; justify-content: space-between;
    padding: 0.85rem clamp(1rem, 4vw, 3rem);
    background: rgba(18, 20, 24, 0.72); backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--board-rail);
  }
  .nav__brand { font-family: var(--fd); font-weight: 800; font-stretch: 125%; font-size: 1.4rem; letter-spacing: -0.02em; }
  .nav__links { display: flex; gap: 1.6rem; }
  .nav__links a { font-family: var(--fm); font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-soft); position: relative; transition: color 0.2s; }
  .nav__links a::after { content: ""; position: absolute; left: 0; bottom: -4px; width: 100%; height: 1px; background: var(--rail-ink); transform: scaleX(0); transform-origin: left; transition: transform 0.25s ease; }
  .nav__links a:hover { color: var(--ink); }
  .nav__links a:hover::after { transform: scaleX(1); }
  .nav__wa { font-family: var(--fm); font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; background: var(--signal-deep); color: #fff; padding: 0.55rem 1.1rem; border-radius: 3px; font-weight: 600; transition: background 0.2s, transform 0.2s; }
  .nav__wa:hover { background: var(--signal-darker); transform: translateY(-1px); }
  @media (max-width: 640px) { .nav__links { display: none; } }

  /* ---- CTAs · stamped metal plates ---- */
  .cta {
    display: inline-flex; align-items: center;
    font-family: var(--fm); font-size: 0.8rem; letter-spacing: 0.12em;
    text-transform: uppercase; font-weight: 600;
    padding: 14px 30px; border-radius: 3px;
    transition: background 0.2s, border-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }
  .cta--primary { background: var(--signal-deep); color: #fff; box-shadow: 0 6px 16px -8px rgba(0, 0, 0, 0.6); }
  .cta--primary:hover { background: var(--signal-darker); transform: translateY(-2px); box-shadow: 0 10px 22px -8px rgba(0, 0, 0, 0.65); }
  .cta--ghost { background: transparent; color: var(--ink); border: 1px solid var(--ink-soft); }
  .cta--ghost:hover { border-color: var(--ink); background: rgba(255, 255, 255, 0.04); }
  .cta--lg { font-size: 0.9rem; padding: 18px 38px; }

  /* ===================== HERO WALL ===================== */
  .hero-wall {
    min-height: 100vh;
    padding-top: clamp(6.5rem, 14vh, 9.5rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  @media (max-width: 980px) { .hero-wall { grid-template-columns: 1fr; min-height: auto; padding-top: clamp(6rem, 12vh, 8rem); } }
  .wall__placard { max-width: 32rem; }
  .placard__index { display: block; margin-bottom: 1.4rem; }
  .placard__title {
    font-family: var(--fd); font-weight: 800; font-stretch: 125%;
    font-size: clamp(2.6rem, 6.5vw, 4.8rem);
    line-height: 0.94; letter-spacing: -0.025em;
    margin-bottom: 1.5rem; text-wrap: balance;
  }
  .placard__lede { color: var(--ink-soft); font-size: 1.1rem; max-width: 48ch; margin-bottom: 2.2rem; line-height: 1.65; }
  .placard__actions { display: flex; gap: 1rem; flex-wrap: wrap; }
  .hero__scroll { position: absolute; bottom: 1.5rem; left: clamp(1rem, 5vw, 4rem); font-family: var(--fm); font-size: 0.68rem; letter-spacing: 0.1em; color: var(--ink-soft); display: flex; flex-direction: column; gap: 0.3rem; }

  .hero-mounts { display: grid; grid-template-columns: 1.4fr 1fr; grid-template-rows: auto auto; gap: clamp(1.4rem, 3.2vw, 2.6rem); align-items: start; perspective: 1400px; }
  .hero-mounts .mount--1 { grid-row: 1 / span 2; }
  @media (max-width: 640px) { .hero-mounts { grid-template-columns: 1fr; } .hero-mounts .mount--1 { grid-row: auto; } }

  /* ===================== MOUNT · a steel plate mounted on the wall ===================== */
  /* The mount is a physical object: a brushed-steel frame holding the specimen
     photo, bolted at four corners, casting a real offset shadow that shifts
     with the cursor-light (lit on the cursor side, shadow on the far side). */
  .mount {
    position: relative;
    background: linear-gradient(145deg, #2a2e33, #1a1d21);
    border: 1px solid var(--steel-dark);
    border-radius: 6px;
    padding: 12px;
    /* Cursor-aware shadow: longer on the side away from the light. */
    box-shadow:
      calc((0.5 - var(--mx)) * 18px) calc((0.5 - var(--my)) * 14px) 28px -8px rgba(0, 0, 0, 0.7),
      0 2px 4px rgba(0, 0, 0, 0.4);
    transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.3, 1), box-shadow 0.4s;
    transform-style: preserve-3d;
  }
  /* Brushed-steel frame edge: a thin inner highlight that catches the light. */
  .mount::before {
    content: ""; position: absolute; inset: 0; border-radius: 6px; pointer-events: none;
    box-shadow: inset 0 1px 0 rgba(215, 221, 227, calc(0.12 + var(--ml) * 0.18)),
                inset 0 -1px 0 rgba(0, 0, 0, 0.5);
  }
  /* Corner brackets: mounting hardware, not decoration. */
  .mount__bracket {
    position: absolute; z-index: 3; width: 14px; height: 14px;
    border: 2px solid var(--rail-ink); border-radius: 1px;
    background: rgba(201, 180, 138, 0.08);
    transform-origin: center;
  }
  .mount__bracket--tl { top: -3px; left: -3px; border-right: none; border-bottom: none; }
  .mount__bracket--tr { top: -3px; right: -3px; border-left: none; border-bottom: none; }
  .mount__bracket--bl { bottom: -3px; left: -3px; border-right: none; border-top: none; }
  .mount__bracket--br { bottom: -3px; right: -3px; border-left: none; border-top: none; }

  .mount__plate {
    position: relative; border-radius: 3px; overflow: hidden; background: #0e0f12;
    box-shadow: inset 0 0 0 1px rgba(215, 221, 227, 0.1);
  }
  .mount__img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .mount--hero .mount__plate { aspect-ratio: 1 / 1; }
  .mount--coll .mount__plate { aspect-ratio: 1 / 1; }

  /* Specimen inspection: hover/focus lifts the plate forward (turn a sample
     toward you) and the shadow deepens — the cursor-light reads on it. */
  .mount--coll:hover, .mount--coll:focus-within {
    transform: translateY(-8px) scale(1.02);
    box-shadow:
      calc((0.5 - var(--mx)) * 26px) calc((0.5 - var(--my)) * 20px) 44px -10px rgba(0, 0, 0, 0.78),
      0 4px 8px rgba(0, 0, 0, 0.5);
    z-index: 4;
  }

  /* ===================== TAG · a paper label hung from a pin ===================== */
  .tag {
    position: relative;
    margin: 14px 6px 4px;
    padding: 0.75rem 0.95rem 0.9rem;
    background: linear-gradient(160deg, var(--tag-paper), var(--tag-paper-deep));
    color: var(--tag-ink);
    border-radius: 2px;
    box-shadow: 0 6px 14px -6px rgba(0, 0, 0, 0.6);
    font-family: var(--fm);
    /* a slight hang, as if pinned at top-center */
    transform: rotate(-0.6deg);
    transition: transform 0.3s ease;
  }
  .mount--coll:hover .tag, .mount--coll:focus-within .tag { transform: rotate(0deg); }
  /* The pin fastening the tag to the plate */
  .tag__pin {
    position: absolute; top: -5px; left: 50%; transform: translateX(-50%);
    width: 10px; height: 10px; border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, var(--rail-ink), #6b5a3a 70%);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
  }
  .tag__no { display: block; font-size: 0.6rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--tag-ink-soft); margin-bottom: 0.25rem; }
  .tag__name { display: block; font-family: var(--fd); font-weight: 700; font-stretch: 112%; font-size: 1.05rem; letter-spacing: -0.01em; color: var(--tag-ink); margin-bottom: 0.55rem; }
  .tag__specs { display: block; }
  .tag__spec { display: block; font-size: 0.72rem; line-height: 1.45; color: var(--tag-ink-soft); border-top: 1px dashed rgba(26, 29, 32, 0.22); padding: 0.28rem 0; }
  .tag__spec b { display: inline-block; min-width: 7.5rem; color: var(--tag-ink); font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.6rem; }
  .tag__wa { display: inline-block; margin-top: 0.6rem; font-size: 0.66rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--signal-darker); font-weight: 600; border-bottom: 1px solid rgba(168, 54, 11, 0.4); padding-bottom: 1px; }
  .tag__wa:hover { color: #8a2d09; border-bottom-color: #8a2d09; }

  /* ===================== LIBRARY INDEX · engraved rack plates ===================== */
  .wall--index { padding-bottom: clamp(3rem, 7vw, 5.5rem); }
  .rack { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(0.9rem, 1.8vw, 1.3rem); }
  @media (max-width: 860px) { .rack { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 540px) { .rack { grid-template-columns: 1fr; } }
  .rack-plate {
    position: relative; display: flex; flex-direction: column; gap: 0.4rem;
    padding: 1.2rem 1.3rem;
    background: linear-gradient(155deg, rgba(40, 44, 50, 0.9), rgba(26, 29, 33, 0.9));
    backdrop-filter: blur(4px);
    border: 1px solid var(--steel-dark);
    border-radius: 4px;
    /* engraved-plate top edge catches the cursor-light */
    box-shadow: inset 0 1px 0 rgba(215, 221, 227, calc(0.1 + var(--ml) * 0.15)),
                0 10px 22px -12px rgba(0, 0, 0, 0.6);
    transition: transform 0.25s, box-shadow 0.25s;
  }
  .rack-plate:hover { transform: translateX(4px); box-shadow: inset 0 1px 0 rgba(215, 221, 227, calc(0.2 + var(--ml) * 0.2)), 0 14px 28px -12px rgba(0, 0, 0, 0.65); }
  .rack-plate__cat { font-family: var(--fm); font-size: 0.6rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--rail-ink); }
  .rack-plate__name { font-family: var(--fd); font-weight: 700; font-stretch: 108%; font-size: 1.15rem; letter-spacing: -0.01em; color: var(--ink); }
  .rack-plate__count { font-family: var(--fm); font-size: 0.66rem; color: var(--ink-soft); }

  /* ===================== COLLECTION · curated, varied ===================== */
  .wall--collection { padding-top: 0; }
  .collection { display: grid; grid-template-columns: repeat(6, 1fr); gap: clamp(1.6rem, 3.2vw, 2.6rem); perspective: 1400px; }
  .mount--coll-1 { grid-column: span 3; }
  .mount--coll-2 { grid-column: span 3; }
  .mount--coll-3 { grid-column: span 2; }
  .mount--coll-4 { grid-column: span 2; }
  .mount--coll-5 { grid-column: span 2; }
  .mount--coll-6 { grid-column: span 6; }
  .mount--coll-6 .mount__plate { aspect-ratio: 16 / 9; }
  @media (max-width: 980px) {
    .collection { grid-template-columns: repeat(2, 1fr); }
    .mount--coll-1, .mount--coll-2, .mount--coll-3, .mount--coll-4, .mount--coll-5, .mount--coll-6 { grid-column: span 1; }
    .mount--coll-6 .mount__plate { aspect-ratio: 1 / 1; }
  }
  @media (max-width: 560px) { .collection { grid-template-columns: 1fr; } }
  .collection__order { margin-top: clamp(3rem, 6vw, 4rem); text-align: center; }

  .reading-note { margin-top: clamp(3rem, 6vw, 4.5rem); padding: clamp(1.6rem, 4vw, 2.4rem) clamp(1.4rem, 3vw, 2rem); border-left: 1px solid var(--rail-ink); max-width: 52ch; }
  .reading-note .rail { display: block; margin-bottom: 0.7rem; }
  .reading-note p { color: var(--ink-soft); font-size: 1rem; line-height: 1.7; }

  /* ===================== PROOF WALL ===================== */
  .proof-wall { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(1rem, 2vw, 1.6rem); }
  @media (max-width: 980px) { .proof-wall { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .proof-wall { grid-template-columns: 1fr; } }
  .proof-mount { background: linear-gradient(180deg, #2a2e33, #1a1d21); border: 1px solid var(--steel-dark); border-radius: 6px; padding: 10px; box-shadow: 0 14px 26px -12px rgba(0, 0, 0, 0.65); }
  .proof-mount .mount__plate { aspect-ratio: 4 / 3; }
  .proof-caption { font-family: var(--fm); font-size: 0.66rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-soft); text-align: center; padding: 0.7rem 0 0.2rem; }

  /* ===================== ORDER COUNTER ===================== */
  .wall--counter { padding-bottom: clamp(3rem, 8vw, 6rem); }
  .counter { max-width: 46rem; margin: 0 auto; text-align: center; }
  .counter .rail { display: block; margin-bottom: 1rem; }
  .counter h2 { font-family: var(--fd); font-weight: 800; font-stretch: 125%; font-size: clamp(2rem, 5vw, 3.2rem); line-height: 1; letter-spacing: -0.02em; margin-bottom: 1.2rem; text-wrap: balance; }
  .counter__sub { color: var(--ink-soft); max-width: 48ch; margin: 0 auto 2rem; }
  .counter__addr { font-family: var(--fm); font-size: 0.7rem; letter-spacing: 0.06em; color: var(--ink-soft); margin-top: 2rem; line-height: 1.7; }

  .proto-footer { position: relative; z-index: 1; padding: 1.4rem; text-align: center; background: var(--board-deep); border-top: 1px solid var(--board-rail); }
  .proto-footer span { font-family: var(--fm); font-size: 0.66rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-soft); }

  @media (prefers-reduced-motion: reduce) {
    .cta, .mount, .rack-plate, .tag, .nav__wa, .nav__links a { transition: none; }
    .mount--coll:hover, .mount--coll:focus-within, .cta:hover, .rack-plate:hover, .nav__wa:hover { transform: none; }
    .tag { transform: none; }
  }
</style>
</body>
</html>
